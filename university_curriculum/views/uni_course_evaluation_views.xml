<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ uni.course.evaluation — List View ============ -->
    <record id="view_uni_course_evaluation_list" model="ir.ui.view">
        <field name="name">uni.course.evaluation.list</field>
        <field name="model">uni.course.evaluation</field>
        <field name="arch" type="xml">
            <list string="Course Evaluations"
                  decoration-success="state=='active'"
                  decoration-muted="state=='closed'"
                  decoration-warning="state=='draft'">
                <field name="name"/>
                <field name="course_id"/>
                <field name="academic_term_id"/>
                <field name="evaluation_type_id" optional="hide"/>
                <field name="section_count"/>
                <field name="item_count"/>
                <field name="total_weight"/>
                <field name="weight_complete" widget="boolean_toggle"/>
                <field name="state" widget="badge"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ============ uni.course.evaluation — Form View ============ -->
    <record id="view_uni_course_evaluation_form" model="ir.ui.view">
        <field name="name">uni.course.evaluation.form</field>
        <field name="model">uni.course.evaluation</field>
        <field name="arch" type="xml">
            <form string="Course Evaluation">
                <header>
                    <button name="action_activate" type="object" string="Activate"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close" type="object" string="Close"
                            class="btn-danger" invisible="state != 'active'"/>
                    <button name="action_draft" type="object" string="Set to Draft"
                            class="btn-secondary" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_sections" icon="fa-list-ul">
                            <field name="section_count" widget="statinfo" string="Sections"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_view_items" icon="fa-tasks">
                            <field name="item_count" widget="statinfo" string="Items"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Reference"/>
                        <h1><field name="name" placeholder="e.g. EVAL/2024/0001"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="course_id" options="{'no_create': True}"
                                   domain="[('state', 'in', ('active', 'suspended'))]"/>
                            <field name="university_id" readonly="1"/>
                            <field name="college_id" readonly="1"/>
                            <field name="academic_term_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="evaluation_type_id" options="{'no_create': True}"/>
                            <field name="total_weight"/>
                            <field name="weight_complete" widget="boolean_toggle"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sections &amp; Items" name="sections">
                            <field name="section_ids">
                                <form string="Section">
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="name"/>
                                                <field name="sequence"/>
                                                <field name="weight"/>
                                            </group>
                                            <group>
                                                <field name="item_count"/>
                                            </group>
                                        </group>
                                        <field name="item_ids">
                                            <list editable="bottom">
                                                <field name="sequence" widget="handle"/>
                                                <field name="name"/>
                                                <field name="evaluation_type_id"
                                                       options="{'no_create': True}"/>
                                                <field name="weight"/>
                                                <field name="max_score"/>
                                                <field name="description"/>
                                            </list>
                                        </field>
                                    </sheet>
                                </form>
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="item_count"/>
                                    <field name="weight"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============ uni.course.evaluation — Search View ============ -->
    <record id="view_uni_course_evaluation_search" model="ir.ui.view">
        <field name="name">uni.course.evaluation.search</field>
        <field name="model">uni.course.evaluation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="course_id"/>
                <field name="academic_term_id"/>
                <field name="college_id"/>
                <filter string="Active" name="filter_active"
                        domain="[('active', '=', True)]"/>
                <filter string="Weight Complete" name="filter_complete"
                        domain="[('weight_complete', '=', True)]"/>
                <separator/>
                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Active" name="state_active"
                        domain="[('state', '=', 'active')]"/>
                <group expand="0" string="Group By">
                    <filter string="Course" name="group_course"
                            context="{'group_by': 'course_id'}"/>
                    <filter string="Term" name="group_term"
                            context="{'group_by': 'academic_term_id'}"/>
                    <filter string="College" name="group_college"
                            context="{'group_by': 'college_id'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============ uni.course.evaluation — Action ============ -->
    <record id="action_uni_course_evaluation" model="ir.actions.act_window">
        <field name="name">Course Evaluations</field>
        <field name="res_model">uni.course.evaluation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_course_evaluation_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new course evaluation
            </p>
            <p>
                Course evaluations define the assessment structure (sections and
                items) used to grade students. Total weight must equal 100 before
                activation.
            </p>
        </field>
    </record>

    <!-- ============ uni.course.evaluation.section — List/Form (standalone) ============ -->
    <record id="view_uni_course_evaluation_section_list" model="ir.ui.view">
        <field name="name">uni.course.evaluation.section.list</field>
        <field name="model">uni.course.evaluation.section</field>
        <field name="arch" type="xml">
            <list string="Evaluation Sections">
                <field name="sequence" widget="handle"/>
                <field name="evaluation_id"/>
                <field name="name"/>
                <field name="item_count"/>
                <field name="weight"/>
            </list>
        </field>
    </record>

    <record id="view_uni_course_evaluation_section_form" model="ir.ui.view">
        <field name="name">uni.course.evaluation.section.form</field>
        <field name="model">uni.course.evaluation.section</field>
        <field name="arch" type="xml">
            <form string="Evaluation Section">
                <sheet>
                    <group>
                        <group>
                            <field name="evaluation_id" options="{'no_create': True}"/>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="weight"/>
                            <field name="item_count"/>
                        </group>
                    </group>
                    <field name="item_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="evaluation_type_id" options="{'no_create': True}"/>
                            <field name="weight"/>
                            <field name="max_score"/>
                            <field name="description"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_uni_course_evaluation_section" model="ir.actions.act_window">
        <field name="name">Evaluation Sections</field>
        <field name="res_model">uni.course.evaluation.section</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============ uni.course.evaluation.item — List/Form (standalone) ============ -->
    <record id="view_uni_course_evaluation_item_list" model="ir.ui.view">
        <field name="name">uni.course.evaluation.item.list</field>
        <field name="model">uni.course.evaluation.item</field>
        <field name="arch" type="xml">
            <list string="Evaluation Items">
                <field name="sequence" widget="handle"/>
                <field name="evaluation_id"/>
                <field name="section_id"/>
                <field name="name"/>
                <field name="evaluation_type_id"/>
                <field name="weight"/>
                <field name="max_score"/>
            </list>
        </field>
    </record>

    <record id="view_uni_course_evaluation_item_form" model="ir.ui.view">
        <field name="name">uni.course.evaluation.item.form</field>
        <field name="model">uni.course.evaluation.item</field>
        <field name="arch" type="xml">
            <form string="Evaluation Item">
                <sheet>
                    <group>
                        <group>
                            <field name="section_id" options="{'no_create': True}"/>
                            <field name="evaluation_id" readonly="1"/>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="evaluation_type_id" options="{'no_create': True}"/>
                            <field name="weight"/>
                            <field name="max_score"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_uni_course_evaluation_item" model="ir.actions.act_window">
        <field name="name">Evaluation Items</field>
        <field name="res_model">uni.course.evaluation.item</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
