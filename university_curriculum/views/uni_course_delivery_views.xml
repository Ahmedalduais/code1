<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ uni.course.delivery — List View ============ -->
    <record id="view_uni_course_delivery_list" model="ir.ui.view">
        <field name="name">uni.course.delivery.list</field>
        <field name="model">uni.course.delivery</field>
        <field name="arch" type="xml">
            <list string="Course Delivery Modes"
                  decoration-success="delivery_method == 'on_campus'"
                  decoration-info="delivery_method in ('online_sync', 'hybrid', 'blended')"
                  decoration-warning="delivery_method in ('online_async', 'distance')">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="delivery_method" widget="badge"/>
                <field name="has_physical_classroom" optional="hide" widget="boolean_toggle"/>
                <field name="has_virtual_classroom" optional="hide" widget="boolean_toggle"/>
                <field name="has_livestream" optional="hide" widget="boolean_toggle"/>
                <field name="has_recording" optional="hide" widget="boolean_toggle"/>
                <field name="default_max_enrollment" optional="hide"/>
                <field name="default_session_duration" optional="hide"/>
                <field name="sessions_per_week" optional="hide"/>
                <field name="requires_proctoring" optional="hide" widget="boolean_toggle"/>
                <field name="requires_special_software" optional="hide" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ============ uni.course.delivery — Form View ============ -->
    <record id="view_uni_course_delivery_form" model="ir.ui.view">
        <field name="name">uni.course.delivery.form</field>
        <field name="model">uni.course.delivery</field>
        <field name="arch" type="xml">
            <form string="Course Delivery Mode">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Delivery Name"/>
                        <h1><field name="name" placeholder="e.g. On-Campus"/></h1>
                        <h3><field name="code" placeholder="e.g. ONC"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="delivery_method" widget="badge"/>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="default_max_enrollment"/>
                            <field name="default_session_duration"/>
                            <field name="sessions_per_week"/>
                        </group>
                    </group>
                    <group string="Classroom Requirements">
                        <group>
                            <field name="has_physical_classroom"/>
                            <field name="has_virtual_classroom"/>
                            <field name="has_livestream"/>
                            <field name="has_recording"/>
                        </group>
                    </group>
                    <group string="Proctoring &amp; Software">
                        <group>
                            <field name="requires_proctoring"/>
                            <field name="requires_special_software"/>
                            <field name="software_requirements"
                                   invisible="not requires_special_software"
                                   colspan="2"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============ uni.course.delivery — Search View ============ -->
    <record id="view_uni_course_delivery_search" model="ir.ui.view">
        <field name="name">uni.course.delivery.search</field>
        <field name="model">uni.course.delivery</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter string="Active" name="filter_active"
                        domain="[('active', '=', True)]"/>
                <separator/>
                <filter string="On-Campus" name="filter_on_campus"
                        domain="[('delivery_method', '=', 'on_campus')]"/>
                <filter string="Online (Sync)" name="filter_online_sync"
                        domain="[('delivery_method', '=', 'online_sync')]"/>
                <filter string="Online (Async)" name="filter_online_async"
                        domain="[('delivery_method', '=', 'online_async')]"/>
                <filter string="Hybrid" name="filter_hybrid"
                        domain="[('delivery_method', '=', 'hybrid')]"/>
                <filter string="Blended" name="filter_blended"
                        domain="[('delivery_method', '=', 'blended')]"/>
                <filter string="Distance" name="filter_distance"
                        domain="[('delivery_method', '=', 'distance')]"/>
                <separator/>
                <filter string="Requires Physical Classroom" name="filter_physical"
                        domain="[('has_physical_classroom', '=', True)]"/>
                <filter string="Requires Virtual Classroom" name="filter_virtual"
                        domain="[('has_virtual_classroom', '=', True)]"/>
                <filter string="Has Recording" name="filter_recording"
                        domain="[('has_recording', '=', True)]"/>
                <filter string="Requires Proctoring" name="filter_proctoring"
                        domain="[('requires_proctoring', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Delivery Method" name="group_method"
                            context="{'group_by': 'delivery_method'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============ uni.course.delivery — Action ============ -->
    <record id="action_uni_course_delivery" model="ir.actions.act_window">
        <field name="name">Course Delivery Modes</field>
        <field name="res_model">uni.course.delivery</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_course_delivery_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new course delivery mode
            </p>
            <p>
                Delivery Modes describe how a course is taught — on-campus,
                online (synchronous/asynchronous), hybrid, blended, distance,
                etc. Each mode can specify classroom and proctoring
                requirements.
            </p>
        </field>
    </record>
</odoo>
