<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ uni.evaluation.type — List View ============ -->
    <record id="view_uni_evaluation_type_list" model="ir.ui.view">
        <field name="name">uni.evaluation.type.list</field>
        <field name="model">uni.evaluation.type</field>
        <field name="arch" type="xml">
            <list string="Evaluation Types">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="weight_type"/>
                <field name="default_weight"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ============ uni.evaluation.type — Form View ============ -->
    <record id="view_uni_evaluation_type_form" model="ir.ui.view">
        <field name="name">uni.evaluation.type.form</field>
        <field name="model">uni.evaluation.type</field>
        <field name="arch" type="xml">
            <form string="Evaluation Type">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Evaluation Type"/>
                        <h1><field name="name" placeholder="e.g. Final Exam"/></h1>
                        <h3><field name="code" placeholder="e.g. FINAL"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="weight_type"/>
                            <field name="default_weight"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============ uni.evaluation.type — Search View ============ -->
    <record id="view_uni_evaluation_type_search" model="ir.ui.view">
        <field name="name">uni.evaluation.type.search</field>
        <field name="model">uni.evaluation.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter string="Active" name="filter_active"
                        domain="[('active', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Weight Type" name="group_weight"
                            context="{'group_by': 'weight_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============ uni.evaluation.type — Action ============ -->
    <record id="action_uni_evaluation_type" model="ir.actions.act_window">
        <field name="name">Evaluation Types</field>
        <field name="res_model">uni.evaluation.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_evaluation_type_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new evaluation type
            </p>
            <p>
                Evaluation types categorize how students are assessed (Final Exam,
                Midterm, Assignment, Quiz, Project, Participation, Lab, Oral Exam).
            </p>
        </field>
    </record>
</odoo>
