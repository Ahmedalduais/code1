<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ uni.program.course — List View ============ -->
    <record id="view_uni_program_course_list" model="ir.ui.view">
        <field name="name">uni.program.course.list</field>
        <field name="model">uni.program.course</field>
        <field name="arch" type="xml">
            <list string="Program-Course Links">
                <field name="sequence" widget="handle"/>
                <field name="program_id"/>
                <field name="course_id"/>
                <field name="college_id" optional="hide"/>
                <field name="department_id" optional="hide"/>
                <field name="level"/>
                <field name="semester"/>
                <field name="effective_credit_hours"/>
                <field name="is_mandatory" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ============ uni.program.course — Form View ============ -->
    <record id="view_uni_program_course_form" model="ir.ui.view">
        <field name="name">uni.program.course.form</field>
        <field name="model">uni.program.course</field>
        <field name="arch" type="xml">
            <form string="Program-Course Link">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_lines" icon="fa-list-ul">
                            <field name="line_count" widget="statinfo" string="Lines"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="program_id" string="Program-Course Link"/>
                        <h2><field name="program_id" options="{'no_create': True}"/></h2>
                        <h3><field name="course_id" options="{'no_create': True}"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="university_id" readonly="1"/>
                            <field name="college_id" readonly="1"/>
                            <field name="department_id" readonly="1"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="level"/>
                            <field name="semester"/>
                            <field name="credit_hours"/>
                            <field name="effective_credit_hours" readonly="1"/>
                            <field name="is_mandatory"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Prerequisites" name="prerequisites">
                            <field name="prerequisite_course_ids"
                                   options="{'no_create': True}">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="college_id"/>
                                    <field name="credit_hours"/>
                                </list>
                            </field>
                        </page>
                        <page string="Lines" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============ uni.program.course — Search View ============ -->
    <record id="view_uni_program_course_search" model="ir.ui.view">
        <field name="name">uni.program.course.search</field>
        <field name="model">uni.program.course</field>
        <field name="arch" type="xml">
            <search>
                <field name="program_id"/>
                <field name="course_id"/>
                <field name="college_id"/>
                <field name="department_id"/>
                <filter string="Active" name="filter_active"
                        domain="[('active', '=', True)]"/>
                <filter string="Mandatory" name="filter_mandatory"
                        domain="[('is_mandatory', '=', True)]"/>
                <filter string="Elective" name="filter_elective"
                        domain="[('is_mandatory', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Program" name="group_program"
                            context="{'group_by': 'program_id'}"/>
                    <filter string="Course" name="group_course"
                            context="{'group_by': 'course_id'}"/>
                    <filter string="College" name="group_college"
                            context="{'group_by': 'college_id'}"/>
                    <filter string="Year Level" name="group_level"
                            context="{'group_by': 'level'}"/>
                    <filter string="Semester" name="group_semester"
                            context="{'group_by': 'semester'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============ uni.program.course — Action ============ -->
    <record id="action_uni_program_course" model="ir.actions.act_window">
        <field name="name">Program Courses</field>
        <field name="res_model">uni.program.course</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_program_course_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Link a course to a program
            </p>
            <p>
                Program-Course links define which courses belong to each program,
                at which year and semester they are taught, and whether they are
                mandatory or elective.
            </p>
        </field>
    </record>

    <!-- ============ uni.program.course.line — List/Form (standalone) ============ -->
    <record id="view_uni_program_course_line_list" model="ir.ui.view">
        <field name="name">uni.program.course.line.list</field>
        <field name="model">uni.program.course.line</field>
        <field name="arch" type="xml">
            <list string="Program-Course Lines">
                <field name="sequence" widget="handle"/>
                <field name="program_course_id"/>
                <field name="program_id" optional="hide"/>
                <field name="course_id" optional="hide"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_uni_program_course_line_form" model="ir.ui.view">
        <field name="name">uni.program.course.line.form</field>
        <field name="model">uni.program.course.line</field>
        <field name="arch" type="xml">
            <form string="Program-Course Line">
                <sheet>
                    <group>
                        <group>
                            <field name="program_course_id" options="{'no_create': True}"/>
                            <field name="program_id" readonly="1"/>
                            <field name="course_id" readonly="1"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_uni_program_course_line" model="ir.actions.act_window">
        <field name="name">Program Course Lines</field>
        <field name="res_model">uni.program.course.line</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
