<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sequence for Course Evaluation Reference -->
    <data>
        <record id="seq_uni_course_evaluation" model="ir.sequence">
            <field name="name">Course Evaluation Sequence</field>
            <field name="code">uni.course.evaluation</field>
            <field name="prefix">EVAL/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>

    <!-- Default Evaluation Types (do not re-create on update) -->
    <data noupdate="1">
        <record id="evaluation_type_final_exam" model="uni.evaluation.type">
            <field name="name">Final Exam</field>
            <field name="code">FINAL</field>
            <field name="description">Comprehensive final examination covering all course material.</field>
            <field name="weight_type">percentage</field>
            <field name="default_weight">40.0</field>
            <field name="sequence">10</field>
        </record>

        <record id="evaluation_type_midterm" model="uni.evaluation.type">
            <field name="name">Midterm Exam</field>
            <field name="code">MIDTERM</field>
            <field name="description">Mid-term examination covering the first half of the course.</field>
            <field name="weight_type">percentage</field>
            <field name="default_weight">20.0</field>
            <field name="sequence">20</field>
        </record>

        <record id="evaluation_type_assignment" model="uni.evaluation.type">
            <field name="name">Assignment</field>
            <field name="code">ASSIGN</field>
            <field name="description">Individual or group assignments submitted during the term.</field>
            <field name="weight_type">percentage</field>
            <field name="default_weight">10.0</field>
            <field name="sequence">30</field>
        </record>

        <record id="evaluation_type_quiz" model="uni.evaluation.type">
            <field name="name">Quiz</field>
            <field name="code">QUIZ</field>
            <field name="description">Short quizzes administered during lectures or tutorials.</field>
            <field name="weight_type">percentage</field>
            <field name="default_weight">5.0</field>
            <field name="sequence">40</field>
        </record>

        <record id="evaluation_type_project" model="uni.evaluation.type">
            <field name="name">Project</field>
            <field name="code">PROJECT</field>
            <field name="description">Capstone or term project assessing applied skills.</field>
            <field name="weight_type">percentage</field>
            <field name="default_weight">15.0</field>
            <field name="sequence">50</field>
        </record>

        <record id="evaluation_type_participation" model="uni.evaluation.type">
            <field name="name">Participation</field>
            <field name="code">PARTICIP</field>
            <field name="description">Class participation and attendance contribution.</field>
            <field name="weight_type">percentage</field>
            <field name="default_weight">5.0</field>
            <field name="sequence">60</field>
        </record>

        <record id="evaluation_type_lab" model="uni.evaluation.type">
            <field name="name">Lab</field>
            <field name="code">LAB</field>
            <field name="description">Laboratory work and lab reports.</field>
            <field name="weight_type">percentage</field>
            <field name="default_weight">10.0</field>
            <field name="sequence">70</field>
        </record>

        <record id="evaluation_type_oral_exam" model="uni.evaluation.type">
            <field name="name">Oral Exam</field>
            <field name="code">ORAL</field>
            <field name="description">Oral examination or viva voce.</field>
            <field name="weight_type">percentage</field>
            <field name="default_weight">10.0</field>
            <field name="sequence">80</field>
        </record>
    </data>
</odoo>
