<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ uni.project.meeting — List View ============ -->
    <record id="view_uni_project_meeting_list" model="ir.ui.view">
        <field name="name">uni.project.meeting.list</field>
        <field name="model">uni.project.meeting</field>
        <field name="arch" type="xml">
            <list string="Project Meetings"
                  decoration-success="state == 'completed'"
                  decoration-info="state == 'ongoing'"
                  decoration-warning="state == 'scheduled'"
                  decoration-danger="state == 'cancelled'">
                <field name="name"/>
                <field name="title"/>
                <field name="project_id"/>
                <field name="meeting_type"/>
                <field name="date"/>
                <field name="chairperson_id" optional="show"/>
                <field name="is_online" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============ uni.project.meeting — Form View ============ -->
    <record id="view_uni_project_meeting_form" model="ir.ui.view">
        <field name="name">uni.project.meeting.form</field>
        <field name="model">uni.project.meeting</field>
        <field name="arch" type="xml">
            <form string="Project Meeting">
                <header>
                    <button name="action_start" type="object" string="Start"
                            class="btn-primary"
                            invisible="state != 'scheduled'"/>
                    <button name="action_complete" type="object" string="Complete"
                            class="btn-success"
                            invisible="state != 'ongoing'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            class="btn-danger"
                            invisible="state in ('cancelled', 'completed')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="scheduled,ongoing,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="title" string="Meeting Title"/>
                        <h1><field name="title" placeholder="e.g. Weekly Progress Sync"/></h1>
                        <h3><field name="name" readonly="1"/></h3>
                    </div>
                    <group>
                        <group string="Affiliation">
                            <field name="project_id" options="{'no_create': True}"/>
                            <field name="meeting_type"/>
                            <field name="chairperson_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Schedule">
                            <field name="date"/>
                            <field name="start_time" widget="float_time"/>
                            <field name="end_time" widget="float_time"/>
                            <field name="duration"/>
                        </group>
                    </group>
                    <group>
                        <group string="Location">
                            <field name="is_online"/>
                            <field name="location"
                                   invisible="is_online == True"/>
                            <field name="meeting_url"
                                   invisible="is_online == False"/>
                        </group>
                        <group string="Attendance">
                            <field name="attendees"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Agenda" name="agenda">
                            <field name="agenda"/>
                        </page>
                        <page string="Minutes" name="minutes">
                            <field name="minutes"/>
                        </page>
                        <page string="Decisions" name="decisions">
                            <field name="decisions"/>
                        </page>
                        <page string="Action Items" name="action_items">
                            <field name="action_items"/>
                        </page>
                        <page string="Document" name="document">
                            <group>
                                <field name="file" filename="filename"/>
                                <field name="filename" invisible="not file"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============ uni.project.meeting — Calendar View ============ -->
    <record id="view_uni_project_meeting_calendar" model="ir.ui.view">
        <field name="name">uni.project.meeting.calendar</field>
        <field name="model">uni.project.meeting</field>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <calendar string="Project Meetings"
                      date_start="date"
                      date_stop="date"
                      color="meeting_type"
                      event_open_popup="True"
                      quick_add="True">
                <field name="title"/>
                <field name="project_id"/>
                <field name="meeting_type"/>
                <field name="chairperson_id"/>
            </calendar>
        </field>
    </record>

    <!-- ============ uni.project.meeting — Search View ============ -->
    <record id="view_uni_project_meeting_search" model="ir.ui.view">
        <field name="name">uni.project.meeting.search</field>
        <field name="model">uni.project.meeting</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="title"/>
                <field name="project_id"/>
                <field name="meeting_type"/>
                <field name="chairperson_id"/>
                <separator/>
                <filter string="Scheduled" name="filter_scheduled"
                        domain="[('state', '=', 'scheduled')]"/>
                <filter string="Ongoing" name="filter_ongoing"
                        domain="[('state', '=', 'ongoing')]"/>
                <filter string="Completed" name="filter_completed"
                        domain="[('state', '=', 'completed')]"/>
                <filter string="Cancelled" name="filter_cancelled"
                        domain="[('state', '=', 'cancelled')]"/>
                <filter string="Online" name="filter_online"
                        domain="[('is_online', '=', True)]"/>
                <separator/>
                <filter string="Kickoff" name="filter_kickoff"
                        domain="[('meeting_type', '=', 'kickoff')]"/>
                <filter string="Progress" name="filter_progress"
                        domain="[('meeting_type', '=', 'progress')]"/>
                <filter string="Review" name="filter_review"
                        domain="[('meeting_type', '=', 'review')]"/>
                <filter string="Supervisor" name="filter_supervisor"
                        domain="[('meeting_type', '=', 'supervisor')]"/>
                <filter string="Committee" name="filter_committee"
                        domain="[('meeting_type', '=', 'committee')]"/>
                <filter string="Emergency" name="filter_emergency"
                        domain="[('meeting_type', '=', 'emergency')]"/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_project"
                            context="{'group_by': 'project_id'}"/>
                    <filter string="Type" name="group_type"
                            context="{'group_by': 'meeting_type'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Chairperson" name="group_chair"
                            context="{'group_by': 'chairperson_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============ uni.project.meeting — Action ============ -->
    <record id="action_uni_project_meeting" model="ir.actions.act_window">
        <field name="name">Project Meetings</field>
        <field name="res_model">uni.project.meeting</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="search_view_id" ref="view_uni_project_meeting_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Schedule your first project meeting
            </p>
            <p>
                Track kickoff, progress, review, supervisor, committee and
                emergency meetings with agenda, minutes, decisions and action
                items.
            </p>
        </field>
    </record>
</odoo>
