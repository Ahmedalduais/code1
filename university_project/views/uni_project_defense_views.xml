<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ uni.project.defense — List View ============ -->
    <record id="view_uni_project_defense_list" model="ir.ui.view">
        <field name="name">uni.project.defense.list</field>
        <field name="model">uni.project.defense</field>
        <field name="arch" type="xml">
            <list string="Defenses"
                  decoration-success="decision == 'pass'"
                  decoration-warning="decision == 'conditional_pass'"
                  decoration-danger="decision == 'fail'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="defense_type" optional="show"/>
                <field name="date"/>
                <field name="location" optional="hide"/>
                <field name="is_online" optional="hide" widget="boolean_toggle"/>
                <field name="chairperson_id" optional="show"/>
                <field name="grade" optional="show"/>
                <field name="max_grade" optional="hide"/>
                <field name="grade_percentage" widget="progressbar" optional="show"/>
                <field name="decision" optional="show" widget="badge"/>
                <field name="state" widget="badge"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============ uni.project.defense — Form View ============ -->
    <record id="view_uni_project_defense_form" model="ir.ui.view">
        <field name="name">uni.project.defense.form</field>
        <field name="model">uni.project.defense</field>
        <field name="arch" type="xml">
            <form string="Project Defense">
                <header>
                    <button name="action_start" type="object" string="Start"
                            class="btn-primary"
                            invisible="state != 'scheduled'"/>
                    <button name="action_complete" type="object"
                            string="Complete" class="btn-success"
                            invisible="state != 'ongoing'"/>
                    <button name="action_cancel" type="object"
                            string="Cancel" class="btn-danger"
                            invisible="state in ('completed', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                          statusbar_visible="scheduled,ongoing,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Reference"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Defense">
                            <field name="project_id" options="{'no_create': True}"/>
                            <field name="defense_type"/>
                            <field name="date"/>
                            <field name="start_time"/>
                            <field name="end_time"/>
                            <field name="duration" readonly="1"/>
                        </group>
                        <group string="Location">
                            <field name="location"/>
                            <field name="is_online" widget="boolean_toggle"/>
                            <field name="meeting_url"
                                   invisible="is_online == False"/>
                            <field name="is_public" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group>
                        <group string="Committee">
                            <field name="chairperson_id"
                                   options="{'no_create': True}"/>
                            <field name="committee_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True}"/>
                        </group>
                        <group string="Grading">
                            <field name="grade"/>
                            <field name="max_grade"/>
                            <field name="grade_percentage" widget="progressbar"
                                   readonly="1"/>
                            <field name="grade_letter"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Presentation" name="presentation">
                            <group>
                                <field name="presentation_file"
                                       filename="presentation_filename"/>
                                <field name="presentation_filename"
                                       invisible="1"/>
                                <field name="attendance"
                                       placeholder="List of attendees..."/>
                            </group>
                        </page>
                        <page string="Decision" name="decision">
                            <group>
                                <field name="decision"/>
                                <field name="conditions"
                                       invisible="decision != 'conditional_pass'"
                                       placeholder="Conditions that must be met..."/>
                            </group>
                        </page>
                        <page string="Feedback" name="feedback">
                            <group>
                                <field name="feedback"
                                       placeholder="Committee feedback..."/>
                                <field name="recommendations"
                                       placeholder="Recommendations for improvement..."/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============ uni.project.defense — Search View ============ -->
    <record id="view_uni_project_defense_search" model="ir.ui.view">
        <field name="name">uni.project.defense.search</field>
        <field name="model">uni.project.defense</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="chairperson_id"/>
                <field name="location"/>
                <separator/>
                <filter string="Scheduled" name="filter_scheduled"
                        domain="[('state', '=', 'scheduled')]"/>
                <filter string="Ongoing" name="filter_ongoing"
                        domain="[('state', '=', 'ongoing')]"/>
                <filter string="Completed" name="filter_completed"
                        domain="[('state', '=', 'completed')]"/>
                <filter string="Cancelled" name="filter_cancelled"
                        domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Proposal Defense" name="filter_proposal"
                        domain="[('defense_type', '=', 'proposal')]"/>
                <filter string="Midterm Defense" name="filter_midterm"
                        domain="[('defense_type', '=', 'midterm')]"/>
                <filter string="Final Defense" name="filter_final"
                        domain="[('defense_type', '=', 'final')]"/>
                <separator/>
                <filter string="Pass" name="filter_pass"
                        domain="[('decision', '=', 'pass')]"/>
                <filter string="Conditional Pass" name="filter_conditional"
                        domain="[('decision', '=', 'conditional_pass')]"/>
                <filter string="Fail" name="filter_fail"
                        domain="[('decision', '=', 'fail')]"/>
                <filter string="Deferred" name="filter_defer"
                        domain="[('decision', '=', 'defer')]"/>
                <filter string="Public Defense" name="filter_public"
                        domain="[('is_public', '=', True)]"/>
                <filter string="Online" name="filter_online"
                        domain="[('is_online', '=', True)]"/>
                <filter string="Archived" name="filter_inactive"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_project"
                            context="{'group_by': 'project_id'}"/>
                    <filter string="Defense Type" name="group_type"
                            context="{'group_by': 'defense_type'}"/>
                    <filter string="Decision" name="group_decision"
                            context="{'group_by': 'decision'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Chairperson" name="group_chair"
                            context="{'group_by': 'chairperson_id'}"/>
                    <filter string="Date" name="group_date"
                            context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============ uni.project.defense — Action ============ -->
    <record id="action_uni_project_defense" model="ir.actions.act_window">
        <field name="name">Defenses</field>
        <field name="res_model">uni.project.defense</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_project_defense_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Schedule your first defense session
            </p>
            <p>
                Manage proposal, midterm, and final defenses: schedule the
                session, assign a committee and chairperson, record grades
                and decisions, and automatically transition the project to
                "Defended" on a pass.
            </p>
        </field>
    </record>
</odoo>
