<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ uni.project.evaluation — List View ============ -->
    <record id="view_uni_project_evaluation_list" model="ir.ui.view">
        <field name="name">uni.project.evaluation.list</field>
        <field name="model">uni.project.evaluation</field>
        <field name="arch" type="xml">
            <list string="Evaluations"
                  decoration-success="is_passing == True and state == 'finalized'"
                  decoration-danger="is_passing == False and state == 'finalized'"
                  decoration-muted="state == 'draft'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="evaluation_type" widget="badge"/>
                <field name="team_id" optional="show"/>
                <field name="member_id" optional="show"/>
                <field name="evaluation_date" optional="show"/>
                <field name="evaluated_by" optional="hide"/>
                <field name="team_score" optional="hide"/>
                <field name="individual_score" optional="hide"/>
                <field name="total_score" sum="Total Score"/>
                <field name="max_score" optional="hide"/>
                <field name="score_percentage" widget="progressbar"/>
                <field name="weight" optional="hide"/>
                <field name="grade_letter" optional="hide"/>
                <field name="is_passing" optional="hide" widget="boolean_toggle"/>
                <field name="state" widget="badge"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============ uni.project.evaluation — Form View ============ -->
    <record id="view_uni_project_evaluation_form" model="ir.ui.view">
        <field name="name">uni.project.evaluation.form</field>
        <field name="model">uni.project.evaluation</field>
        <field name="arch" type="xml">
            <form string="Project Evaluation">
                <header>
                    <button name="action_complete" type="object"
                            string="Complete" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_appeal" type="object"
                            string="Appeal" class="btn-warning"
                            invisible="state != 'completed'"/>
                    <button name="action_finalize" type="object"
                            string="Finalize" class="btn-success"
                            invisible="state not in ('completed', 'appealed')"/>
                    <button name="action_draft" type="object"
                            string="Reset to Draft" class="btn-secondary"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                          statusbar_visible="draft,completed,finalized"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Reference"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Target">
                            <field name="project_id" options="{'no_create': True}"/>
                            <field name="evaluation_type"/>
                            <field name="team_id" options="{'no_create': True}"
                                   invisible="evaluation_type == 'individual'"/>
                            <field name="member_id" options="{'no_create': True}"
                                   invisible="evaluation_type == 'team'"/>
                        </group>
                        <group string="Context">
                            <field name="evaluation_date"/>
                            <field name="evaluated_by" options="{'no_create': True}"/>
                            <field name="weight"/>
                            <field name="grade_letter"/>
                            <field name="is_passing" readonly="1"
                                   widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group>
                        <group string="Scores">
                            <field name="team_score"
                                   invisible="evaluation_type == 'individual'"/>
                            <field name="individual_score"
                                   invisible="evaluation_type == 'team'"/>
                            <field name="total_score" readonly="1"/>
                            <field name="max_score"/>
                            <field name="score_percentage" widget="progressbar"
                                   readonly="1"/>
                        </group>
                        <group string="Criteria">
                            <field name="evaluation_criteria"
                                   placeholder="Criteria used for grading..."/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Comments" name="comments">
                            <group>
                                <field name="comments"
                                       placeholder="Overall comments..."/>
                                <field name="strengths"
                                       placeholder="Strengths identified..."/>
                                <field name="weaknesses"
                                       placeholder="Weaknesses identified..."/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============ uni.project.evaluation — Search View ============ -->
    <record id="view_uni_project_evaluation_search" model="ir.ui.view">
        <field name="name">uni.project.evaluation.search</field>
        <field name="model">uni.project.evaluation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="team_id"/>
                <field name="member_id"/>
                <field name="evaluated_by"/>
                <separator/>
                <filter string="Team" name="filter_team"
                        domain="[('evaluation_type', '=', 'team')]"/>
                <filter string="Individual" name="filter_individual"
                        domain="[('evaluation_type', '=', 'individual')]"/>
                <filter string="Mixed" name="filter_mixed"
                        domain="[('evaluation_type', '=', 'mixed')]"/>
                <separator/>
                <filter string="Passing" name="filter_passing"
                        domain="[('is_passing', '=', True)]"/>
                <filter string="Failing" name="filter_failing"
                        domain="[('is_passing', '=', False)]"/>
                <separator/>
                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Completed" name="filter_completed"
                        domain="[('state', '=', 'completed')]"/>
                <filter string="Appealed" name="filter_appealed"
                        domain="[('state', '=', 'appealed')]"/>
                <filter string="Finalized" name="filter_finalized"
                        domain="[('state', '=', 'finalized')]"/>
                <filter string="Archived" name="filter_inactive"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_project"
                            context="{'group_by': 'project_id'}"/>
                    <filter string="Type" name="group_type"
                            context="{'group_by': 'evaluation_type'}"/>
                    <filter string="State" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Evaluated By" name="group_evaluator"
                            context="{'group_by': 'evaluated_by'}"/>
                    <filter string="Team" name="group_team"
                            context="{'group_by': 'team_id'}"/>
                    <filter string="Evaluation Date" name="group_date"
                            context="{'group_by': 'evaluation_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============ uni.project.evaluation — Action ============ -->
    <record id="action_uni_project_evaluation" model="ir.actions.act_window">
        <field name="name">Evaluations</field>
        <field name="res_model">uni.project.evaluation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_project_evaluation_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first project evaluation
            </p>
            <p>
                Evaluate projects as a team, an individual member, or a mix of
                both. Track scores, weights, and grade letters through the
                draft → completed → appealed → finalized lifecycle.
            </p>
        </field>
    </record>
</odoo>
