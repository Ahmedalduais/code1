<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ uni.project.timeline — List View ============ -->
    <record id="view_uni_project_timeline_list" model="ir.ui.view">
        <field name="name">uni.project.timeline.list</field>
        <field name="model">uni.project.timeline</field>
        <field name="arch" type="xml">
            <list string="Project Timelines">
                <field name="name"/>
                <field name="project_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="duration_days" optional="show"/>
                <field name="duration_weeks" optional="show"/>
                <field name="milestone_count" optional="show"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============ uni.project.timeline — Form View ============ -->
    <record id="view_uni_project_timeline_form" model="ir.ui.view">
        <field name="name">uni.project.timeline.form</field>
        <field name="model">uni.project.timeline</field>
        <field name="arch" type="xml">
            <form string="Project Timeline">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Timeline Name"/>
                        <h1><field name="name" placeholder="e.g. Spring 2025 Timeline"/></h1>
                    </div>
                    <group>
                        <group string="Project">
                            <field name="project_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Schedule">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="duration_days"/>
                            <field name="duration_weeks"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Milestones" name="milestones">
                            <field name="milestone_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="milestone_type"/>
                                    <field name="planned_date"/>
                                    <field name="actual_date"/>
                                    <field name="completed_date"/>
                                    <field name="is_completed" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============ uni.project.timeline — Search View ============ -->
    <record id="view_uni_project_timeline_search" model="ir.ui.view">
        <field name="name">uni.project.timeline.search</field>
        <field name="model">uni.project.timeline</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <separator/>
                <filter string="Archived" name="filter_inactive"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_project"
                            context="{'group_by': 'project_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============ uni.project.timeline — Action ============ -->
    <record id="action_uni_project_timeline" model="ir.actions.act_window">
        <field name="name">Project Timelines</field>
        <field name="res_model">uni.project.timeline</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_project_timeline_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first project timeline
            </p>
            <p>
                Timelines define the high-level schedule of a project and group
                related milestones together.
            </p>
        </field>
    </record>
</odoo>
