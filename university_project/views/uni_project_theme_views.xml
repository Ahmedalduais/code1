<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ uni.project.theme — List View ============ -->
    <record id="view_uni_project_theme_list" model="ir.ui.view">
        <field name="name">uni.project.theme.list</field>
        <field name="model">uni.project.theme</field>
        <field name="arch" type="xml">
            <list string="Project Themes">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="parent_id" optional="show"/>
                <field name="color" widget="integer_color_picker" optional="show"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============ uni.project.theme — Form View ============ -->
    <record id="view_uni_project_theme_form" model="ir.ui.view">
        <field name="name">uni.project.theme.form</field>
        <field name="model">uni.project.theme</field>
        <field name="arch" type="xml">
            <form string="Project Theme">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Theme Name"/>
                        <h1><field name="name" placeholder="e.g. Software Engineering"/></h1>
                        <h3><field name="code" placeholder="e.g. SE"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="parent_id" options="{'no_create': True}"/>
                            <field name="sequence"/>
                            <field name="color"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============ uni.project.theme — Search View ============ -->
    <record id="view_uni_project_theme_search" model="ir.ui.view">
        <field name="name">uni.project.theme.search</field>
        <field name="model">uni.project.theme</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="parent_id"/>
                <separator/>
                <filter string="Archived" name="filter_inactive"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Parent Theme" name="group_parent"
                            context="{'group_by': 'parent_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============ uni.project.theme — Action ============ -->
    <record id="action_uni_project_theme" model="ir.actions.act_window">
        <field name="name">Project Themes</field>
        <field name="res_model">uni.project.theme</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_project_theme_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first project theme
            </p>
            <p>
                Themes classify graduation projects by knowledge area
                (e.g. Software Engineering, AI, IoT).
            </p>
        </field>
    </record>
</odoo>
