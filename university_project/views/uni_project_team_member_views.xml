<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ uni.project.team.member — List View ============ -->
    <record id="view_uni_project_team_member_list" model="ir.ui.view">
        <field name="name">uni.project.team.member.list</field>
        <field name="model">uni.project.team.member</field>
        <field name="arch" type="xml">
            <list string="Team Members"
                  decoration-success="is_active==True"
                  decoration-muted="is_active==False">
                <field name="student_id"/>
                <field name="student_code"/>
                <field name="team_id"/>
                <field name="project_id" optional="show"/>
                <field name="role"/>
                <field name="join_date" optional="show"/>
                <field name="exit_date" optional="hide"/>
                <field name="contribution_percentage" sum="Total Contribution"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ============ uni.project.team.member — Form View ============ -->
    <record id="view_uni_project_team_member_form" model="ir.ui.view">
        <field name="name">uni.project.team.member.form</field>
        <field name="model">uni.project.team.member</field>
        <field name="arch" type="xml">
            <form string="Team Member">
                <header>
                    <button name="action_set_inactive" type="object"
                            string="Set Inactive" class="btn-warning"
                            invisible="is_active == False"/>
                    <button name="action_reactivate" type="object"
                            string="Reactivate" class="btn-primary"
                            invisible="is_active == True"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="student_id" string="Student"/>
                        <h1><field name="student_id" options="{'no_create': True}"/></h1>
                        <h3><field name="student_code" readonly="1"/></h3>
                    </div>
                    <group>
                        <group string="Team Affiliation">
                            <field name="team_id" options="{'no_create': True}"/>
                            <field name="project_id" options="{'no_create': True}"/>
                            <field name="student_name"/>
                        </group>
                        <group string="Role &amp; Contribution">
                            <field name="role"/>
                            <field name="contribution_percentage"/>
                            <field name="is_active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <group>
                        <group string="Dates">
                            <field name="join_date"/>
                            <field name="exit_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============ uni.project.team.member — Search View ============ -->
    <record id="view_uni_project_team_member_search" model="ir.ui.view">
        <field name="name">uni.project.team.member.search</field>
        <field name="model">uni.project.team.member</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_id"/>
                <field name="student_code"/>
                <field name="student_name"/>
                <field name="team_id"/>
                <field name="project_id"/>
                <separator/>
                <filter string="Active Members" name="filter_active"
                        domain="[('is_active', '=', True)]"/>
                <filter string="Inactive Members" name="filter_inactive"
                        domain="[('is_active', '=', False)]"/>
                <filter string="Team Leaders" name="filter_leaders"
                        domain="[('role', '=', 'leader')]"/>
                <filter string="Members" name="filter_members"
                        domain="[('role', '=', 'member')]"/>
                <filter string="Contributors" name="filter_contributors"
                        domain="[('role', '=', 'contributor')]"/>
                <separator/>
                <filter string="Archived" name="filter_archived"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Team" name="group_team"
                            context="{'group_by': 'team_id'}"/>
                    <filter string="Project" name="group_project"
                            context="{'group_by': 'project_id'}"/>
                    <filter string="Role" name="group_role"
                            context="{'group_by': 'role'}"/>
                    <filter string="Active" name="group_active"
                            context="{'group_by': 'is_active'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============ uni.project.team.member — Action ============ -->
    <record id="action_uni_project_team_member" model="ir.actions.act_window">
        <field name="name">Team Members</field>
        <field name="res_model">uni.project.team.member</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_project_team_member_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first team member
            </p>
            <p>
                Each member tracks a student's role, contribution, and
                active status within a project team.
            </p>
        </field>
    </record>
</odoo>
