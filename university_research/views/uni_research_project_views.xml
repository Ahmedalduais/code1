<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- uni.research.project — List View                              -->
    <!-- ============================================================ -->
    <record id="view_uni_research_project_list" model="ir.ui.view">
        <field name="name">uni.research.project.list</field>
        <field name="model">uni.research.project</field>
        <field name="arch" type="xml">
            <list string="Research Projects"
                  decoration-info="state in ('proposal', 'submitted')"
                  decoration-success="state == 'active'"
                  decoration-primary="state == 'approved'"
                  decoration-muted="state == 'completed'"
                  decoration-warning="state == 'suspended'"
                  decoration-danger="state == 'cancelled'">
                <field name="name"/>
                <field name="title"/>
                <field name="principal_investigator_id"/>
                <field name="department_id" optional="hide"/>
                <field name="college_id"/>
                <field name="project_type"/>
                <field name="research_area"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="duration_months"/>
                <field name="budget" sum="Total Budget"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="grant_id" optional="hide"/>
                <field name="publication_count" sum="Total Publications"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('proposal', 'submitted')"
                       decoration-success="state == 'active'"
                       decoration-primary="state == 'approved'"
                       decoration-muted="state == 'completed'"
                       decoration-warning="state == 'suspended'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.research.project — Kanban View (grouped by state)         -->
    <!-- ============================================================ -->
    <record id="view_uni_research_project_kanban" model="ir.ui.view">
        <field name="name">uni.research.project.kanban</field>
        <field name="model">uni.research.project</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column"
                    sample="1">
                <field name="name"/>
                <field name="title"/>
                <field name="state"/>
                <field name="principal_investigator_id"/>
                <field name="project_type"/>
                <field name="research_area"/>
                <field name="budget"/>
                <field name="currency_id"/>
                <field name="publication_count"/>
                <field name="activity_state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headline">
                                    <div>
                                        <strong><field name="title"/></strong>
                                    </div>
                                    <small class="text-muted">
                                        <field name="name"/>
                                    </small>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>
                                    <span class="text-muted">PI: </span>
                                    <field name="principal_investigator_id"/>
                                </div>
                                <div t-if="record.research_area.raw_value">
                                    <span class="text-muted">Area: </span>
                                    <field name="research_area"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="project_type"
                                           widget="badge"
                                           decoration-info="project_type == 'fundamental'"
                                           decoration-success="project_type == 'applied'"
                                           decoration-warning="project_type == 'developmental'"
                                           decoration-secondary="project_type == 'experimental'"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <span t-if="record.publication_count.raw_value">
                                        <field name="publication_count"/>
                                        <i class="fa fa-file-text-o" title="Publications"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.research.project — Form View                              -->
    <!-- ============================================================ -->
    <record id="view_uni_research_project_form" model="ir.ui.view">
        <field name="name">uni.research.project.form</field>
        <field name="model">uni.research.project</field>
        <field name="arch" type="xml">
            <form string="Research Project">
                <header>
                    <button name="action_submit" string="Submit"
                            type="object" class="oe_highlight"
                            invisible="state != 'proposal'"/>
                    <button name="action_back_to_proposal" string="Back to Proposal"
                            type="object"
                            invisible="state != 'submitted'"/>
                    <button name="action_approve" string="Approve"
                            type="object" class="oe_highlight"
                            invisible="state != 'submitted'"/>
                    <button name="action_start" string="Start Project"
                            type="object" class="oe_highlight"
                            invisible="state != 'approved'"/>
                    <button name="action_complete" string="Complete"
                            type="object" class="oe_highlight"
                            invisible="state != 'active'"/>
                    <button name="action_suspend" string="Suspend"
                            type="object"
                            invisible="state != 'active'"/>
                    <button name="action_resume" string="Resume"
                            type="object" class="oe_highlight"
                            invisible="state != 'suspended'"/>
                    <button name="action_cancel" string="Cancel"
                            type="object"
                            invisible="state in ('completed', 'cancelled')"
                            confirm="Are you sure you want to cancel this research project?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="proposal,submitted,approved,active,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_publications" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="publication_count" widget="statinfo"
                                   string="Publications"/>
                        </button>
                        <button name="action_open_ethics" type="object"
                                class="oe_stat_button" icon="fa-balance-scale">
                            <span class="o_stat_text">Ethics</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="title" string="Research Project"/>
                        <h1><field name="title" placeholder="Project title"/></h1>
                        <h3><field name="name" readonly="1"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="principal_investigator_id"
                                   options="{'no_create': True}"/>
                            <field name="co_investigator_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True}"/>
                            <field name="university_id" invisible="1"/>
                            <field name="college_id" readonly="1"/>
                            <field name="department_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="code"/>
                            <field name="project_type"/>
                            <field name="research_area"/>
                            <field name="keywords"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Overview">
                            <group>
                                <field name="abstract"
                                       placeholder="Short abstract describing the research..."/>
                                <field name="methodology"
                                       placeholder="Describe the methodology used..."/>
                                <field name="expected_outcomes"
                                       placeholder="Describe the expected outcomes..."/>
                            </group>
                        </page>
                        <page string="Timeline &amp; Budget">
                            <group>
                                <group>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="duration_months"/>
                                </group>
                                <group>
                                    <field name="budget"/>
                                    <field name="currency_id"/>
                                    <field name="grant_id"
                                           options="{'no_create': True}"/>
                                    <field name="ethics_approval_id"
                                           options="{'no_create': True}"/>
                                </group>
                            </group>
                        </page>
                        <page string="Publications">
                            <field name="publication_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="title"/>
                                    <field name="publication_type"/>
                                    <field name="publication_date"/>
                                    <field name="is_peer_reviewed"/>
                                    <field name="citation_count" sum="Total Citations"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.research.project — Search View                            -->
    <!-- ============================================================ -->
    <record id="view_uni_research_project_search" model="ir.ui.view">
        <field name="name">uni.research.project.search</field>
        <field name="model">uni.research.project</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="title"/>
                <field name="code"/>
                <field name="principal_investigator_id"/>
                <field name="co_investigator_ids"/>
                <field name="research_area"/>
                <field name="keywords"/>
                <field name="university_id"/>
                <field name="college_id"/>
                <field name="department_id"/>
                <field name="grant_id"/>
                <field name="ethics_approval_id"/>
                <separator/>
                <filter string="My Faculty Projects" name="filter_my_faculty"
                        domain="[('principal_investigator_id.user_id', '=', uid)]"/>
                <separator/>
                <filter string="Proposals" name="filter_proposal"
                        domain="[('state', '=', 'proposal')]"/>
                <filter string="Submitted" name="filter_submitted"
                        domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="filter_approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter string="Active" name="filter_active"
                        domain="[('state', '=', 'active')]"/>
                <filter string="Completed" name="filter_completed"
                        domain="[('state', '=', 'completed')]"/>
                <filter string="Suspended" name="filter_suspended"
                        domain="[('state', '=', 'suspended')]"/>
                <filter string="Cancelled" name="filter_cancelled"
                        domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Has Grant" name="filter_has_grant"
                        domain="[('grant_id', '!=', False)]"/>
                <filter string="Has Ethics" name="filter_has_ethics"
                        domain="[('ethics_approval_id', '!=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Principal Investigator" name="group_pi"
                            context="{'group_by': 'principal_investigator_id'}"/>
                    <filter string="College" name="group_college"
                            context="{'group_by': 'college_id'}"/>
                    <filter string="Department" name="group_department"
                            context="{'group_by': 'department_id'}"/>
                    <filter string="Project Type" name="group_type"
                            context="{'group_by': 'project_type'}"/>
                    <filter string="State" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Grant" name="group_grant"
                            context="{'group_by': 'grant_id'}"/>
                    <filter string="Start Month" name="group_start_month"
                            context="{'group_by': 'start_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.research.project — Action                                 -->
    <!-- ============================================================ -->
    <record id="action_uni_research_project" model="ir.actions.act_window">
        <field name="name">Research Projects</field>
        <field name="res_model">uni.research.project</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_uni_research_project_search"/>
        <field name="context">{
            'search_default_filter_active': 1,
            'search_default_filter_proposal': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new research project
            </p>
            <p>Track the full lifecycle of research projects: proposal,
               approval, active execution, and completion — with PI,
               co-investigators, budget, grant, and ethics linkage.</p>
        </field>
    </record>
</odoo>
