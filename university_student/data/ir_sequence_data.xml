<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Student code sequence -->
    <record id="seq_uni_student" model="ir.sequence">
        <field name="name">Student Sequence</field>
        <field name="code">uni.student</field>
        <field name="prefix">STU/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Student enrollment sequence -->
    <record id="seq_uni_student_enrollment" model="ir.sequence">
        <field name="name">Student Enrollment Sequence</field>
        <field name="code">uni.student.enrollment</field>
        <field name="prefix">ENR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Student transfer sequence -->
    <record id="seq_uni_student_transfer" model="ir.sequence">
        <field name="name">Student Transfer Sequence</field>
        <field name="code">uni.student.transfer</field>
        <field name="prefix">TRF/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Attendance sequence -->
    <record id="seq_uni_attendance" model="ir.sequence">
        <field name="name">Attendance Sequence</field>
        <field name="code">uni.attendance</field>
        <field name="prefix">ATT/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Student advisor sequence -->
    <record id="seq_uni_student_advisor" model="ir.sequence">
        <field name="name">Student Advisor Sequence</field>
        <field name="code">uni.student.advisor</field>
        <field name="prefix">ADV/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
