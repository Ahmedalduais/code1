<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- uni.student — List View                                       -->
    <!-- ============================================================ -->
    <record id="view_uni_student_list" model="ir.ui.view">
        <field name="name">uni.student.list</field>
        <field name="model">uni.student</field>
        <field name="arch" type="xml">
            <list string="Students"
                  decoration-success="state == 'active'"
                  decoration-info="state == 'graduated'"
                  decoration-warning="state == 'prospective'"
                  decoration-danger="state in ('suspended', 'withdrawn', 'deceased')">
                <field name="student_code"/>
                <field name="name"/>
                <field name="program_id"/>
                <field name="department_id" optional="hide"/>
                <field name="college_id"/>
                <field name="current_level"/>
                <field name="cumulative_gpa"/>
                <field name="total_credits_earned"/>
                <field name="academic_standing"/>
                <field name="status_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-info="state == 'graduated'"
                       decoration-warning="state == 'prospective'"
                       decoration-danger="state in ('suspended', 'withdrawn', 'deceased')"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.student — Form View                                       -->
    <!-- ============================================================ -->
    <record id="view_uni_student_form" model="ir.ui.view">
        <field name="name">uni.student.form</field>
        <field name="model">uni.student</field>
        <field name="arch" type="xml">
            <form string="Student">
                <header>
                    <button name="action_activate" string="Activate"
                            type="object" class="oe_highlight"
                            invisible="state not in ('prospective', 'suspended', 'withdrawn')"/>
                    <button name="action_reactivate" string="Reactivate"
                            type="object"
                            invisible="state not in ('suspended', 'withdrawn')"/>
                    <button name="action_suspend" string="Suspend"
                            type="object"
                            invisible="state not in ('active', 'prospective')"
                            confirm="Are you sure you want to suspend this student?"/>
                    <button name="action_withdraw" string="Withdraw"
                            type="object"
                            invisible="state in ('withdrawn', 'graduated', 'deceased')"
                            confirm="Are you sure you want to withdraw this student?"/>
                    <button name="action_graduate" string="Graduate"
                            type="object" class="oe_highlight"
                            invisible="state not in ('active', 'suspended')"
                            confirm="Confirm graduation for this student?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="prospective,active,graduated"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_enrollments" type="object"
                                class="oe_stat_button" icon="fa-book">
                            <field name="enrollment_count" widget="statinfo"
                                   string="Enrollments"/>
                        </button>
                        <button name="action_view_documents" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="document_count" widget="statinfo"
                                   string="Documents"/>
                        </button>
                        <button name="action_view_attendance" type="object"
                                class="oe_stat_button" icon="fa-calendar-check-o">
                            <field name="attendance_count" widget="statinfo"
                                   string="Attendance"/>
                        </button>
                    </div>
                    <field name="photo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name" string="Student"/>
                        <h1><field name="name" placeholder="Student's full name"/></h1>
                        <h3><field name="student_code" placeholder="e.g. STU/2025/00001"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="person_id" invisible="1"/>
                            <field name="university_id" invisible="1"/>
                            <field name="student_type"/>
                            <field name="program_id"
                                   options="{'no_create': True}"/>
                            <field name="college_id"
                                   options="{'no_create': True}"/>
                            <field name="department_id"
                                   options="{'no_create': True}"/>
                            <field name="branch_id"
                                   options="{'no_create': True}"/>
                            <field name="status_id"
                                   options="{'no_create': True}"/>
                            <field name="advisor_name"/>
                        </group>
                        <group>
                            <field name="barcode"/>
                            <field name="current_level"/>
                            <field name="admission_date"/>
                            <field name="expected_graduation_date"/>
                            <field name="actual_graduation_date"
                                   invisible="state != 'graduated'"/>
                            <field name="transfer_university"
                                   invisible="student_type != 'transfer'"/>
                        </group>
                    </group>
                    <group string="Academic Progress">
                        <group>
                            <field name="cumulative_gpa"/>
                            <field name="academic_standing" widget="badge"
                                   decoration-success="academic_standing == 'excellent'"
                                   decoration-info="academic_standing == 'good'"
                                   decoration-warning="academic_standing == 'probation'"
                                   decoration-danger="academic_standing == 'dismissed'"/>
                        </group>
                        <group>
                            <field name="total_credits_earned"/>
                            <field name="total_credits_required"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Enrollments">
                            <field name="enrollment_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="academic_term_id"/>
                                    <field name="program_id"/>
                                    <field name="enrollment_type"/>
                                    <field name="level"/>
                                    <field name="total_credits"/>
                                    <field name="cumulative_gpa"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Documents">
                            <field name="document_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="document_type"/>
                                    <field name="issue_date"/>
                                    <field name="expiry_date"/>
                                    <field name="issued_by"/>
                                    <field name="verified" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Attendance">
                            <field name="attendance_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="course_id"/>
                                    <field name="academic_term_id"/>
                                    <field name="date"/>
                                    <field name="session_type"/>
                                    <field name="attendance_percentage"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Guardian &amp; Sponsor">
                            <group>
                                <group string="Guardian">
                                    <field name="guardian_name"/>
                                    <field name="guardian_phone"/>
                                    <field name="guardian_relationship"/>
                                </group>
                                <group string="Sponsor">
                                    <field name="sponsor"/>
                                    <field name="sponsor_phone"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.student — Search View                                     -->
    <!-- ============================================================ -->
    <record id="view_uni_student_search" model="ir.ui.view">
        <field name="name">uni.student.search</field>
        <field name="model">uni.student</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="student_code"/>
                <field name="barcode"/>
                <field name="national_id"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="university_id"/>
                <field name="college_id"/>
                <field name="department_id"/>
                <field name="program_id"/>
                <field name="advisor_name"/>
                <field name="status_id"/>
                <filter string="Active" name="filter_active"
                        domain="[('state', '=', 'active')]"/>
                <filter string="Prospective" name="filter_prospective"
                        domain="[('state', '=', 'prospective')]"/>
                <filter string="Graduated" name="filter_graduated"
                        domain="[('state', '=', 'graduated')]"/>
                <filter string="Suspended" name="filter_suspended"
                        domain="[('state', '=', 'suspended')]"/>
                <filter string="Withdrawn" name="filter_withdrawn"
                        domain="[('state', '=', 'withdrawn')]"/>
                <separator/>
                <filter string="Transfer Students" name="filter_transfer"
                        domain="[('student_type', '=', 'transfer')]"/>
                <filter string="Exchange Students" name="filter_exchange"
                        domain="[('student_type', '=', 'exchange')]"/>
                <group expand="0" string="Group By">
                    <filter string="University" name="group_university"
                            context="{'group_by': 'university_id'}"/>
                    <filter string="College" name="group_college"
                            context="{'group_by': 'college_id'}"/>
                    <filter string="Department" name="group_department"
                            context="{'group_by': 'department_id'}"/>
                    <filter string="Program" name="group_program"
                            context="{'group_by': 'program_id'}"/>
                    <filter string="Status" name="group_status"
                            context="{'group_by': 'status_id'}"/>
                    <filter string="State" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Student Type" name="group_type"
                            context="{'group_by': 'student_type'}"/>
                    <filter string="Standing" name="group_standing"
                            context="{'group_by': 'academic_standing'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.student — Action                                          -->
    <!-- ============================================================ -->
    <record id="action_uni_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">uni.student</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_student_search"/>
        <field name="context">{
            'search_default_filter_active': 1,
            'default_person_type': 'student',
            'default_state': 'prospective',
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new student record
            </p>
            <p>Students inherit from uni.person (delegation) and carry the full
               academic lifecycle: enrollments, documents, attendance and transfers.</p>
        </field>
    </record>
</odoo>
