<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- uni.student.transfer — List View                              -->
    <!-- ============================================================ -->
    <record id="view_uni_student_transfer_list" model="ir.ui.view">
        <field name="name">uni.student.transfer.list</field>
        <field name="model">uni.student.transfer</field>
        <field name="arch" type="xml">
            <list string="Student Transfers"
                  decoration-success="state == 'completed'"
                  decoration-info="state == 'approved'"
                  decoration-muted="state == 'rejected'"
                  decoration-warning="state == 'draft'">
                <field name="name"/>
                <field name="student_id"/>
                <field name="transfer_date"/>
                <field name="transfer_type"/>
                <field name="from_program_id"/>
                <field name="to_program_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'completed'"
                       decoration-info="state == 'approved'"
                       decoration-muted="state == 'rejected'"
                       decoration-warning="state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.student.transfer — Form View                              -->
    <!-- ============================================================ -->
    <record id="view_uni_student_transfer_form" model="ir.ui.view">
        <field name="name">uni.student.transfer.form</field>
        <field name="model">uni.student.transfer</field>
        <field name="arch" type="xml">
            <form string="Student Transfer">
                <header>
                    <button name="action_approve" string="Approve"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"
                            groups="university_core.group_university_manager"/>
                    <button name="action_complete" string="Complete Transfer"
                            type="object" class="oe_highlight"
                            invisible="state != 'approved'"
                            confirm="Apply this transfer to the student record?"/>
                    <button name="action_reject" string="Reject"
                            type="object"
                            invisible="state not in ('draft', 'approved')"
                            groups="university_core.group_university_manager"
                            confirm="Reject this transfer request?"/>
                    <button name="action_draft" string="Set to Draft"
                            type="object"
                            invisible="state != 'rejected'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,approved,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Transfer"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="student_id"
                                   options="{'no_create': True}"/>
                            <field name="transfer_date"/>
                            <field name="transfer_type"/>
                            <field name="university_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="approved_by" readonly="1"/>
                            <field name="approved_date" readonly="1"/>
                            <field name="completed_by" readonly="1"/>
                            <field name="completed_date" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="From">
                            <field name="from_program_id"
                                   options="{'no_create': True}"/>
                            <field name="from_college_id"
                                   options="{'no_create': True}"/>
                            <field name="from_department_id"
                                   options="{'no_create': True}"/>
                        </group>
                        <group string="To">
                            <field name="to_program_id"
                                   options="{'no_create': True}"/>
                            <field name="to_college_id"
                                   options="{'no_create': True}"/>
                            <field name="to_department_id"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group>
                        <field name="reason"/>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.student.transfer — Search View                            -->
    <!-- ============================================================ -->
    <record id="view_uni_student_transfer_search" model="ir.ui.view">
        <field name="name">uni.student.transfer.search</field>
        <field name="model">uni.student.transfer</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="student_id"/>
                <field name="from_program_id"/>
                <field name="to_program_id"/>
                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Approved" name="filter_approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter string="Rejected" name="filter_rejected"
                        domain="[('state', '=', 'rejected')]"/>
                <filter string="Completed" name="filter_completed"
                        domain="[('state', '=', 'completed')]"/>
                <separator/>
                <filter string="Internal" name="filter_internal"
                        domain="[('transfer_type', '=', 'internal')]"/>
                <filter string="External" name="filter_external"
                        domain="[('transfer_type', '=', 'external')]"/>
                <group expand="0" string="Group By">
                    <filter string="Student" name="group_student"
                            context="{'group_by': 'student_id'}"/>
                    <filter string="Type" name="group_type"
                            context="{'group_by': 'transfer_type'}"/>
                    <filter string="Status" name="group_status"
                            context="{'group_by': 'state'}"/>
                    <filter string="From Program" name="group_from"
                            context="{'group_by': 'from_program_id'}"/>
                    <filter string="To Program" name="group_to"
                            context="{'group_by': 'to_program_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.student.transfer — Action                                 -->
    <!-- ============================================================ -->
    <record id="action_uni_student_transfer" model="ir.actions.act_window">
        <field name="name">Student Transfers</field>
        <field name="res_model">uni.student.transfer</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_student_transfer_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new transfer request
            </p>
            <p>Transfers move a student between programs (internal) or
               from/to another university (external).</p>
        </field>
    </record>
</odoo>
