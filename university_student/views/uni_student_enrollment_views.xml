<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- uni.student.enrollment — List View                            -->
    <!-- ============================================================ -->
    <record id="view_uni_student_enrollment_list" model="ir.ui.view">
        <field name="name">uni.student.enrollment.list</field>
        <field name="model">uni.student.enrollment</field>
        <field name="arch" type="xml">
            <list string="Enrollments"
                  decoration-success="state == 'completed'"
                  decoration-info="state == 'enrolled'"
                  decoration-muted="state == 'cancelled'"
                  decoration-danger="state == 'draft'">
                <field name="name"/>
                <field name="student_id"/>
                <field name="academic_term_id"/>
                <field name="academic_year_id" optional="hide"/>
                <field name="program_id"/>
                <field name="enrollment_type"/>
                <field name="level"/>
                <field name="total_credits"/>
                <field name="cumulative_gpa"/>
                <field name="line_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'completed'"
                       decoration-info="state == 'enrolled'"
                       decoration-muted="state == 'cancelled'"
                       decoration-danger="state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.student.enrollment — Form View                            -->
    <!-- ============================================================ -->
    <record id="view_uni_student_enrollment_form" model="ir.ui.view">
        <field name="name">uni.student.enrollment.form</field>
        <field name="model">uni.student.enrollment</field>
        <field name="arch" type="xml">
            <form string="Enrollment">
                <header>
                    <button name="action_enroll" string="Confirm Enrollment"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_complete" string="Complete"
                            type="object" class="oe_highlight"
                            invisible="state != 'enrolled'"/>
                    <button name="action_cancel" string="Cancel"
                            type="object"
                            invisible="state in ('cancelled', 'completed')"
                            confirm="Cancel this enrollment?"/>
                    <button name="action_draft" string="Set to Draft"
                            type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,enrolled,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_draft" type="object"
                                class="oe_stat_button" icon="fa-list"
                                invisible="True">
                            <field name="line_count" widget="statinfo"
                                   string="Lines"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Enrollment"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="student_id"
                                   options="{'no_create': True}"/>
                            <field name="academic_term_id"
                                   options="{'no_create': True}"/>
                            <field name="academic_year_id" readonly="1"/>
                            <field name="program_id"
                                   options="{'no_create': True}"/>
                            <field name="university_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="enrollment_date"/>
                            <field name="enrollment_type"/>
                            <field name="level"/>
                            <field name="total_credits"/>
                            <field name="total_credits_earned"/>
                            <field name="cumulative_gpa"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Course Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="course_id"
                                           options="{'no_create': True}"/>
                                    <field name="program_course_id"
                                           options="{'no_create': True}"/>
                                    <field name="credit_hours"/>
                                    <field name="final_grade"/>
                                    <field name="grade_letter"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.student.enrollment — Search View                          -->
    <!-- ============================================================ -->
    <record id="view_uni_student_enrollment_search" model="ir.ui.view">
        <field name="name">uni.student.enrollment.search</field>
        <field name="model">uni.student.enrollment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="student_id"/>
                <field name="academic_term_id"/>
                <field name="program_id"/>
                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Enrolled" name="filter_enrolled"
                        domain="[('state', '=', 'enrolled')]"/>
                <filter string="Completed" name="filter_completed"
                        domain="[('state', '=', 'completed')]"/>
                <filter string="Cancelled" name="filter_cancelled"
                        domain="[('state', '=', 'cancelled')]"/>
                <group expand="0" string="Group By">
                    <filter string="Student" name="group_student"
                            context="{'group_by': 'student_id'}"/>
                    <filter string="Term" name="group_term"
                            context="{'group_by': 'academic_term_id'}"/>
                    <filter string="Program" name="group_program"
                            context="{'group_by': 'program_id'}"/>
                    <filter string="Type" name="group_type"
                            context="{'group_by': 'enrollment_type'}"/>
                    <filter string="Status" name="group_status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.student.enrollment — Action                               -->
    <!-- ============================================================ -->
    <record id="action_uni_student_enrollment" model="ir.actions.act_window">
        <field name="name">Enrollments</field>
        <field name="res_model">uni.student.enrollment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_student_enrollment_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new enrollment
            </p>
            <p>Each enrollment tracks a student's course registration for a
               specific academic term under a program.</p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.student.enrollment.line — List View                       -->
    <!-- ============================================================ -->
    <record id="view_uni_student_enrollment_line_list" model="ir.ui.view">
        <field name="name">uni.student.enrollment.line.list</field>
        <field name="model">uni.student.enrollment.line</field>
        <field name="arch" type="xml">
            <list string="Enrollment Lines"
                  decoration-success="state == 'completed'"
                  decoration-warning="state == 'enrolled'"
                  decoration-muted="state == 'dropped'"
                  decoration-danger="state == 'failed'">
                <field name="enrollment_id"/>
                <field name="student_id"/>
                <field name="academic_term_id"/>
                <field name="course_id"/>
                <field name="program_course_id" optional="hide"/>
                <field name="credit_hours" sum="Total Credits"/>
                <field name="final_grade"/>
                <field name="grade_letter"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'completed'"
                       decoration-warning="state == 'enrolled'"
                       decoration-muted="state == 'dropped'"
                       decoration-danger="state == 'failed'"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.student.enrollment.line — Form View                       -->
    <!-- ============================================================ -->
    <record id="view_uni_student_enrollment_line_form" model="ir.ui.view">
        <field name="name">uni.student.enrollment.line.form</field>
        <field name="model">uni.student.enrollment.line</field>
        <field name="arch" type="xml">
            <form string="Enrollment Line">
                <header>
                    <button name="action_complete_line" string="Complete"
                            type="object" class="oe_highlight"
                            invisible="state != 'enrolled'"/>
                    <button name="action_drop" string="Drop"
                            type="object"
                            invisible="state not in ('enrolled', 'failed')"/>
                    <button name="action_fail" string="Mark Failed"
                            type="object"
                            invisible="state != 'enrolled'"
                            confirm="Mark this course as failed?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="enrolled,completed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="enrollment_id"
                                   options="{'no_create': True}"/>
                            <field name="student_id" readonly="1"/>
                            <field name="academic_term_id" readonly="1"/>
                            <field name="program_id" readonly="1"/>
                            <field name="university_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="course_id"
                                   options="{'no_create': True}"/>
                            <field name="program_course_id"
                                   options="{'no_create': True}"/>
                            <field name="credit_hours"/>
                            <field name="final_grade"/>
                            <field name="grade_letter"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.student.enrollment.line — Search View                     -->
    <!-- ============================================================ -->
    <record id="view_uni_student_enrollment_line_search" model="ir.ui.view">
        <field name="name">uni.student.enrollment.line.search</field>
        <field name="model">uni.student.enrollment.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="enrollment_id"/>
                <field name="student_id"/>
                <field name="course_id"/>
                <field name="academic_term_id"/>
                <field name="grade_letter"/>
                <filter string="Enrolled" name="filter_enrolled"
                        domain="[('state', '=', 'enrolled')]"/>
                <filter string="Completed" name="filter_completed"
                        domain="[('state', '=', 'completed')]"/>
                <filter string="Dropped" name="filter_dropped"
                        domain="[('state', '=', 'dropped')]"/>
                <filter string="Failed" name="filter_failed"
                        domain="[('state', '=', 'failed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Student" name="group_student"
                            context="{'group_by': 'student_id'}"/>
                    <filter string="Course" name="group_course"
                            context="{'group_by': 'course_id'}"/>
                    <filter string="Term" name="group_term"
                            context="{'group_by': 'academic_term_id'}"/>
                    <filter string="Grade" name="group_grade"
                            context="{'group_by': 'grade_letter'}"/>
                    <filter string="State" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.student.enrollment.line — Action                          -->
    <!-- ============================================================ -->
    <record id="action_uni_student_enrollment_line" model="ir.actions.act_window">
        <field name="name">Enrollment Lines</field>
        <field name="res_model">uni.student.enrollment.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_student_enrollment_line_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Open an enrollment to add course lines
            </p>
        </field>
    </record>
</odoo>
