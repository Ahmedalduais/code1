<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- uni.student.document — List View                              -->
    <!-- ============================================================ -->
    <record id="view_uni_student_document_list" model="ir.ui.view">
        <field name="name">uni.student.document.list</field>
        <field name="model">uni.student.document</field>
        <field name="arch" type="xml">
            <list string="Student Documents"
                  decoration-success="verified"
                  decoration-danger="expiry_date and expiry_date &lt; current_date">
                <field name="name"/>
                <field name="student_id"/>
                <field name="document_type"/>
                <field name="issue_date"/>
                <field name="expiry_date"/>
                <field name="issued_by"/>
                <field name="verified" widget="boolean_toggle"/>
                <field name="verified_by"/>
                <field name="verified_date"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.student.document — Form View                              -->
    <!-- ============================================================ -->
    <record id="view_uni_student_document_form" model="ir.ui.view">
        <field name="name">uni.student.document.form</field>
        <field name="model">uni.student.document</field>
        <field name="arch" type="xml">
            <form string="Student Document">
                <header>
                    <button name="action_verify" string="Verify"
                            type="object" class="oe_highlight"
                            invisible="verified"/>
                    <button name="action_unverify" string="Revoke Verification"
                            type="object"
                            invisible="not verified"
                            groups="university_core.group_university_manager"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Document"/>
                        <h1><field name="name" placeholder="e.g. Bachelor Transcript"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="student_id"
                                   options="{'no_create': True}"/>
                            <field name="document_type"/>
                            <field name="issued_by"/>
                            <field name="issue_date"/>
                            <field name="expiry_date"/>
                            <field name="university_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="file" filename="filename"/>
                            <field name="filename" invisible="1"/>
                            <field name="file_size"/>
                            <field name="verified" readonly="1"/>
                            <field name="verified_by" readonly="1"/>
                            <field name="verified_date" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.student.document — Search View                            -->
    <!-- ============================================================ -->
    <record id="view_uni_student_document_search" model="ir.ui.view">
        <field name="name">uni.student.document.search</field>
        <field name="model">uni.student.document</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="student_id"/>
                <field name="document_type"/>
                <field name="issued_by"/>
                <filter string="Verified" name="filter_verified"
                        domain="[('verified', '=', True)]"/>
                <filter string="Not Verified" name="filter_not_verified"
                        domain="[('verified', '=', False)]"/>
                <filter string="Expired" name="filter_expired"
                        domain="[('expiry_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="ID Card" name="filter_id_card"
                        domain="[('document_type', '=', 'id_card')]"/>
                <filter string="Passport" name="filter_passport"
                        domain="[('document_type', '=', 'passport')]"/>
                <filter string="Transcript" name="filter_transcript"
                        domain="[('document_type', '=', 'transcript')]"/>
                <filter string="Certificate" name="filter_certificate"
                        domain="[('document_type', '=', 'certificate')]"/>
                <group expand="0" string="Group By">
                    <filter string="Student" name="group_student"
                            context="{'group_by': 'student_id'}"/>
                    <filter string="Type" name="group_type"
                            context="{'group_by': 'document_type'}"/>
                    <filter string="Verified" name="group_verified"
                            context="{'group_by': 'verified'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.student.document — Action                                 -->
    <!-- ============================================================ -->
    <record id="action_uni_student_document" model="ir.actions.act_window">
        <field name="name">Student Documents</field>
        <field name="res_model">uni.student.document</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_student_document_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Upload a new student document
            </p>
            <p>Documents are versioned files attached to students (ID cards,
               passports, transcripts, certificates...).</p>
        </field>
    </record>
</odoo>
