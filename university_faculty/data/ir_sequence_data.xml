<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Faculty code sequence -->
    <record id="seq_uni_faculty" model="ir.sequence">
        <field name="name">Faculty Sequence</field>
        <field name="code">uni.faculty</field>
        <field name="prefix">FAC/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Faculty assignment sequence -->
    <record id="seq_uni_faculty_assignment" model="ir.sequence">
        <field name="name">Faculty Assignment Sequence</field>
        <field name="code">uni.faculty.assignment</field>
        <field name="prefix">ASN/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Faculty load sequence -->
    <record id="seq_uni_faculty_load" model="ir.sequence">
        <field name="name">Faculty Load Sequence</field>
        <field name="code">uni.faculty.load</field>
        <field name="prefix">LOAD/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Faculty publication sequence -->
    <record id="seq_uni_faculty_publication" model="ir.sequence">
        <field name="name">Faculty Publication Sequence</field>
        <field name="code">uni.faculty.publication</field>
        <field name="prefix">PUB/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Faculty contract sequence -->
    <record id="seq_uni_faculty_contract" model="ir.sequence">
        <field name="name">Faculty Contract Sequence</field>
        <field name="code">uni.faculty.contract</field>
        <field name="prefix">FCT/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
