<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- uni.committee — List View                                     -->
    <!-- ============================================================ -->
    <record id="view_uni_committee_list" model="ir.ui.view">
        <field name="name">uni.committee.list</field>
        <field name="model">uni.committee</field>
        <field name="arch" type="xml">
            <list string="Committees"
                  decoration-muted="state == 'closed'"
                  decoration-success="state == 'active'"
                  decoration-warning="state == 'draft'">
                <field name="code"/>
                <field name="name"/>
                <field name="committee_type"/>
                <field name="university_id"/>
                <field name="college_id"/>
                <field name="department_id"/>
                <field name="chair_id"/>
                <field name="member_count"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'draft'"
                       decoration-muted="state == 'closed'"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.committee — Form View                                     -->
    <!-- ============================================================ -->
    <record id="view_uni_committee_form" model="ir.ui.view">
        <field name="name">uni.committee.form</field>
        <field name="model">uni.committee</field>
        <field name="arch" type="xml">
            <form string="Committee">
                <header>
                    <button name="action_activate" string="Activate"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_close" string="Close"
                            type="object"
                            invisible="state != 'active'"
                            confirm="Are you sure you want to close this committee?"/>
                    <button name="action_draft" string="Reset to Draft"
                            type="object"
                            invisible="state != 'closed'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_members" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <field name="member_count" widget="statinfo"
                                   string="Members"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Committee"/>
                        <h1><field name="name" placeholder="Committee name"/></h1>
                        <h3><field name="code" placeholder="e.g. COMM/2025/0001"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="committee_type"/>
                            <field name="chair_id"/>
                            <field name="university_id"/>
                            <field name="college_id"/>
                            <field name="department_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Members">
                            <field name="member_ids">
                                <list editable="bottom">
                                    <field name="faculty_id"/>
                                    <field name="role"/>
                                    <field name="join_date"/>
                                    <field name="leave_date"/>
                                    <field name="is_active" widget="boolean_toggle"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.committee — Search View                                   -->
    <!-- ============================================================ -->
    <record id="view_uni_committee_search" model="ir.ui.view">
        <field name="name">uni.committee.search</field>
        <field name="model">uni.committee</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="chair_id"/>
                <field name="committee_type"/>
                <field name="university_id"/>
                <field name="college_id"/>
                <field name="department_id"/>
                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Active" name="filter_active"
                        domain="[('state', '=', 'active')]"/>
                <filter string="Closed" name="filter_closed"
                        domain="[('state', '=', 'closed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_type"
                            context="{'group_by': 'committee_type'}"/>
                    <filter string="University" name="group_university"
                            context="{'group_by': 'university_id'}"/>
                    <filter string="College" name="group_college"
                            context="{'group_by': 'college_id'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.committee — Action                                        -->
    <!-- ============================================================ -->
    <record id="action_uni_committee" model="ir.actions.act_window">
        <field name="name">Committees</field>
        <field name="res_model">uni.committee</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_committee_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new committee
            </p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.committee.member — List View                              -->
    <!-- ============================================================ -->
    <record id="view_uni_committee_member_list" model="ir.ui.view">
        <field name="name">uni.committee.member.list</field>
        <field name="model">uni.committee.member</field>
        <field name="arch" type="xml">
            <list string="Committee Members"
                  decoration-success="is_active and role == 'chair'"
                  decoration-info="is_active and role == 'vice_chair'"
                  decoration-muted="not is_active">
                <field name="committee_id"/>
                <field name="faculty_id"/>
                <field name="role"/>
                <field name="join_date"/>
                <field name="leave_date"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.committee.member — Form View                              -->
    <!-- ============================================================ -->
    <record id="view_uni_committee_member_form" model="ir.ui.view">
        <field name="name">uni.committee.member.form</field>
        <field name="model">uni.committee.member</field>
        <field name="arch" type="xml">
            <form string="Committee Member">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Member"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="committee_id"/>
                            <field name="faculty_id"/>
                            <field name="role"/>
                        </group>
                        <group>
                            <field name="join_date"/>
                            <field name="leave_date"/>
                            <field name="is_active"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.committee.member — Search View                            -->
    <!-- ============================================================ -->
    <record id="view_uni_committee_member_search" model="ir.ui.view">
        <field name="name">uni.committee.member.search</field>
        <field name="model">uni.committee.member</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="committee_id"/>
                <field name="faculty_id"/>
                <field name="role"/>
                <field name="university_id"/>
                <filter string="Active Members" name="filter_active"
                        domain="[('is_active', '=', True)]"/>
                <filter string="Inactive Members" name="filter_inactive"
                        domain="[('is_active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Committee" name="group_committee"
                            context="{'group_by': 'committee_id'}"/>
                    <filter string="Role" name="group_role"
                            context="{'group_by': 'role'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.committee.member — Action                                 -->
    <!-- ============================================================ -->
    <record id="action_uni_committee_member" model="ir.actions.act_window">
        <field name="name">Committee Members</field>
        <field name="res_model">uni.committee.member</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_committee_member_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new committee member
            </p>
        </field>
    </record>
</odoo>
