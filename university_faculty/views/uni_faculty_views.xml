<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- uni.faculty — List View                                       -->
    <!-- ============================================================ -->
    <record id="view_uni_faculty_list" model="ir.ui.view">
        <field name="name">uni.faculty.list</field>
        <field name="model">uni.faculty</field>
        <field name="arch" type="xml">
            <list string="Faculty Members"
                  decoration-success="state == 'active'"
                  decoration-warning="state == 'on_leave'"
                  decoration-danger="state == 'terminated'">
                <field name="faculty_code"/>
                <field name="name"/>
                <field name="faculty_rank_id"/>
                <field name="department_id"/>
                <field name="college_id"/>
                <field name="employment_type"/>
                <field name="hire_date"/>
                <field name="total_load_hours"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'on_leave'"
                       decoration-danger="state == 'terminated'"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.faculty — Form View                                       -->
    <!-- ============================================================ -->
    <record id="view_uni_faculty_form" model="ir.ui.view">
        <field name="name">uni.faculty.form</field>
        <field name="model">uni.faculty</field>
        <field name="arch" type="xml">
            <form string="Faculty Member">
                <header>
                    <button name="action_activate" string="Activate"
                            type="object" class="oe_highlight"
                            invisible="state not in ('on_leave', 'terminated')"/>
                    <button name="action_on_leave" string="Set On Leave"
                            type="object"
                            invisible="state != 'active'"/>
                    <button name="action_terminate" string="Terminate"
                            type="object"
                            invisible="state == 'terminated'"
                            confirm="Are you sure you want to terminate this faculty member?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="active,on_leave,terminated"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_assignments" type="object"
                                class="oe_stat_button" icon="fa-book">
                            <field name="active_assignment_count" widget="statinfo"
                                   string="Assignments"/>
                        </button>
                        <button name="action_open_loads" type="object"
                                class="oe_stat_button" icon="fa-clock-o">
                            <field name="total_load_hours" widget="statinfo"
                                   string="Load (Hrs)"/>
                        </button>
                        <button name="action_open_publications" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="publication_count" widget="statinfo"
                                   string="Publications"/>
                        </button>
                        <button name="action_open_committees" type="object"
                                class="oe_stat_button" icon="fa-group">
                            <field name="committee_count" widget="statinfo"
                                   string="Committees"/>
                        </button>
                    </div>
                    <field name="photo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name" string="Faculty Member"/>
                        <h1><field name="name" placeholder="Faculty member's full name"/></h1>
                        <h3><field name="faculty_code" placeholder="e.g. FAC/2025/0001"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="person_id" invisible="1"/>
                            <field name="faculty_rank_id"/>
                            <field name="department_id"/>
                            <field name="college_id"/>
                            <field name="university_id" invisible="1"/>
                            <field name="hr_employee_id"/>
                        </group>
                        <group>
                            <field name="employment_type"/>
                            <field name="hire_date"/>
                            <field name="termination_date"
                                   invisible="state != 'terminated'"/>
                            <field name="office_location"/>
                            <field name="office_phone"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Academic Profile">
                            <group>
                                <group>
                                    <field name="specialization"/>
                                    <field name="research_interests"/>
                                </group>
                                <group>
                                    <field name="cv_file" filename="cv_filename"/>
                                    <field name="cv_filename" invisible="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Assignments">
                            <field name="assignment_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="course_name"/>
                                    <field name="academic_term_id"/>
                                    <field name="assignment_type"/>
                                    <field name="section"/>
                                    <field name="student_count"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Teaching Load">
                            <field name="load_ids">
                                <list>
                                    <field name="academic_term_id"/>
                                    <field name="load_type"/>
                                    <field name="teaching_hours"/>
                                    <field name="credit_hours"/>
                                    <field name="research_hours"/>
                                    <field name="admin_hours"/>
                                    <field name="total_hours"/>
                                </list>
                            </field>
                        </page>
                        <page string="Publications">
                            <field name="publication_ids">
                                <list>
                                    <field name="title"/>
                                    <field name="publication_type"/>
                                    <field name="publication_date"/>
                                    <field name="publisher"/>
                                    <field name="is_peer_reviewed"/>
                                    <field name="citation_count"/>
                                </list>
                            </field>
                        </page>
                        <page string="Committees">
                            <field name="committee_member_ids">
                                <list>
                                    <field name="committee_id"/>
                                    <field name="role"/>
                                    <field name="join_date"/>
                                    <field name="leave_date"/>
                                    <field name="is_active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.faculty — Search View                                     -->
    <!-- ============================================================ -->
    <record id="view_uni_faculty_search" model="ir.ui.view">
        <field name="name">uni.faculty.search</field>
        <field name="model">uni.faculty</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="faculty_code"/>
                <field name="national_id"/>
                <field name="email"/>
                <field name="office_phone"/>
                <field name="university_id"/>
                <field name="college_id"/>
                <field name="department_id"/>
                <field name="faculty_rank_id"/>
                <filter string="Active" name="filter_active"
                        domain="[('state', '=', 'active')]"/>
                <filter string="On Leave" name="filter_on_leave"
                        domain="[('state', '=', 'on_leave')]"/>
                <filter string="Terminated" name="filter_terminated"
                        domain="[('state', '=', 'terminated')]"/>
                <group expand="0" string="Group By">
                    <filter string="University" name="group_university"
                            context="{'group_by': 'university_id'}"/>
                    <filter string="College" name="group_college"
                            context="{'group_by': 'college_id'}"/>
                    <filter string="Department" name="group_department"
                            context="{'group_by': 'department_id'}"/>
                    <filter string="Rank" name="group_rank"
                            context="{'group_by': 'faculty_rank_id'}"/>
                    <filter string="Employment Type" name="group_employment"
                            context="{'group_by': 'employment_type'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.faculty — Action                                          -->
    <!-- ============================================================ -->
    <record id="action_uni_faculty" model="ir.actions.act_window">
        <field name="name">Faculty Members</field>
        <field name="res_model">uni.faculty</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_faculty_search"/>
        <field name="context">{
            'search_default_filter_active': 1,
            'default_person_type': 'faculty',
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new faculty member
            </p>
            <p>Faculty members are managed with delegation from uni.person
               and can optionally be linked to HR employees.</p>
        </field>
    </record>
</odoo>
