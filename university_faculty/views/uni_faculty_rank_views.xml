<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- uni.faculty.rank — List View                                  -->
    <!-- ============================================================ -->
    <record id="view_uni_faculty_rank_list" model="ir.ui.view">
        <field name="name">uni.faculty.rank.list</field>
        <field name="model">uni.faculty.rank</field>
        <field name="arch" type="xml">
            <list string="Faculty Ranks">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="min_years_experience"/>
                <field name="salary_grade"/>
                <field name="faculty_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.faculty.rank — Form View                                  -->
    <!-- ============================================================ -->
    <record id="view_uni_faculty_rank_form" model="ir.ui.view">
        <field name="name">uni.faculty.rank.form</field>
        <field name="model">uni.faculty.rank</field>
        <field name="arch" type="xml">
            <form string="Faculty Rank">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_faculty" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <field name="faculty_count" widget="statinfo"
                                   string="Faculty"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Academic Rank"/>
                        <h1><field name="name" placeholder="e.g. Professor"/></h1>
                        <h3><field name="code" placeholder="e.g. PROF"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="min_years_experience"/>
                            <field name="salary_grade"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.faculty.rank — Search View                                -->
    <!-- ============================================================ -->
    <record id="view_uni_faculty_rank_search" model="ir.ui.view">
        <field name="name">uni.faculty.rank.search</field>
        <field name="model">uni.faculty.rank</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter string="Active" name="filter_active"
                        domain="[('active', '=', True)]"/>
                <filter string="Archived" name="filter_archived"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Salary Grade" name="group_grade"
                            context="{'group_by': 'salary_grade'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.faculty.rank — Action                                     -->
    <!-- ============================================================ -->
    <record id="action_uni_faculty_rank" model="ir.actions.act_window">
        <field name="name">Faculty Ranks</field>
        <field name="res_model">uni.faculty.rank</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_faculty_rank_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new faculty academic rank
            </p>
        </field>
    </record>
</odoo>
