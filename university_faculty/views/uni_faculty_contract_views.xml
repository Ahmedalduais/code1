<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- uni.faculty.contract — List View                              -->
    <!-- ============================================================ -->
    <record id="view_uni_faculty_contract_list" model="ir.ui.view">
        <field name="name">uni.faculty.contract.list</field>
        <field name="model">uni.faculty.contract</field>
        <field name="arch" type="xml">
            <list string="Faculty Contracts"
                  decoration-success="state == 'active'"
                  decoration-info="state == 'approved'"
                  decoration-warning="state in ('submitted', 'renewed')"
                  decoration-danger="state in ('terminated', 'expired')"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="faculty_id"/>
                <field name="contract_type"/>
                <field name="university_id"/>
                <field name="department_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="salary" sum="Total Annual Salary"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-info="state == 'approved'"
                       decoration-warning="state in ('submitted', 'renewed')"
                       decoration-danger="state in ('terminated', 'expired')"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.faculty.contract — Form View                              -->
    <!-- ============================================================ -->
    <record id="view_uni_faculty_contract_form" model="ir.ui.view">
        <field name="name">uni.faculty.contract.form</field>
        <field name="model">uni.faculty.contract</field>
        <field name="arch" type="xml">
            <form string="Faculty Contract">
                <header>
                    <button name="action_submit" string="Submit"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve"
                            type="object" class="oe_highlight"
                            invisible="state != 'submitted'"
                            groups="university_core.group_university_manager"/>
                    <button name="action_activate" string="Activate"
                            type="object" class="oe_highlight"
                            invisible="state != 'approved'"
                            groups="university_core.group_university_manager"/>
                    <button name="action_renew" string="Renew"
                            type="object"
                            invisible="state not in ('active', 'expired')"
                            groups="university_core.group_university_manager"/>
                    <button name="action_terminate" string="Terminate"
                            type="object"
                            invisible="state not in ('active', 'approved')"
                            confirm="Terminate this contract now?"
                            groups="university_core.group_university_manager"/>
                    <button name="action_expire" string="Mark Expired"
                            type="object"
                            invisible="state != 'active'"
                            groups="university_core.group_university_manager"/>
                    <button name="action_cancel" string="Cancel"
                            type="object"
                            invisible="state in ('cancelled', 'terminated', 'expired')"
                            groups="university_core.group_university_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,active"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Contract"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="faculty_id"
                                   options="{'no_create': True}"/>
                            <field name="faculty_name" invisible="1"/>
                            <field name="contract_type"/>
                        </group>
                        <group>
                            <field name="university_id"
                                   options="{'no_create': True}"/>
                            <field name="college_id"
                                   options="{'no_create': True}"/>
                            <field name="department_id"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group>
                        <group string="Duration">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="renewal_date"/>
                            <field name="notice_period_days"/>
                        </group>
                        <group string="Compensation">
                            <field name="salary"/>
                            <field name="currency_id"
                                   groups="base.group_multi_currency"/>
                            <field name="payment_frequency"/>
                        </group>
                    </group>
                    <group>
                        <group string="Workload (Hours/Week)">
                            <field name="teaching_load_hours"/>
                            <field name="research_load_hours"/>
                            <field name="admin_load_hours"/>
                        </group>
                        <group string="Sign-off">
                            <field name="signed_date"/>
                            <field name="signed_by"/>
                            <field name="approved_by"/>
                            <field name="approved_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Terms &amp; Conditions">
                            <group>
                                <field name="benefits"/>
                                <field name="terms_conditions"/>
                            </group>
                        </page>
                        <page string="Document">
                            <group>
                                <field name="contract_file"
                                       filename="contract_filename"/>
                                <field name="contract_filename" invisible="1"/>
                            </group>
                        </page>
                        <page string="Termination"
                              invisible="state not in ('terminated', 'expired')">
                            <group>
                                <field name="termination_date"/>
                                <field name="termination_reason"/>
                            </group>
                        </page>
                        <page string="Notes">
                            <group>
                                <field name="notes"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.faculty.contract — Search View                            -->
    <!-- ============================================================ -->
    <record id="view_uni_faculty_contract_search" model="ir.ui.view">
        <field name="name">uni.faculty.contract.search</field>
        <field name="model">uni.faculty.contract</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="faculty_id"/>
                <field name="contract_type"/>
                <field name="university_id"/>
                <field name="college_id"/>
                <field name="department_id"/>
                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="filter_submitted"
                        domain="[('state', '=', 'submitted')]"/>
                <filter string="Active" name="filter_active"
                        domain="[('state', '=', 'active')]"/>
                <filter string="Expired" name="filter_expired"
                        domain="[('state', '=', 'expired')]"/>
                <filter string="Terminated" name="filter_terminated"
                        domain="[('state', '=', 'terminated')]"/>
                <separator/>
                <filter string="Full-Time" name="filter_full_time"
                        domain="[('contract_type', '=', 'full_time')]"/>
                <filter string="Part-Time" name="filter_part_time"
                        domain="[('contract_type', '=', 'part_time')]"/>
                <filter string="Tenured / Tenure Track" name="filter_tenure"
                        domain="[('contract_type', 'in', ('tenure_track', 'tenured'))]"/>
                <filter string="Visiting / Adjunct" name="filter_visiting"
                        domain="[('contract_type', 'in', ('visiting', 'adjunct'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Faculty" name="group_faculty"
                            context="{'group_by': 'faculty_id'}"/>
                    <filter string="Type" name="group_type"
                            context="{'group_by': 'contract_type'}"/>
                    <filter string="University" name="group_university"
                            context="{'group_by': 'university_id'}"/>
                    <filter string="College" name="group_college"
                            context="{'group_by': 'college_id'}"/>
                    <filter string="Department" name="group_department"
                            context="{'group_by': 'department_id'}"/>
                    <filter string="Status" name="group_status"
                            context="{'group_by': 'state'}"/>
                    <filter string="Payment Frequency" name="group_payment"
                            context="{'group_by': 'payment_frequency'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.faculty.contract — Action                                 -->
    <!-- ============================================================ -->
    <record id="action_uni_faculty_contract" model="ir.actions.act_window">
        <field name="name">Faculty Contracts</field>
        <field name="res_model">uni.faculty.contract</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_faculty_contract_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new faculty contract
            </p>
            <p>Manage full-time, part-time, visiting, tenure-track and
               contractor contracts with compensation, workload and
               approval workflow.</p>
        </field>
    </record>
</odoo>
