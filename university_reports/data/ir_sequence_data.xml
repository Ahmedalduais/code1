<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Report Builder sequence -->
    <record id="seq_uni_report_builder" model="ir.sequence">
        <field name="name">Report Builder Sequence</field>
        <field name="code">uni.report.builder</field>
        <field name="prefix">RPB/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Report Schedule sequence -->
    <record id="seq_uni_report_schedule" model="ir.sequence">
        <field name="name">Report Schedule Sequence</field>
        <field name="code">uni.report.schedule</field>
        <field name="prefix">RSC/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
