<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- ============================================================ -->
    <!-- Daily cron — calls uni.report.schedule._scheduler_cron()     -->
    <!-- ============================================================ -->
    <record id="ir_cron_uni_report_scheduler" model="ir.cron">
        <field name="name">University: Run Scheduled Reports</field>
        <field name="model_id" ref="model_uni_report_schedule"/>
        <field name="state">code</field>
        <field name="code">model._scheduler_cron()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="active" eval="True"/>
    </record>
</odoo>
