<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- Paper format — A4 portrait for transcript summary            -->
    <!-- ============================================================ -->
    <record id="paper_format_transcript_summary" model="report.paperformat">
        <field name="name">Transcript Summary A4 Portrait</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">10</field>
        <field name="dpi">90</field>
    </record>

    <!-- ============================================================ -->
    <!-- QWeb PDF report action                                       -->
    <!-- ============================================================ -->
    <record id="action_report_uni_transcript_summary" model="ir.actions.report">
        <field name="name">Transcript Summary Report</field>
        <field name="model">uni.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">university_reports.report_transcript_summary_document</field>
        <field name="report_file">university_reports.report_transcript_summary_document</field>
        <field name="paperformat_id" ref="paper_format_transcript_summary"/>
        <field name="print_report_name">'TRN-SUMMARY-%s' % (fields.Date.today().strftime('%Y%m%d'))</field>
    </record>

    <!-- ============================================================ -->
    <!-- Wizard action — pre-binds the transcript summary template    -->
    <!-- ============================================================ -->
    <record id="action_report_uni_transcript_summary_wizard" model="ir.actions.act_window">
        <field name="name">Transcript Summary</field>
        <field name="res_model">uni.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{
            'default_template_id': ref('university_reports.template_transcript_summary'),
            'default_output_format': 'pdf',
        }</field>
    </record>

    <!-- ============================================================ -->
    <!-- QWeb template — transcript summary                            -->
    <!-- ============================================================ -->
    <template id="report_transcript_summary_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 class="text-center">Transcript Summary Report</h2>
                    <div class="text-center text-muted mb-3">
                        <t t-if="object.university_id">
                            <span t-field="object.university_id"/>
                        </t>
                    </div>

                    <!-- Generation metadata -->
                    <div class="row mb-3">
                        <div class="col-6">
                            <strong>Generated:</strong>
                            <span t-esc="time.strftime('%Y-%m-%d %H:%M')"/>
                        </div>
                        <div class="col-6 text-right">
                            <strong>Output:</strong>
                            <span t-esc="object.output_format"/>
                        </div>
                    </div>

                    <!-- Build the transcript domain from wizard filters -->
                    <t t-set="domain" t-value="[]"/>
                    <t t-if="object.university_id">
                        <t t-set="domain" t-value="domain + [('university_id', '=', object.university_id.id)]"/>
                    </t>
                    <t t-if="object.academic_year_id">
                        <t t-set="domain" t-value="domain + [('academic_year_from', '=', object.academic_year_id.id)]"/>
                    </t>
                    <t t-if="object.date_from">
                        <t t-set="domain" t-value="domain + [('issue_date', '&gt;=', object.date_from)]"/>
                    </t>
                    <t t-if="object.date_to">
                        <t t-set="domain" t-value="domain + [('issue_date', '&lt;=', object.date_to)]"/>
                    </t>

                    <t t-set="transcripts" t-value="object.env['ir.attachment'].browse()"/>
                    <t t-if="'uni.transcript' in object.env">
                        <t t-set="transcripts" t-value="object.env['uni.transcript'].search(domain, order='issue_date desc')"/>
                    </t>

                    <!-- Filters summary -->
                    <table class="table table-sm table-bordered mb-3">
                        <tbody>
                            <tr>
                                <th class="table-light">University</th>
                                <td><span t-field="object.university_id"/></td>
                                <th class="table-light">Academic Year</th>
                                <td><span t-field="object.academic_year_id"/></td>
                            </tr>
                            <tr>
                                <th class="table-light">Date From</th>
                                <td><span t-field="object.date_from"/></td>
                                <th class="table-light">Date To</th>
                                <td><span t-field="object.date_to"/></td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="alert alert-info">
                        <strong>Total transcripts:</strong>
                        <span t-esc="len(transcripts)"/>
                    </div>

                    <!-- Data table -->
                    <t t-if="not transcripts and 'uni.transcript' not in object.env">
                        <div class="alert alert-danger">
                            <strong>Module not installed:</strong>
                            The <code>university_gradebook</code> module is required
                            to produce this report. Please install it and try again.
                        </div>
                    </t>
                    <t t-elif="not transcripts">
                        <div class="alert alert-warning">
                            No transcripts match the selected filters.
                        </div>
                    </t>
                    <t t-else="">
                        <table class="table table-sm table-bordered">
                            <thead>
                                <tr class="active">
                                    <th>Reference</th>
                                    <th>Student</th>
                                    <th>Program</th>
                                    <th>Issue Date</th>
                                    <th class="text-center">GPA</th>
                                    <th class="text-center">Credits</th>
                                    <th class="text-center">Standing</th>
                                    <th class="text-center">State</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="transcripts" t-as="trn">
                                    <td><span t-field="trn.name"/></td>
                                    <td><span t-field="trn.student_id"/></td>
                                    <td><span t-field="trn.program_id"/></td>
                                    <td><span t-field="trn.issue_date"/></td>
                                    <td class="text-center"><span t-field="trn.cumulative_gpa"/></td>
                                    <td class="text-center">
                                        <span t-field="trn.total_credits_earned"/>
                                        /
                                        <span t-field="trn.total_credits_required"/>
                                    </td>
                                    <td class="text-center"><span t-field="trn.academic_standing"/></td>
                                    <td class="text-center"><span t-field="trn.state"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </t>

                    <!-- Footer -->
                    <div class="row mt-4">
                        <div class="col-12 text-center text-muted">
                            <small>Page <span class="page"/> of <span class="topage"/></small>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
