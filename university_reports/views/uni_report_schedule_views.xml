<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- uni.report.schedule — List View                              -->
    <!-- ============================================================ -->
    <record id="view_uni_report_schedule_list" model="ir.ui.view">
        <field name="name">uni.report.schedule.list</field>
        <field name="model">uni.report.schedule</field>
        <field name="arch" type="xml">
            <list string="Report Schedules"
                  decoration-info="state == 'draft'"
                  decoration-success="state == 'active'"
                  decoration-warning="state == 'paused'"
                  decoration-danger="state == 'cancelled'">
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="report_builder_id"/>
                <field name="frequency" widget="badge"/>
                <field name="next_run_date"/>
                <field name="last_run_date" optional="show"/>
                <field name="run_count" optional="show"/>
                <field name="is_active" widget="boolean_toggle"/>
                <field name="send_email" optional="hide" widget="boolean_toggle"/>
                <field name="save_to_file" optional="hide" widget="boolean_toggle"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'paused'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.report.schedule — Form View                              -->
    <!-- ============================================================ -->
    <record id="view_uni_report_schedule_form" model="ir.ui.view">
        <field name="name">uni.report.schedule.form</field>
        <field name="model">uni.report.schedule</field>
        <field name="arch" type="xml">
            <form string="Report Schedule">
                <header>
                    <button name="action_activate" string="Activate"
                            type="object" class="oe_highlight"
                            invisible="state not in ('draft', 'paused')"/>
                    <button name="action_pause" string="Pause"
                            type="object"
                            invisible="state != 'active'"/>
                    <button name="action_run_now" string="Run Now"
                            type="object" class="oe_highlight"
                            invisible="state == 'cancelled'"/>
                    <button name="action_cancel" string="Cancel"
                            type="object"
                            invisible="state == 'cancelled'"/>
                    <button name="action_draft" string="Set to Draft"
                            type="object"
                            invisible="state == 'active'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,paused,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Schedule"/>
                        <h1><field name="name" readonly="1"/></h1>
                        <h3><field name="code" placeholder="RSC-2025-0001"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="report_builder_id"
                                   options="{'no_create': True}"
                                   required="1"/>
                            <field name="frequency" widget="radio"/>
                            <field name="custom_cron_expression"
                                   placeholder="0 2 * * 1"
                                   invisible="frequency != 'custom'"/>
                        </group>
                        <group>
                            <field name="next_run_date"/>
                            <field name="last_run_date" readonly="1"/>
                            <field name="run_count" readonly="1"/>
                        </group>
                    </group>
                    <group string="Recipients &amp; Email">
                        <field name="recipient_ids"
                               widget="many2many_tags"
                               options="{'no_create': True}"/>
                        <field name="email_subject"
                               placeholder="Custom email subject (optional)"/>
                        <field name="email_body"
                               placeholder="Custom email body (optional)"/>
                    </group>
                    <group string="Behaviour">
                        <group>
                            <field name="is_active" widget="boolean_toggle"/>
                            <field name="send_email" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="save_to_file" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" nolabel="1" colspan="2"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.report.schedule — Search View                            -->
    <!-- ============================================================ -->
    <record id="view_uni_report_schedule_search" model="ir.ui.view">
        <field name="name">uni.report.schedule.search</field>
        <field name="model">uni.report.schedule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="report_builder_id"/>
                <separator/>
                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Active" name="filter_active"
                        domain="[('state', '=', 'active')]"/>
                <filter string="Paused" name="filter_paused"
                        domain="[('state', '=', 'paused')]"/>
                <filter string="Cancelled" name="filter_cancelled"
                        domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Due Now" name="filter_due"
                        domain="[('next_run_date', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59')),
                                ('state', '=', 'active')]"/>
                <group expand="0" string="Group By">
                    <filter string="Builder" name="group_builder"
                            context="{'group_by': 'report_builder_id'}"/>
                    <filter string="Frequency" name="group_freq"
                            context="{'group_by': 'frequency'}"/>
                    <filter string="State" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.report.schedule — Action                                 -->
    <!-- ============================================================ -->
    <record id="action_uni_report_schedule" model="ir.actions.act_window">
        <field name="name">Report Schedules</field>
        <field name="res_model">uni.report.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_report_schedule_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Schedule a recurring report
            </p>
            <p>Schedules run their associated builder automatically on a
               daily, weekly, monthly, quarterly or annual basis. Results
               are emailed to recipients and saved as files.</p>
        </field>
    </record>
</odoo>
