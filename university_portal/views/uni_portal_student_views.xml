<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- uni.portal.student — List View                                -->
    <!-- ============================================================ -->
    <record id="view_uni_portal_student_list" model="ir.ui.view">
        <field name="name">uni.portal.student.list</field>
        <field name="model">uni.portal.student</field>
        <field name="arch" type="xml">
            <list string="Student Portals"
                  decoration-success="state == 'active'"
                  decoration-warning="state == 'pending'"
                  decoration-danger="state == 'blocked'">
                <field name="name"/>
                <field name="student_id"/>
                <field name="portal_user_id"/>
                <field name="university_id"/>
                <field name="registration_date"/>
                <field name="last_login"/>
                <field name="last_ip"/>
                <field name="notification_count"/>
                <field name="access_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'pending'"
                       decoration-danger="state == 'blocked'"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.portal.student — Form View                                -->
    <!-- ============================================================ -->
    <record id="view_uni_portal_student_form" model="ir.ui.view">
        <field name="name">uni.portal.student.form</field>
        <field name="model">uni.portal.student</field>
        <field name="arch" type="xml">
            <form string="Student Portal">
                <header>
                    <button name="action_activate" string="Activate"
                            type="object" class="oe_highlight"
                            invisible="state == 'active'"/>
                    <button name="action_block" string="Block"
                            type="object"
                            invisible="state != 'active'"
                            confirm="Are you sure you want to block this student portal?"/>
                    <button name="action_reset_password" string="Reset Password"
                            type="object"
                            invisible="not portal_user_id and not user_id"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,active,blocked"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_notifications" type="object"
                                class="oe_stat_button" icon="fa-bell-o">
                            <field name="notification_count" widget="statinfo"
                                   string="Notifications"/>
                        </button>
                        <button name="action_open_notifications" type="object"
                                class="oe_stat_button" icon="fa-envelope-o">
                            <field name="unread_notification_count" widget="statinfo"
                                   string="Unread"/>
                        </button>
                        <button name="action_archive" type="object"
                                class="oe_stat_button" icon="fa-archive"
                                invisible="not active"/>
                        <button name="action_unarchive" type="object"
                                class="oe_stat_button" icon="fa-undo"
                                invisible="active"/>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Student Portal Account"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="student_id"
                                   options="{'no_create': True}"/>
                            <field name="user_id" readonly="1"/>
                            <field name="portal_user_id"
                                   options="{'no_create': True}"/>
                            <field name="university_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="registration_date" readonly="1"/>
                            <field name="last_login" readonly="1"/>
                            <field name="last_ip" readonly="1"/>
                            <field name="access_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notifications">
                            <field name="notification_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="title"/>
                                    <field name="notification_type"/>
                                    <field name="priority"/>
                                    <field name="send_date"/>
                                    <field name="is_read" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" placeholder="Internal notes about this portal account..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.portal.student — Search View                              -->
    <!-- ============================================================ -->
    <record id="view_uni_portal_student_search" model="ir.ui.view">
        <field name="name">uni.portal.student.search</field>
        <field name="model">uni.portal.student</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="student_id"/>
                <field name="portal_user_id"/>
                <field name="university_id"/>
                <field name="last_ip"/>
                <filter string="Pending" name="filter_pending"
                        domain="[('state', '=', 'pending')]"/>
                <filter string="Active" name="filter_active"
                        domain="[('state', '=', 'active')]"/>
                <filter string="Blocked" name="filter_blocked"
                        domain="[('state', '=', 'blocked')]"/>
                <group expand="0" string="Group By">
                    <filter string="University" name="group_university"
                            context="{'group_by': 'university_id'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.portal.student — Action                                   -->
    <!-- ============================================================ -->
    <record id="action_uni_portal_student" model="ir.actions.act_window">
        <field name="name">Student Portals</field>
        <field name="res_model">uni.portal.student</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_portal_student_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new student portal account
            </p>
            <p>Student portal accounts let students sign in to the
               University Portal and view their personalised dashboard.</p>
        </field>
    </record>
</odoo>
