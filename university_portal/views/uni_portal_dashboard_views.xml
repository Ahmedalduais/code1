<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- uni.portal.dashboard — List View                              -->
    <!-- ============================================================ -->
    <record id="view_uni_portal_dashboard_list" model="ir.ui.view">
        <field name="name">uni.portal.dashboard.list</field>
        <field name="model">uni.portal.dashboard</field>
        <field name="arch" type="xml">
            <list string="Portal Dashboards"
                  decoration-info="is_default == True">
                <field name="name"/>
                <field name="user_id"/>
                <field name="dashboard_type" widget="badge"/>
                <field name="student_id"/>
                <field name="faculty_id"/>
                <field name="is_default" widget="boolean_toggle"/>
                <field name="last_accessed"/>
                <field name="access_count"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.portal.dashboard — Form View                              -->
    <!-- ============================================================ -->
    <record id="view_uni_portal_dashboard_form" model="ir.ui.view">
        <field name="name">uni.portal.dashboard.form</field>
        <field name="model">uni.portal.dashboard</field>
        <field name="arch" type="xml">
            <form string="Portal Dashboard">
                <header>
                    <button name="action_reset_dashboard" string="Reset to Defaults"
                            type="object" class="oe_highlight"
                            confirm="Reset this dashboard's configuration to defaults?"/>
                    <button name="action_mark_accessed" string="Mark Accessed"
                            type="object"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_archive" type="object"
                                class="oe_stat_button" icon="fa-archive"
                                invisible="not active"/>
                        <button name="action_unarchive" type="object"
                                class="oe_stat_button" icon="fa-undo"
                                invisible="active"/>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Dashboard"/>
                        <h1><field name="name" placeholder="e.g. My Student Dashboard"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="user_id"
                                   options="{'no_create': True}"/>
                            <field name="dashboard_type"
                                   widget="badge"/>
                            <field name="is_default" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="student_id"
                                   invisible="dashboard_type != 'student'"
                                   options="{'no_create': True}"/>
                            <field name="faculty_id"
                                   invisible="dashboard_type != 'faculty'"
                                   options="{'no_create': True}"/>
                            <field name="last_accessed" readonly="1"/>
                            <field name="access_count" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Configuration (JSON)">
                            <field name="configuration"
                                   placeholder='{"widgets": [...], "theme": "default"}'/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.portal.dashboard — Search View                            -->
    <!-- ============================================================ -->
    <record id="view_uni_portal_dashboard_search" model="ir.ui.view">
        <field name="name">uni.portal.dashboard.search</field>
        <field name="model">uni.portal.dashboard</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="user_id"/>
                <field name="student_id"/>
                <field name="faculty_id"/>
                <filter string="Default" name="filter_default"
                        domain="[('is_default', '=', True)]"/>
                <filter string="Student Dashboards" name="filter_student"
                        domain="[('dashboard_type', '=', 'student')]"/>
                <filter string="Faculty Dashboards" name="filter_faculty"
                        domain="[('dashboard_type', '=', 'faculty')]"/>
                <filter string="Admin Dashboards" name="filter_admin"
                        domain="[('dashboard_type', '=', 'admin')]"/>
                <group expand="0" string="Group By">
                    <filter string="User" name="group_user"
                            context="{'group_by': 'user_id'}"/>
                    <filter string="Dashboard Type" name="group_type"
                            context="{'group_by': 'dashboard_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.portal.dashboard — Action                                 -->
    <!-- ============================================================ -->
    <record id="action_uni_portal_dashboard" model="ir.actions.act_window">
        <field name="name">Portal Dashboards</field>
        <field name="res_model">uni.portal.dashboard</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_portal_dashboard_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new portal dashboard
            </p>
            <p>Portal dashboards store the per-user layout and widget
               configuration used on the public University Portal pages.</p>
        </field>
    </record>
</odoo>
