<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===== Opportunity: List View ===== -->
    <record id="view_uni_internship_opportunity_list" model="ir.ui.view">
        <field name="name">uni.internship.opportunity.list</field>
        <field name="model">uni.internship.opportunity</field>
        <field name="arch" type="xml">
            <list string="Internship Opportunities"
                  decoration-success="status == 'completed'"
                  decoration-info="status == 'ongoing'"
                  decoration-muted="status == 'cancelled'"
                  decoration-warning="status == 'open'">
                <field name="name"/>
                <field name="title"/>
                <field name="entity_id"/>
                <field name="department_id" optional="show"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="duration_weeks" optional="hide"/>
                <field name="max_students"/>
                <field name="current_applications"/>
                <field name="accepted_count"/>
                <field name="is_paid" optional="hide"/>
                <field name="is_remote" optional="hide" widget="boolean_toggle"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'completed'"
                       decoration-info="status == 'ongoing'"
                       decoration-danger="status == 'cancelled'"
                       decoration-warning="status == 'open'"/>
            </list>
        </field>
    </record>

    <!-- ===== Opportunity: Kanban View ===== -->
    <record id="view_uni_internship_opportunity_kanban" model="ir.ui.view">
        <field name="name">uni.internship.opportunity.kanban</field>
        <field name="model">uni.internship.opportunity</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column"
                    sample="1">
                <field name="status"/>
                <field name="title"/>
                <field name="entity_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="max_students"/>
                <field name="accepted_count"/>
                <field name="is_paid"/>
                <field name="is_remote"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="title"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle text-muted">
                                        <field name="name"/>
                                    </div>
                                </div>
                                <div>
                                    <field name="status" widget="label_selection"
                                           options="{'classes': {'draft': 'secondary', 'open': 'warning', 'closed': 'secondary', 'ongoing': 'info', 'completed': 'success', 'cancelled': 'danger'}}"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>
                                    <i class="fa fa-building-o" title="Entity"/>
                                    <field name="entity_id"/>
                                </div>
                                <div>
                                    <i class="fa fa-calendar" title="Period"/>
                                    <field name="start_date"/> – <field name="end_date"/>
                                </div>
                                <div>
                                    <i class="fa fa-users" title="Capacity"/>
                                    <field name="accepted_count"/>/<field name="max_students"/>
                                    <span t-if="record.is_paid.raw_value">
                                        <i class="fa fa-money ms-2" title="Paid"/>
                                    </span>
                                    <span t-if="record.is_remote.raw_value">
                                        <i class="fa fa-globe ms-1" title="Remote"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ===== Opportunity: Form View ===== -->
    <record id="view_uni_internship_opportunity_form" model="ir.ui.view">
        <field name="name">uni.internship.opportunity.form</field>
        <field name="model">uni.internship.opportunity</field>
        <field name="arch" type="xml">
            <form string="Internship Opportunity">
                <header>
                    <button name="action_open" type="object" string="Open"
                            class="oe_highlight"
                            invisible="status != 'draft'"/>
                    <button name="action_close" type="object" string="Close Applications"
                            invisible="status != 'open'"/>
                    <button name="action_ongoing" type="object" string="Start (Ongoing)"
                            invisible="status not in ('open', 'closed')"/>
                    <button name="action_complete" type="object" string="Complete"
                            invisible="status != 'ongoing'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="status in ('completed', 'cancelled')"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            invisible="status == 'draft'"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,open,closed,ongoing,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object"
                                class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button"
                                   string="Active"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="title" string="Opportunity Title"/>
                        <h1><field name="title" placeholder="e.g. Software Engineering Intern"/></h1>
                        <h3><field name="name" readonly="1"/></h3>
                    </div>
                    <group>
                        <group string="Organization">
                            <field name="entity_id"/>
                            <field name="university_id"/>
                            <field name="college_id"/>
                            <field name="department_id"/>
                            <field name="program_id"/>
                        </group>
                        <group string="Schedule">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="duration_weeks"/>
                            <field name="application_deadline"/>
                            <field name="hours_required"/>
                            <field name="hours_per_week"/>
                        </group>
                    </group>
                    <group>
                        <group string="Capacity">
                            <field name="max_students"/>
                            <field name="min_students"/>
                            <field name="current_applications"/>
                            <field name="accepted_count"/>
                        </group>
                        <group string="Compensation &amp; Location">
                            <field name="is_paid"/>
                            <field name="monthly_stipend"
                                   invisible="not is_paid"/>
                            <field name="currency_id"
                                   invisible="not is_paid"/>
                            <field name="is_remote"/>
                            <field name="location"
                                   invisible="is_remote"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Describe the internship..."/>
                        </page>
                        <page string="Requirements" name="requirements">
                            <field name="requirements"
                                   placeholder="List the requirements (e.g. enrolled in level 3+, GPA 3.0+)"/>
                        </page>
                        <page string="Responsibilities" name="responsibilities">
                            <field name="responsibilities"
                                   placeholder="List the responsibilities and tasks"/>
                        </page>
                        <page string="Learning Outcomes" name="outcomes">
                            <field name="learning_outcomes"
                                   placeholder="What will the student learn?"/>
                        </page>
                        <page string="Required Skills" name="skills">
                            <field name="skill_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="level"/>
                                    <field name="is_mandatory"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ===== Opportunity: Search View ===== -->
    <record id="view_uni_internship_opportunity_search" model="ir.ui.view">
        <field name="name">uni.internship.opportunity.search</field>
        <field name="model">uni.internship.opportunity</field>
        <field name="arch" type="xml">
            <search string="Internship Opportunities">
                <field name="name"/>
                <field name="title"/>
                <field name="entity_id"/>
                <field name="university_id"/>
                <field name="college_id"/>
                <field name="department_id"/>
                <field name="program_id"/>
                <separator/>
                <filter name="filter_open" string="Open"
                        domain="[('status', '=', 'open')]"/>
                <filter name="filter_ongoing" string="Ongoing"
                        domain="[('status', '=', 'ongoing')]"/>
                <filter name="filter_completed" string="Completed"
                        domain="[('status', '=', 'completed')]"/>
                <separator/>
                <filter name="filter_paid" string="Paid"
                        domain="[('is_paid', '=', True)]"/>
                <filter name="filter_remote" string="Remote"
                        domain="[('is_remote', '=', True)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_status" string="Status"
                            context="{'group_by': 'status'}"/>
                    <filter name="group_entity" string="Training Entity"
                            context="{'group_by': 'entity_id'}"/>
                    <filter name="group_department" string="Department"
                            context="{'group_by': 'department_id'}"/>
                    <filter name="group_university" string="University"
                            context="{'group_by': 'university_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ===== Opportunity: Action ===== -->
    <record id="action_uni_internship_opportunity" model="ir.actions.act_window">
        <field name="name">Internship Opportunities</field>
        <field name="res_model">uni.internship.opportunity</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_uni_internship_opportunity_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new internship opportunity
            </p>
            <p>
                Publish internship opportunities offered by approved training
                entities. Students will submit applications against these
                opportunities.
            </p>
        </field>
    </record>
</odoo>
