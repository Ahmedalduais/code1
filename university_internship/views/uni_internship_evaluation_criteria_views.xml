<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_uni_internship_evaluation_criteria_list" model="ir.ui.view">
        <field name="name">uni.internship.evaluation.criteria.list</field>
        <field name="model">uni.internship.evaluation.criteria</field>
        <field name="arch" type="xml">
            <list string="Evaluation Criteria">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category"/>
                <field name="max_score"/>
                <field name="weight"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_uni_internship_evaluation_criteria_form" model="ir.ui.view">
        <field name="name">uni.internship.evaluation.criteria.form</field>
        <field name="model">uni.internship.evaluation.criteria</field>
        <field name="arch" type="xml">
            <form string="Evaluation Criteria">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Technical Skills, Punctuality..."/></h1>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="code"/>
                            <field name="category"/>
                            <field name="sequence"/>
                        </group>
                        <group string="Scoring">
                            <field name="max_score"/>
                            <field name="weight"/>
                            <field name="is_active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" placeholder="Describe what this criteria measures..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_uni_internship_evaluation_criteria_search" model="ir.ui.view">
        <field name="name">uni.internship.evaluation.criteria.search</field>
        <field name="model">uni.internship.evaluation.criteria</field>
        <field name="arch" type="xml">
            <search string="Search Evaluation Criteria">
                <field name="name"/>
                <field name="code"/>
                <separator/>
                <filter name="filter_active" string="Active"
                        domain="[('is_active', '=', True)]"/>
                <filter name="filter_inactive" string="Inactive"
                        domain="[('is_active', '=', False)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_category" string="Category"
                            context="{'group_by': 'category'}"/>
                    <filter name="group_active" string="Active"
                            context="{'group_by': 'is_active'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_uni_internship_evaluation_criteria" model="ir.actions.act_window">
        <field name="name">Evaluation Criteria</field>
        <field name="res_model">uni.internship.evaluation.criteria</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_internship_evaluation_criteria_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new evaluation criterion
            </p>
            <p>
                Define reusable criteria (with weight and max score) used to
                evaluate internships. Categories include performance, behavior,
                skills and deliverables.
            </p>
        </field>
    </record>
</odoo>
