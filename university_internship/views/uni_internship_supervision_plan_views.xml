<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ uni.internship.supervision.plan — List View ============ -->
    <record id="view_uni_internship_supervision_plan_list" model="ir.ui.view">
        <field name="name">uni.internship.supervision.plan.list</field>
        <field name="model">uni.internship.supervision.plan</field>
        <field name="arch" type="xml">
            <list string="Supervision Plans"
                  decoration-success="status=='active'"
                  decoration-info="status=='completed'"
                  decoration-danger="status=='cancelled'"
                  decoration-muted="status=='draft'">
                <field name="name"/>
                <field name="internship_id"/>
                <field name="supervisor_id" optional="show"/>
                <field name="faculty_id" optional="show"/>
                <field name="meeting_frequency" optional="show"/>
                <field name="start_date" optional="show"/>
                <field name="end_date" optional="hide"/>
                <field name="status" widget="badge"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============ uni.internship.supervision.plan — Form View ============ -->
    <record id="view_uni_internship_supervision_plan_form" model="ir.ui.view">
        <field name="name">uni.internship.supervision.plan.form</field>
        <field name="model">uni.internship.supervision.plan</field>
        <field name="arch" type="xml">
            <form string="Supervision Plan">
                <header>
                    <button name="action_activate" type="object"
                            string="Activate" class="btn-primary"
                            invisible="status != 'draft'"/>
                    <button name="action_complete" type="object"
                            string="Complete" class="btn-success"
                            invisible="status != 'active'"/>
                    <button name="action_cancel" type="object"
                            string="Cancel" class="btn-danger"
                            invisible="status in ('cancelled', 'completed')"/>
                    <button name="action_draft" type="object"
                            string="Reset to Draft" class="btn-secondary"
                            invisible="status not in ('active', 'cancelled', 'completed')"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,active,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Reference"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Assignment">
                            <field name="internship_id" options="{'no_create': True}"/>
                            <field name="supervisor_id" options="{'no_create': True}"/>
                            <field name="faculty_id" options="{'no_create': True}"/>
                        </group>
                        <group string="Schedule">
                            <field name="meeting_frequency"/>
                            <field name="meeting_schedule"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="status"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Plan Content" name="content">
                            <group>
                                <field name="objectives"/>
                                <field name="expected_outcomes"/>
                                <field name="assessment_methodology"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============ uni.internship.supervision.plan — Search View ============ -->
    <record id="view_uni_internship_supervision_plan_search" model="ir.ui.view">
        <field name="name">uni.internship.supervision.plan.search</field>
        <field name="model">uni.internship.supervision.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="internship_id"/>
                <field name="supervisor_id"/>
                <field name="faculty_id"/>
                <field name="meeting_frequency"/>
                <separator/>
                <filter string="Draft" name="filter_draft"
                        domain="[('status', '=', 'draft')]"/>
                <filter string="Active" name="filter_active"
                        domain="[('status', '=', 'active')]"/>
                <filter string="Completed" name="filter_completed"
                        domain="[('status', '=', 'completed')]"/>
                <filter string="Cancelled" name="filter_cancelled"
                        domain="[('status', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Archived" name="filter_archived"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Internship" name="group_internship"
                            context="{'group_by': 'internship_id'}"/>
                    <filter string="Supervisor" name="group_supervisor"
                            context="{'group_by': 'supervisor_id'}"/>
                    <filter string="Faculty" name="group_faculty"
                            context="{'group_by': 'faculty_id'}"/>
                    <filter string="Meeting Frequency" name="group_freq"
                            context="{'group_by': 'meeting_frequency'}"/>
                    <filter string="Status" name="group_status"
                            context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============ uni.internship.supervision.plan — Action ============ -->
    <record id="action_uni_internship_supervision_plan" model="ir.actions.act_window">
        <field name="name">Supervision Plans</field>
        <field name="res_model">uni.internship.supervision.plan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_internship_supervision_plan_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first supervision plan
            </p>
            <p>
                Supervision plans define the meeting schedule, objectives,
                expected outcomes, and assessment methodology used by the
                assigned supervisor(s) for an internship.
            </p>
        </field>
    </record>
</odoo>
