<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Default Evaluation Criteria -->
    <record id="eval_criteria_attendance" model="uni.internship.evaluation.criteria">
        <field name="name">Attendance</field>
        <field name="code">ATT</field>
        <field name="description">Commitment to attendance and punctuality</field>
        <field name="max_score">10</field>
        <field name="weight">10</field>
        <field name="sequence">10</field>
        <field name="is_active">True</field>
    </record>

    <record id="eval_criteria_punctuality" model="uni.internship.evaluation.criteria">
        <field name="name">Punctuality</field>
        <field name="code">PCT</field>
        <field name="description">Adherence to schedules and deadlines</field>
        <field name="max_score">5</field>
        <field name="weight">5</field>
        <field name="sequence">20</field>
        <field name="is_active">True</field>
    </record>

    <record id="eval_criteria_quality" model="uni.internship.evaluation.criteria">
        <field name="name">Quality of Work</field>
        <field name="code">QOW</field>
        <field name="description">Quality and accuracy of completed work</field>
        <field name="max_score">20</field>
        <field name="weight">20</field>
        <field name="sequence">30</field>
        <field name="is_active">True</field>
    </record>

    <record id="eval_criteria_initiative" model="uni.internship.evaluation.criteria">
        <field name="name">Initiative</field>
        <field name="code">INI</field>
        <field name="description">Initiative and independence in work</field>
        <field name="max_score">10</field>
        <field name="weight">10</field>
        <field name="sequence">40</field>
        <field name="is_active">True</field>
    </record>

    <record id="eval_criteria_teamwork" model="uni.internship.evaluation.criteria">
        <field name="name">Teamwork</field>
        <field name="code">TMW</field>
        <field name="description">Team collaboration and cooperation</field>
        <field name="max_score">10</field>
        <field name="weight">10</field>
        <field name="sequence">50</field>
        <field name="is_active">True</field>
    </record>

    <record id="eval_criteria_communication" model="uni.internship.evaluation.criteria">
        <field name="name">Communication</field>
        <field name="code">COM</field>
        <field name="description">Communication skills (written and verbal)</field>
        <field name="max_score">10</field>
        <field name="weight">10</field>
        <field name="sequence">60</field>
        <field name="is_active">True</field>
    </record>

    <record id="eval_criteria_technical" model="uni.internship.evaluation.criteria">
        <field name="name">Technical Skills</field>
        <field name="code">TCH</field>
        <field name="description">Application of technical knowledge and skills</field>
        <field name="max_score">15</field>
        <field name="weight">15</field>
        <field name="sequence">70</field>
        <field name="is_active">True</field>
    </record>

    <record id="eval_criteria_problem_solving" model="uni.internship.evaluation.criteria">
        <field name="name">Problem Solving</field>
        <field name="code">PSV</field>
        <field name="description">Problem identification and solution capabilities</field>
        <field name="max_score">10</field>
        <field name="weight">10</field>
        <field name="sequence">80</field>
        <field name="is_active">True</field>
    </record>

    <record id="eval_criteria_professionalism" model="uni.internship.evaluation.criteria">
        <field name="name">Professionalism</field>
        <field name="code">PRO</field>
        <field name="description">Professional conduct and ethics</field>
        <field name="max_score">5</field>
        <field name="weight">5</field>
        <field name="sequence">90</field>
        <field name="is_active">True</field>
    </record>

    <record id="eval_criteria_final_report" model="uni.internship.evaluation.criteria">
        <field name="name">Final Report</field>
        <field name="code">FRR</field>
        <field name="description">Quality of the final internship report</field>
        <field name="max_score">5</field>
        <field name="weight">5</field>
        <field name="sequence">100</field>
        <field name="is_active">True</field>
    </record>
</odoo>
