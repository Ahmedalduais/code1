<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_uni_grade_conversion_list" model="ir.ui.view">
        <field name="name">uni.grade.conversion.list</field>
        <field name="model">uni.grade.conversion</field>
        <field name="arch" type="xml">
            <list string="Grade Conversions">
                <field name="name"/>
                <field name="from_system_id"/>
                <field name="to_system_id"/>
                <field name="from_grade_letter_id"/>
                <field name="to_grade_letter_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_uni_grade_conversion_form" model="ir.ui.view">
        <field name="name">uni.grade.conversion.form</field>
        <field name="model">uni.grade.conversion</field>
        <field name="arch" type="xml">
            <form string="Grade Conversion">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Source">
                            <field name="from_system_id"/>
                            <field name="from_grade_letter_id"/>
                            <field name="from_value_min"/>
                            <field name="from_value_max"/>
                        </group>
                        <group string="Target">
                            <field name="to_system_id"/>
                            <field name="to_grade_letter_id"/>
                            <field name="to_value"/>
                        </group>
                    </group>
                    <group>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_uni_grade_conversion_search" model="ir.ui.view">
        <field name="name">uni.grade.conversion.search</field>
        <field name="model">uni.grade.conversion</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="from_system_id"/>
                <field name="to_system_id"/>
                <filter string="Active" name="filter_active"
                        domain="[('active', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="From System" name="group_from"
                            context="{'group_by': 'from_system_id'}"/>
                    <filter string="To System" name="group_to"
                            context="{'group_by': 'to_system_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_uni_grade_conversion" model="ir.actions.act_window">
        <field name="name">Grade Conversions</field>
        <field name="res_model">uni.grade.conversion</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_grade_conversion_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>
</odoo>
