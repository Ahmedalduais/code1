<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- uni.transport.vehicle — List View                             -->
    <!-- ============================================================ -->
    <record id="view_uni_transport_vehicle_list" model="ir.ui.view">
        <field name="name">uni.transport.vehicle.list</field>
        <field name="model">uni.transport.vehicle</field>
        <field name="arch" type="xml">
            <list string="Vehicles"
                  decoration-success="state == 'available'"
                  decoration-info="state == 'in_use'"
                  decoration-warning="state == 'maintenance'"
                  decoration-muted="state == 'retired'">
                <field name="name"/>
                <field name="code"/>
                <field name="plate_number"/>
                <field name="university_id"/>
                <field name="branch_id"/>
                <field name="vehicle_type"/>
                <field name="brand"/>
                <field name="model"/>
                <field name="year"/>
                <field name="capacity"/>
                <field name="fuel_type"/>
                <field name="driver_id"/>
                <field name="insurance_expiry"/>
                <field name="registration_expiry"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'available'"
                       decoration-info="state == 'in_use'"
                       decoration-warning="state == 'maintenance'"
                       decoration-muted="state == 'retired'"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.transport.vehicle — Form View                             -->
    <!-- ============================================================ -->
    <record id="view_uni_transport_vehicle_form" model="ir.ui.view">
        <field name="name">uni.transport.vehicle.form</field>
        <field name="model">uni.transport.vehicle</field>
        <field name="arch" type="xml">
            <form string="Vehicle">
                <header>
                    <button name="action_assign" type="object"
                            string="Set In Use" class="oe_highlight"
                            invisible="state != 'available'"/>
                    <button name="action_available" type="object"
                            string="Set Available" class="oe_highlight"
                            invisible="state not in ('in_use', 'maintenance')"/>
                    <button name="action_maintenance" type="object"
                            string="Send to Maintenance"
                            invisible="state in ('maintenance', 'retired')"/>
                    <button name="action_retire" type="object"
                            string="Retire"
                            invisible="state == 'retired'"
                            confirm="Are you sure you want to retire this vehicle? This action is hard to reverse."/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="available,in_use,maintenance,retired"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_routes" type="object"
                                class="oe_stat_button" icon="fa-road"
                                invisible="route_count == 0">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="route_count"/></span>
                                <span class="o_stat_text">Routes</span>
                            </div>
                        </button>
                    </div>
                    <field name="photo"
                           widget="image"
                           class="oe_avatar"
                           options="{'preview_image': 'photo'}"/>
                    <div class="oe_title">
                        <label for="name" string="Vehicle Name"/>
                        <h1><field name="name" placeholder="e.g. Bus A — North Route"/></h1>
                        <h3><field name="code" placeholder="e.g. VEH-001"/></h3>
                    </div>
                    <group>
                        <group string="Affiliation">
                            <field name="university_id"
                                   options="{'no_create': True}"/>
                            <field name="branch_id"
                                   options="{'no_create': True}"
                                   domain="[('university_id', '=', university_id)]"/>
                            <field name="plate_number"/>
                            <field name="driver_id"
                                   options="{'no_create': True}"/>
                        </group>
                        <group string="Characteristics">
                            <field name="vehicle_type"/>
                            <field name="brand"/>
                            <field name="model"/>
                            <field name="year"/>
                            <field name="color"/>
                            <field name="vin"/>
                            <field name="capacity"/>
                        </group>
                    </group>
                    <group>
                        <group string="Fuel &amp; Mileage">
                            <field name="fuel_type"/>
                            <field name="fuel_consumption"/>
                            <field name="mileage"/>
                        </group>
                        <group string="Purchase &amp; Compliance">
                            <field name="purchase_date"/>
                            <field name="purchase_price"
                                   widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="currency_id"
                                   options="{'no_create': True}"/>
                            <field name="insurance_expiry"/>
                            <field name="registration_expiry"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Routes" name="routes">
                            <field name="route_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="start_point"/>
                                    <field name="end_point"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1"
                                   placeholder="Internal notes about this vehicle..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.transport.vehicle — Search View                           -->
    <!-- ============================================================ -->
    <record id="view_uni_transport_vehicle_search" model="ir.ui.view">
        <field name="name">uni.transport.vehicle.search</field>
        <field name="model">uni.transport.vehicle</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="plate_number"/>
                <field name="vin"/>
                <field name="university_id"/>
                <field name="branch_id"/>
                <field name="driver_id"/>
                <filter string="Available" name="filter_available"
                        domain="[('state', '=', 'available')]"/>
                <filter string="In Use" name="filter_in_use"
                        domain="[('state', '=', 'in_use')]"/>
                <filter string="Maintenance" name="filter_maintenance"
                        domain="[('state', '=', 'maintenance')]"/>
                <filter string="Retired" name="filter_retired"
                        domain="[('state', '=', 'retired')]"/>
                <separator/>
                <filter string="Insurance Expiring (30 days)"
                        name="filter_insurance_soon"
                        domain="[('insurance_expiry', '!=', False),
                                 ('insurance_expiry', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d')),
                                 ('insurance_expiry', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Registration Expiring (30 days)"
                        name="filter_registration_soon"
                        domain="[('registration_expiry', '!=', False),
                                 ('registration_expiry', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d')),
                                 ('registration_expiry', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="University" name="group_university"
                            context="{'group_by': 'university_id'}"/>
                    <filter string="Branch" name="group_branch"
                            context="{'group_by': 'branch_id'}"/>
                    <filter string="Type" name="group_type"
                            context="{'group_by': 'vehicle_type'}"/>
                    <filter string="Fuel" name="group_fuel"
                            context="{'group_by': 'fuel_type'}"/>
                    <filter string="State" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Driver" name="group_driver"
                            context="{'group_by': 'driver_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.transport.vehicle — Action                                -->
    <!-- ============================================================ -->
    <record id="action_uni_transport_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">uni.transport.vehicle</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_transport_vehicle_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new transport vehicle
            </p>
            <p>Vehicles carry students along transport routes. Track
               their capacity, fuel, mileage, insurance, registration,
               and lifecycle state.</p>
        </field>
    </record>
</odoo>
