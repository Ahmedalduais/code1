<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- uni.housing.maintenance — List View                           -->
    <!-- ============================================================ -->
    <record id="view_uni_housing_maintenance_list" model="ir.ui.view">
        <field name="name">uni.housing.maintenance.list</field>
        <field name="model">uni.housing.maintenance</field>
        <field name="arch" type="xml">
            <list string="Maintenance Requests"
                  decoration-info="state == 'new'"
                  decoration-success="state == 'completed'"
                  decoration-warning="state in ('assigned', 'scheduled', 'in_progress')"
                  decoration-danger="state == 'cancelled' or priority == 'urgent'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="code" optional="hide"/>
                <field name="building_id"/>
                <field name="room_id" optional="hide"/>
                <field name="maintenance_type"/>
                <field name="priority" optional="show"/>
                <field name="reported_by" optional="hide"/>
                <field name="reported_date"/>
                <field name="assigned_to" optional="show"/>
                <field name="scheduled_date" optional="hide"/>
                <field name="completed_date" optional="hide"/>
                <field name="cost" widget="monetary"
                       options="{'currency_field': 'currency_id'}"
                       sum="Total Cost"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'new'"
                       decoration-warning="state in ('assigned', 'scheduled', 'in_progress')"
                       decoration-success="state == 'completed'"
                       decoration-muted="state == 'cancelled'"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.housing.maintenance — Kanban View                         -->
    <!-- ============================================================ -->
    <record id="view_uni_housing_maintenance_kanban" model="ir.ui.view">
        <field name="name">uni.housing.maintenance.kanban</field>
        <field name="model">uni.housing.maintenance</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="state"/>
                <field name="name"/>
                <field name="building_id"/>
                <field name="room_id"/>
                <field name="maintenance_type"/>
                <field name="priority"/>
                <field name="assigned_to"/>
                <field name="reported_date"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div>
                                    <field name="building_id"/>
                                </div>
                                <div>
                                    <field name="room_id"/>
                                </div>
                                <div>
                                    <field name="maintenance_type"/>
                                </div>
                                <div>
                                    <field name="priority" widget="badge"
                                           decoration-success="priority == 'low'"
                                           decoration-info="priority == 'normal'"
                                           decoration-warning="priority == 'high'"
                                           decoration-danger="priority == 'urgent'"/>
                                </div>
                                <div>
                                    <field name="assigned_to"/>
                                </div>
                                <div>
                                    <span>Reported: <field name="reported_date"/></span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.housing.maintenance — Form View                           -->
    <!-- ============================================================ -->
    <record id="view_uni_housing_maintenance_form" model="ir.ui.view">
        <field name="name">uni.housing.maintenance.form</field>
        <field name="model">uni.housing.maintenance</field>
        <field name="arch" type="xml">
            <form string="Maintenance Request">
                <header>
                    <button name="action_assign" type="object"
                            string="Assign" class="oe_highlight"
                            invisible="state != 'new'"/>
                    <button name="action_schedule" type="object"
                            string="Schedule"
                            invisible="state not in ('new', 'assigned')"/>
                    <button name="action_start" type="object"
                            string="Start Work" class="oe_highlight"
                            invisible="state not in ('assigned', 'scheduled')"/>
                    <button name="action_complete" type="object"
                            string="Complete"
                            invisible="state != 'in_progress'"/>
                    <button name="action_cancel" type="object"
                            string="Cancel"
                            invisible="state == 'completed' or state == 'cancelled'"/>
                    <button name="action_draft" type="object"
                            string="Reset to New"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="new,assigned,scheduled,in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_archive" type="object"
                                class="oe_stat_button" icon="fa-archive"
                                invisible="active == False">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Unarchive</span>
                            </div>
                        </button>
                        <button name="action_unarchive" type="object"
                                class="oe_stat_button" icon="fa-archive"
                                invisible="active == True">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Restore</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Maintenance Reference"/>
                        <h1><field name="name" readonly="1"/></h1>
                        <h3><field name="code" placeholder="Optional code"/></h3>
                    </div>
                    <group>
                        <group string="Location">
                            <field name="building_id"
                                   options="{'no_create': True}"/>
                            <field name="room_id"
                                   options="{'no_create': True}"
                                   domain="[('building_id', '=', building_id)]"/>
                        </group>
                        <group string="Classification">
                            <field name="maintenance_type"/>
                            <field name="priority"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <group>
                        <group string="Reporting">
                            <field name="reported_by"
                                   options="{'no_create': True}"/>
                            <field name="reported_date"/>
                        </group>
                        <group string="Assignment &amp; Scheduling">
                            <field name="assigned_to"
                                   options="{'no_create': True}"/>
                            <field name="scheduled_date"/>
                            <field name="started_date"/>
                            <field name="completed_date"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"
                               placeholder="Detailed description of the issue reported..."/>
                    </group>
                    <notebook>
                        <page string="Work" name="work">
                            <group>
                                <group>
                                    <field name="cost"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="currency_id"
                                           options="{'no_create': True}"/>
                                </group>
                                <group>
                                    <field name="parts_used"/>
                                    <field name="work_description"/>
                                </group>
                            </group>
                        </page>
                        <page string="Feedback" name="feedback">
                            <group>
                                <field name="rating"
                                       widget="priority"/>
                                <field name="feedback" nolabel="1"
                                       placeholder="Optional feedback about the maintenance service..."/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <group>
                                <field name="notes" nolabel="1"
                                       placeholder="Internal notes about this request..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.housing.maintenance — Search View                         -->
    <!-- ============================================================ -->
    <record id="view_uni_housing_maintenance_search" model="ir.ui.view">
        <field name="name">uni.housing.maintenance.search</field>
        <field name="model">uni.housing.maintenance</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="building_id"/>
                <field name="room_id"/>
                <field name="reported_by"/>
                <field name="assigned_to"/>
                <filter string="New" name="filter_new"
                        domain="[('state', '=', 'new')]"/>
                <filter string="Assigned" name="filter_assigned"
                        domain="[('state', '=', 'assigned')]"/>
                <filter string="Scheduled" name="filter_scheduled"
                        domain="[('state', '=', 'scheduled')]"/>
                <filter string="In Progress" name="filter_in_progress"
                        domain="[('state', '=', 'in_progress')]"/>
                <filter string="Completed" name="filter_completed"
                        domain="[('state', '=', 'completed')]"/>
                <filter string="Cancelled" name="filter_cancelled"
                        domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Urgent" name="filter_urgent"
                        domain="[('priority', '=', 'urgent')]"/>
                <filter string="High Priority" name="filter_high"
                        domain="[('priority', 'in', ('high', 'urgent'))]"/>
                <filter string="Open Requests" name="filter_open"
                        domain="[('state', 'not in', ('completed', 'cancelled'))]"/>
                <filter string="Reported Today" name="filter_today"
                        domain="[('reported_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter string="Archived" name="filter_archived"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Building" name="group_building"
                            context="{'group_by': 'building_id'}"/>
                    <filter string="Room" name="group_room"
                            context="{'group_by': 'room_id'}"/>
                    <filter string="Maintenance Type" name="group_type"
                            context="{'group_by': 'maintenance_type'}"/>
                    <filter string="Priority" name="group_priority"
                            context="{'group_by': 'priority'}"/>
                    <filter string="Assigned To" name="group_assigned"
                            context="{'group_by': 'assigned_to'}"/>
                    <filter string="State" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Reported Date" name="group_reported"
                            context="{'group_by': 'reported_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.housing.maintenance — Action                              -->
    <!-- ============================================================ -->
    <record id="action_uni_housing_maintenance" model="ir.actions.act_window">
        <field name="name">Maintenance Requests</field>
        <field name="res_model">uni.housing.maintenance</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_uni_housing_maintenance_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new maintenance request
            </p>
            <p>Maintenance requests track issues reported for housing
               buildings and rooms. Manage assignment, scheduling, work
               progress, cost, and satisfaction rating in one place.</p>
        </field>
    </record>
</odoo>
