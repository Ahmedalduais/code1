<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- uni.housing.building — List View                              -->
    <!-- ============================================================ -->
    <record id="view_uni_housing_building_list" model="ir.ui.view">
        <field name="name">uni.housing.building.list</field>
        <field name="model">uni.housing.building</field>
        <field name="arch" type="xml">
            <list string="Buildings"
                  decoration-success="state == 'available'"
                  decoration-warning="state == 'maintenance'"
                  decoration-danger="state == 'closed'">
                <field name="code"/>
                <field name="name"/>
                <field name="university_id" optional="show"/>
                <field name="branch_id" optional="hide"/>
                <field name="building_type"/>
                <field name="floors" optional="hide"/>
                <field name="total_rooms"/>
                <field name="room_count"/>
                <field name="occupied_count"/>
                <field name="supervisor_id" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'available'"
                       decoration-warning="state == 'maintenance'"
                       decoration-danger="state == 'closed'"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.housing.building — Kanban View (grouped by state)         -->
    <!-- ============================================================ -->
    <record id="view_uni_housing_building_kanban" model="ir.ui.view">
        <field name="name">uni.housing.building.kanban</field>
        <field name="model">uni.housing.building</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="state"/>
                <field name="code"/>
                <field name="name"/>
                <field name="building_type"/>
                <field name="university_id"/>
                <field name="room_count"/>
                <field name="occupied_count"/>
                <field name="photo"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image(record, 'photo', record.id.raw_value)"
                                     alt="Building" class="o_image_64_contain"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div>
                                    <field name="code"/>
                                </div>
                                <div>
                                    <field name="building_type"/>
                                </div>
                                <div>
                                    <field name="university_id"/>
                                </div>
                                <div>
                                    <span><field name="occupied_count"/> / <field name="room_count"/> rooms occupied</span>
                                </div>
                                <div>
                                    <field name="state" widget="label"
                                           decoration-success="state == 'available'"
                                           decoration-warning="state == 'maintenance'"
                                           decoration-danger="state == 'closed'"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.housing.building — Form View                              -->
    <!-- ============================================================ -->
    <record id="view_uni_housing_building_form" model="ir.ui.view">
        <field name="name">uni.housing.building.form</field>
        <field name="model">uni.housing.building</field>
        <field name="arch" type="xml">
            <form string="Building">
                <header>
                    <button name="action_maintenance" type="object"
                            string="Put Under Maintenance"
                            invisible="state != 'available'"/>
                    <button name="action_close" type="object"
                            string="Close Building"
                            invisible="state == 'closed'"/>
                    <button name="action_available" type="object"
                            string="Mark Available" class="oe_highlight"
                            invisible="state == 'available'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="available,maintenance,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_rooms" type="object"
                                class="oe_stat_button" icon="fa-bed">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="room_count"/></span>
                                <span class="o_stat_text">Rooms</span>
                            </div>
                        </button>
                        <button name="action_open_rooms" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="occupied_count"/></span>
                                <span class="o_stat_text">Occupied</span>
                            </div>
                        </button>
                        <button name="action_archive" type="object"
                                class="oe_stat_button" icon="fa-archive"
                                invisible="active == False">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Unarchive</span>
                            </div>
                        </button>
                        <button name="action_unarchive" type="object"
                                class="oe_stat_button" icon="fa-archive"
                                invisible="active == True">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Restore</span>
                            </div>
                        </button>
                    </div>
                    <field name="photo" widget="image"
                           class="oe_avatar" options="{'size': [120, 160]}"/>
                    <div class="oe_title">
                        <label for="name" string="Building Name"/>
                        <h1><field name="name"
                                   placeholder="e.g. North Campus Dormitory"/></h1>
                        <h3><field name="code"
                                   placeholder="e.g. BLD-A, DORM-1"/></h3>
                    </div>
                    <group>
                        <group string="University">
                            <field name="university_id"
                                   options="{'no_create': True}"/>
                            <field name="branch_id"
                                   options="{'no_create': True}"
                                   domain="[('university_id', '=', university_id)]"/>
                            <field name="supervisor_id"
                                   options="{'no_create': True}"/>
                        </group>
                        <group string="Type &amp; Location">
                            <field name="building_type"/>
                            <field name="address"
                                   placeholder="Street address"/>
                            <field name="city"/>
                            <field name="country_id"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group>
                        <group string="Structure">
                            <field name="floors"/>
                            <field name="total_rooms"/>
                            <field name="room_count"/>
                            <field name="occupied_count"/>
                        </group>
                        <group string="Amenities">
                            <field name="has_parking"/>
                            <field name="has_laundry"/>
                            <field name="has_gym"/>
                            <field name="has_security"/>
                            <field name="has_wifi"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <group>
                                <field name="description" nolabel="1"
                                       placeholder="Description of the building..."/>
                            </group>
                        </page>
                        <page string="Rooms" name="rooms">
                            <field name="room_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="floor"/>
                                    <field name="room_type_id"/>
                                    <field name="capacity"/>
                                    <field name="occupied_beds"/>
                                    <field name="available_beds"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'available'"
                                           decoration-danger="state == 'maintenance'"
                                           decoration-muted="state == 'closed'"
                                           decoration-warning="state == 'full'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <group>
                                <field name="notes" nolabel="1"
                                       placeholder="Internal notes about the building..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.housing.building — Search View                            -->
    <!-- ============================================================ -->
    <record id="view_uni_housing_building_search" model="ir.ui.view">
        <field name="name">uni.housing.building.search</field>
        <field name="model">uni.housing.building</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="university_id"/>
                <field name="branch_id"/>
                <field name="building_type"/>
                <field name="supervisor_id"/>
                <filter string="Available" name="filter_available"
                        domain="[('state', '=', 'available')]"/>
                <filter string="Under Maintenance" name="filter_maintenance"
                        domain="[('state', '=', 'maintenance')]"/>
                <filter string="Closed" name="filter_closed"
                        domain="[('state', '=', 'closed')]"/>
                <filter string="Has Parking" name="filter_parking"
                        domain="[('has_parking', '=', True)]"/>
                <filter string="Has Gym" name="filter_gym"
                        domain="[('has_gym', '=', True)]"/>
                <filter string="Has Security" name="filter_security"
                        domain="[('has_security', '=', True)]"/>
                <filter string="Has Wi-Fi" name="filter_wifi"
                        domain="[('has_wifi', '=', True)]"/>
                <filter string="Archived" name="filter_archived"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="University" name="group_university"
                            context="{'group_by': 'university_id'}"/>
                    <filter string="Branch" name="group_branch"
                            context="{'group_by': 'branch_id'}"/>
                    <filter string="Building Type" name="group_type"
                            context="{'group_by': 'building_type'}"/>
                    <filter string="State" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Supervisor" name="group_supervisor"
                            context="{'group_by': 'supervisor_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.housing.building — Action                                 -->
    <!-- ============================================================ -->
    <record id="action_uni_housing_building" model="ir.actions.act_window">
        <field name="name">Buildings</field>
        <field name="res_model">uni.housing.building</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_uni_housing_building_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new housing building
            </p>
            <p>Buildings are the top-level physical structures that contain
               rooms. Track their type, location, amenities, supervisor,
               and occupancy state.</p>
        </field>
    </record>
</odoo>
