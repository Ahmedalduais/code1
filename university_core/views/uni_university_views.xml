<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- University List View -->
    <record id="view_uni_university_list" model="ir.ui.view">
        <field name="name">uni.university.list</field>
        <field name="model">uni.university</field>
        <field name="arch" type="xml">
            <list string="Universities">
                <field name="code"/>
                <field name="name"/>
                <field name="established_date"/>
                <field name="branch_count"/>
                <field name="college_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- University Form View -->
    <record id="view_uni_university_form" model="ir.ui.view">
        <field name="name">uni.university.form</field>
        <field name="model">uni.university</field>
        <field name="arch" type="xml">
            <form string="University">
                <header>
                    <button name="action_archive" type="object" string="Archive"
                            class="btn-secondary" invisible="active == False"/>
                    <button name="action_unarchive" type="object" string="Unarchive"
                            class="btn-primary" invisible="active == True"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_branches" type="object"
                                class="oe_stat_button" icon="fa-building-o">
                            <field name="branch_count" widget="statinfo" string="Branches"/>
                        </button>
                        <button name="action_view_colleges" type="object"
                                class="oe_stat_button" icon="fa-graduation-cap">
                            <field name="college_count" widget="statinfo" string="Colleges"/>
                        </button>
                    </div>
                    <field name="logo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name" string="University Name"/>
                        <h1><field name="name" placeholder="e.g. King Saud University"/></h1>
                        <h3><field name="code" placeholder="e.g. KSU"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="established_date"/>
                            <field name="accreditation_no"/>
                            <field name="currency_id"/>
                        </group>
                        <group>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="website_url" widget="url"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contact Info">
                            <group>
                                <group>
                                    <field name="street" placeholder="Street..."/>
                                    <field name="street2"/>
                                    <field name="zip"/>
                                </group>
                                <group>
                                    <field name="city"/>
                                    <field name="state_id"/>
                                    <field name="country_id"/>
                                </group>
                            </group>
                        </page>
                        <page string="Branches">
                            <field name="branch_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="manager_id"/>
                                    <field name="college_count"/>
                                </list>
                            </field>
                        </page>
                        <page string="Colleges">
                            <field name="college_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="dean_id"/>
                                    <field name="department_count"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- University Search View -->
    <record id="view_uni_university_search" model="ir.ui.view">
        <field name="name">uni.university.search</field>
        <field name="model">uni.university</field>
        <field name="arch" type="xml">
            <search string="Search Universities">
                <field name="name"/>
                <field name="code"/>
                <field name="accreditation_no"/>
                <filter string="Active" name="filter_active"
                        domain="[('active', '=', True)]"/>
                <filter string="Archived" name="filter_archived"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Country" name="group_country"
                            context="{'group_by': 'country_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- University Action -->
    <record id="action_uni_university" model="ir.actions.act_window">
        <field name="name">Universities</field>
        <field name="res_model">uni.university</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_university_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first university
            </p>
        </field>
    </record>
</odoo>
