<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Program Level Views -->
    <record id="view_uni_program_level_list" model="ir.ui.view">
        <field name="name">uni.program.level.list</field>
        <field name="model">uni.program.level</field>
        <field name="arch" type="xml">
            <list string="Program Levels">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="program_count"/>
            </list>
        </field>
    </record>

    <record id="view_uni_program_level_form" model="ir.ui.view">
        <field name="name">uni.program.level.form</field>
        <field name="model">uni.program.level</field>
        <field name="arch" type="xml">
            <form string="Program Level">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Level Name"/>
                        <h1><field name="name" placeholder="e.g. Bachelor"/></h1>
                        <h3><field name="code" placeholder="e.g. BSC"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="program_count"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_uni_program_level" model="ir.actions.act_window">
        <field name="name">Program Levels</field>
        <field name="res_model">uni.program.level</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Program Views -->
    <record id="view_uni_program_list" model="ir.ui.view">
        <field name="name">uni.program.list</field>
        <field name="model">uni.program</field>
        <field name="arch" type="xml">
            <list string="Programs" decoration-success="state=='active'"
                  decoration-muted="state=='closed'"
                  decoration-warning="state=='suspended'">
                <field name="code"/>
                <field name="name"/>
                <field name="university_id"/>
                <field name="college_id"/>
                <field name="department_id"/>
                <field name="level_id"/>
                <field name="credit_hours"/>
                <field name="duration_years"/>
                <field name="coordinator_id"/>
                <field name="state" widget="badge"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_uni_program_form" model="ir.ui.view">
        <field name="name">uni.program.form</field>
        <field name="model">uni.program</field>
        <field name="arch" type="xml">
            <form string="Program">
                <header>
                    <button name="action_activate" type="object" string="Activate"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_suspend" type="object" string="Suspend"
                            class="btn-warning" invisible="state != 'active'"/>
                    <button name="action_close" type="object" string="Close"
                            class="btn-danger" invisible="state in ('draft', 'closed')"/>
                    <button name="action_draft" type="object" string="Set to Draft"
                            class="btn-secondary" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Program Name"/>
                        <h1><field name="name" placeholder="e.g. Bachelor of Computer Science"/></h1>
                        <h3><field name="code" placeholder="e.g. BCS"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="university_id"/>
                            <field name="college_id"/>
                            <field name="department_id"/>
                            <field name="branch_id"/>
                        </group>
                        <group>
                            <field name="level_id"/>
                            <field name="coordinator_id"/>
                            <field name="credit_hours"/>
                            <field name="duration_years"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_uni_program_search" model="ir.ui.view">
        <field name="name">uni.program.search</field>
        <field name="model">uni.program</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="college_id"/>
                <field name="department_id"/>
                <field name="level_id"/>
                <field name="coordinator_id"/>
                <filter string="Active" name="filter_active"
                        domain="[('active', '=', True)]"/>
                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <separator/>
                <filter string="Active Programs" name="state_active"
                        domain="[('state', '=', 'active')]"/>
                <group expand="0" string="Group By">
                    <filter string="University" name="group_university"
                            context="{'group_by': 'university_id'}"/>
                    <filter string="College" name="group_college"
                            context="{'group_by': 'college_id'}"/>
                    <filter string="Department" name="group_department"
                            context="{'group_by': 'department_id'}"/>
                    <filter string="Level" name="group_level"
                            context="{'group_by': 'level_id'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_uni_program" model="ir.actions.act_window">
        <field name="name">Programs</field>
        <field name="res_model">uni.program</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_program_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>
</odoo>
