<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_uni_academic_term_list" model="ir.ui.view">
        <field name="name">uni.academic.term.list</field>
        <field name="model">uni.academic.term</field>
        <field name="arch" type="xml">
            <list string="Academic Terms" decoration-success="is_current"
                  decoration-muted="state=='closed'">
                <field name="code"/>
                <field name="name"/>
                <field name="academic_year_id"/>
                <field name="term_type_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="is_current" widget="boolean_toggle"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_uni_academic_term_form" model="ir.ui.view">
        <field name="name">uni.academic.term.form</field>
        <field name="model">uni.academic.term</field>
        <field name="arch" type="xml">
            <form string="Academic Term">
                <header>
                    <button name="action_open_registration" type="object" string="Open Registration"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_activate" type="object" string="Activate"
                            class="btn-primary" invisible="state != 'registration'"/>
                    <button name="action_set_current" type="object" string="Set as Current"
                            class="btn-primary" invisible="state == 'closed'"/>
                    <button name="action_close" type="object" string="Close"
                            class="btn-danger" invisible="state == 'closed'"/>
                    <button name="action_draft" type="object" string="Set to Draft"
                            class="btn-secondary" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,registration,active,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Term Name"/>
                        <h1><field name="name" placeholder="e.g. Fall 2024"/></h1>
                        <h3><field name="code" placeholder="e.g. F2024"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="university_id"/>
                            <field name="academic_year_id"/>
                            <field name="term_type_id"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="is_current"/>
                        </group>
                    </group>
                    <group string="Registration Period">
                        <group>
                            <field name="registration_date_start"/>
                            <field name="registration_date_end"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_uni_academic_term_search" model="ir.ui.view">
        <field name="name">uni.academic.term.search</field>
        <field name="model">uni.academic.term</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="academic_year_id"/>
                <field name="term_type_id"/>
                <filter string="Current" name="filter_current"
                        domain="[('is_current', '=', True)]"/>
                <filter string="Active" name="filter_active"
                        domain="[('active', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Academic Year" name="group_year"
                            context="{'group_by': 'academic_year_id'}"/>
                    <filter string="Term Type" name="group_type"
                            context="{'group_by': 'term_type_id'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_uni_academic_term" model="ir.actions.act_window">
        <field name="name">Academic Terms</field>
        <field name="res_model">uni.academic.term</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_academic_term_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>
</odoo>
