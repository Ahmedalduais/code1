<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_uni_academic_year_list" model="ir.ui.view">
        <field name="name">uni.academic.year.list</field>
        <field name="model">uni.academic.year</field>
        <field name="arch" type="xml">
            <list string="Academic Years" decoration-success="is_current"
                  decoration-muted="state=='closed'">
                <field name="code"/>
                <field name="name"/>
                <field name="university_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="is_current" widget="boolean_toggle"/>
                <field name="term_count"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_uni_academic_year_form" model="ir.ui.view">
        <field name="name">uni.academic.year.form</field>
        <field name="model">uni.academic.year</field>
        <field name="arch" type="xml">
            <form string="Academic Year">
                <header>
                    <button name="action_activate" type="object" string="Activate"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_set_current" type="object" string="Set as Current"
                            class="btn-primary" invisible="state == 'closed'"/>
                    <button name="action_close" type="object" string="Close"
                            class="btn-danger" invisible="state == 'closed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_terms" type="object"
                                class="oe_stat_button" icon="fa-calendar">
                            <field name="term_count" widget="statinfo" string="Terms"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Academic Year"/>
                        <h1><field name="name" placeholder="e.g. 2024-2025"/></h1>
                        <h3><field name="code" placeholder="e.g. AY2024"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="university_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group>
                            <field name="is_current"/>
                            <field name="state"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Terms">
                            <field name="term_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="term_type_id"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="is_current"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_uni_academic_year_search" model="ir.ui.view">
        <field name="name">uni.academic.year.search</field>
        <field name="model">uni.academic.year</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="university_id"/>
                <filter string="Current" name="filter_current"
                        domain="[('is_current', '=', True)]"/>
                <filter string="Active" name="filter_active"
                        domain="[('active', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="University" name="group_university"
                            context="{'group_by': 'university_id'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_uni_academic_year" model="ir.actions.act_window">
        <field name="name">Academic Years</field>
        <field name="res_model">uni.academic.year</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_academic_year_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>
</odoo>
