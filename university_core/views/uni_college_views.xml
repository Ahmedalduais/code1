<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_uni_college_list" model="ir.ui.view">
        <field name="name">uni.college.list</field>
        <field name="model">uni.college</field>
        <field name="arch" type="xml">
            <list string="Colleges">
                <field name="code"/>
                <field name="name"/>
                <field name="university_id"/>
                <field name="branch_id"/>
                <field name="dean_id"/>
                <field name="department_count"/>
                <field name="program_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_uni_college_form" model="ir.ui.view">
        <field name="name">uni.college.form</field>
        <field name="model">uni.college</field>
        <field name="arch" type="xml">
            <form string="College">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_departments" type="object"
                                class="oe_stat_button" icon="fa-sitemap">
                            <field name="department_count" widget="statinfo" string="Departments"/>
                        </button>
                        <button name="action_view_programs" type="object"
                                class="oe_stat_button" icon="fa-graduation-cap">
                            <field name="program_count" widget="statinfo" string="Programs"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="College Name"/>
                        <h1><field name="name" placeholder="e.g. College of Engineering"/></h1>
                        <h3><field name="code" placeholder="e.g. ENG"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="university_id"/>
                            <field name="branch_id"/>
                            <field name="dean_id"/>
                            <field name="establishment_date"/>
                        </group>
                        <group>
                            <field name="phone" invisible="1"/>
                            <field name="email" invisible="1"/>
                            <field name="partner_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Departments">
                            <field name="department_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="head_id"/>
                                    <field name="program_count"/>
                                </list>
                            </field>
                        </page>
                        <page string="Programs">
                            <field name="program_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="level_id"/>
                                    <field name="coordinator_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_uni_college_search" model="ir.ui.view">
        <field name="name">uni.college.search</field>
        <field name="model">uni.college</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="university_id"/>
                <field name="branch_id"/>
                <field name="dean_id"/>
                <filter string="Active" name="filter_active"
                        domain="[('active', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="University" name="group_university"
                            context="{'group_by': 'university_id'}"/>
                    <filter string="Branch" name="group_branch"
                            context="{'group_by': 'branch_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_uni_college" model="ir.actions.act_window">
        <field name="name">Colleges</field>
        <field name="res_model">uni.college</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_college_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>
</odoo>
