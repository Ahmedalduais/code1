<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Module Category -->
    <record id="module_category_university_core" model="ir.module.category">
        <field name="name">University Management</field>
        <field name="sequence">15</field>
    </record>

    <!-- University User Group -->
    <record id="group_university_user" model="res.groups">
        <field name="name">University / User</field>
        <field name="category_id" ref="module_category_university_core"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- University Manager Group -->
    <record id="group_university_manager" model="res.groups">
        <field name="name">University / Manager</field>
        <field name="category_id" ref="module_category_university_core"/>
        <field name="implied_ids" eval="[(4, ref('group_university_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- Multi-Branch Group -->
    <record id="group_university_multi_branch" model="res.groups">
        <field name="name">University / Multi-Branch</field>
        <field name="category_id" ref="module_category_university_core"/>
        <field name="implied_ids" eval="[(4, ref('group_university_user'))]"/>
    </record>

    <!-- Record Rule: User sees records in their university -->
    <record id="rule_university_university_company" model="ir.rule">
        <field name="name">University: Multi-Company</field>
        <field name="model_id" ref="model_uni_university"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_uni_person_user" model="ir.rule">
        <field name="name">University Person: User Read Access</field>
        <field name="model_id" ref="model_uni_person"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_university_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_uni_person_manager" model="ir.rule">
        <field name="name">University Person: Manager Full Access</field>
        <field name="model_id" ref="model_uni_person"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_university_manager'))]"/>
    </record>
</odoo>
