<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- uni.accreditation.standard — List View                       -->
    <!-- ============================================================ -->
    <record id="view_uni_accreditation_standard_list" model="ir.ui.view">
        <field name="name">uni.accreditation.standard.list</field>
        <field name="model">uni.accreditation.standard</field>
        <field name="arch" type="xml">
            <list string="Accreditation Standards">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="accreditation_body_id" optional="show"/>
                <field name="parent_id" optional="hide"/>
                <field name="standard_type" widget="badge"
                       decoration-info="standard_type == 'institutional'"
                       decoration-success="standard_type == 'programmatic'"
                       decoration-warning="standard_type == 'faculty'"
                       decoration-secondary="standard_type == 'student'"
                       decoration-danger="standard_type == 'resources'"/>
                <field name="weight" optional="show"/>
                <field name="minimum_score" optional="show"/>
                <field name="is_mandatory" widget="boolean_toggle"/>
                <field name="program_standard_count" widget="statinfo"/>
                <field name="active" optional="hide" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.accreditation.standard — Form View                       -->
    <!-- ============================================================ -->
    <record id="view_uni_accreditation_standard_form" model="ir.ui.view">
        <field name="name">uni.accreditation.standard.form</field>
        <field name="model">uni.accreditation.standard</field>
        <field name="arch" type="xml">
            <form string="Accreditation Standard">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_program_assessments" type="object"
                                class="oe_stat_button" icon="fa-tasks">
                            <field name="program_standard_count" widget="statinfo"
                                   string="Assessments"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Accreditation Standard"/>
                        <h1><field name="name" placeholder="e.g. Faculty Qualifications"/></h1>
                        <h3><field name="code" placeholder="e.g. SR-5"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="accreditation_body_id"
                                   options="{'no_create': True}"
                                   required="1"/>
                            <field name="parent_id"
                                   options="{'no_create': True}"/>
                            <field name="standard_type" widget="radio"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="weight"/>
                            <field name="minimum_score"/>
                            <field name="is_mandatory" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" nolabel="1" colspan="2"/>
                        </page>
                        <page string="Child Standards">
                            <field name="child_ids"
                                   context="{'default_accreditation_body_id': accreditation_body_id, 'default_parent_id': id}">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="standard_type" optional="show"/>
                                    <field name="weight" optional="show"/>
                                    <field name="minimum_score" optional="show"/>
                                    <field name="is_mandatory" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.accreditation.standard — Search View                     -->
    <!-- ============================================================ -->
    <record id="view_uni_accreditation_standard_search" model="ir.ui.view">
        <field name="name">uni.accreditation.standard.search</field>
        <field name="model">uni.accreditation.standard</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="accreditation_body_id"/>
                <field name="parent_id"/>
                <separator/>
                <filter string="Mandatory" name="filter_mandatory"
                        domain="[('is_mandatory', '=', True)]"/>
                <filter string="Optional" name="filter_optional"
                        domain="[('is_mandatory', '=', False)]"/>
                <separator/>
                <filter string="Institutional" name="filter_institutional"
                        domain="[('standard_type', '=', 'institutional')]"/>
                <filter string="Programmatic" name="filter_programmatic"
                        domain="[('standard_type', '=', 'programmatic')]"/>
                <filter string="Faculty" name="filter_faculty"
                        domain="[('standard_type', '=', 'faculty')]"/>
                <filter string="Student" name="filter_student"
                        domain="[('standard_type', '=', 'student')]"/>
                <filter string="Resources" name="filter_resources"
                        domain="[('standard_type', '=', 'resources')]"/>
                <filter string="Governance" name="filter_governance"
                        domain="[('standard_type', '=', 'governance')]"/>
                <separator/>
                <filter string="Archived" name="filter_inactive"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Accreditation Body" name="group_body"
                            context="{'group_by': 'accreditation_body_id'}"/>
                    <filter string="Parent" name="group_parent"
                            context="{'group_by': 'parent_id'}"/>
                    <filter string="Type" name="group_type"
                            context="{'group_by': 'standard_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.accreditation.standard — Action                          -->
    <!-- ============================================================ -->
    <record id="action_uni_accreditation_standard" model="ir.actions.act_window">
        <field name="name">Accreditation Standards</field>
        <field name="res_model">uni.accreditation.standard</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_accreditation_standard_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new accreditation standard
            </p>
            <p>Standards are the criteria issued by accreditation bodies.
               They can be organized hierarchically and have weights and
               minimum scores used in the program assessment.</p>
        </field>
    </record>
</odoo>
