<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- uni.accreditation.report — List View                         -->
    <!-- ============================================================ -->
    <record id="view_uni_accreditation_report_list" model="ir.ui.view">
        <field name="name">uni.accreditation.report.list</field>
        <field name="model">uni.accreditation.report</field>
        <field name="arch" type="xml">
            <list string="Accreditation Reports"
                  decoration-info="state == 'draft'"
                  decoration-warning="state in ('submitted', 'under_review')"
                  decoration-success="state == 'accepted'"
                  decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="accreditation_program_id"/>
                <field name="program_id" optional="hide"/>
                <field name="accreditation_body_id" optional="hide"/>
                <field name="report_type" widget="badge"
                       decoration-info="report_type == 'self_study'"
                       decoration-success="report_type == 'final'"
                       decoration-warning="report_type == 'interim'"
                       decoration-secondary="report_type == 'annual'"
                       decoration-danger="report_type == 'special'"/>
                <field name="report_date"/>
                <field name="submission_date" optional="hide"/>
                <field name="accepted_date" optional="hide"/>
                <field name="prepared_by" optional="hide"/>
                <field name="reviewed_by" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state in ('submitted', 'under_review')"
                       decoration-success="state == 'accepted'"
                       decoration-danger="state == 'rejected'"/>
                <field name="active" optional="hide" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.accreditation.report — Form View                         -->
    <!-- ============================================================ -->
    <record id="view_uni_accreditation_report_form" model="ir.ui.view">
        <field name="name">uni.accreditation.report.form</field>
        <field name="model">uni.accreditation.report</field>
        <field name="arch" type="xml">
            <form string="Accreditation Report">
                <header>
                    <button name="action_submit" string="Submit"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_review" string="Start Review"
                            type="object" class="oe_highlight"
                            invisible="state != 'submitted'"/>
                    <button name="action_accept" string="Accept"
                            type="object" class="oe_highlight"
                            invisible="state != 'under_review'"/>
                    <button name="action_reject" string="Reject"
                            type="object"
                            invisible="state not in ('submitted', 'under_review')"
                            confirm="Are you sure you want to reject this report?"/>
                    <button name="action_draft" string="Reset to Draft"
                            type="object"
                            invisible="state != 'rejected'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,under_review,accepted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Accreditation Report"/>
                        <h1><field name="name" placeholder="e.g. ACR-RPT-CS-NCAAA"/></h1>
                        <h3><field name="code" placeholder="ACR-RPT-CS-annual"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="accreditation_program_id"
                                   options="{'no_create': True}"
                                   readonly="state in ('submitted', 'under_review', 'accepted')"/>
                            <field name="program_id" readonly="1"/>
                            <field name="university_id" readonly="1" optional="hide"/>
                            <field name="accreditation_body_id" readonly="1"/>
                            <field name="report_type"
                                   readonly="state in ('submitted', 'under_review', 'accepted')"/>
                        </group>
                        <group>
                            <field name="report_date"
                                   readonly="state in ('submitted', 'under_review', 'accepted')"/>
                            <field name="submission_date" readonly="1"/>
                            <field name="accepted_date" readonly="1"/>
                            <field name="prepared_by" readonly="1"/>
                            <field name="reviewed_by" readonly="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="File">
                            <field name="file" filename="filename"
                                   readonly="state in ('submitted', 'under_review', 'accepted')"/>
                            <field name="filename" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Summary">
                            <field name="summary" nolabel="1" colspan="2"
                                   readonly="state in ('submitted', 'under_review', 'accepted')"/>
                        </page>
                        <page string="Findings">
                            <field name="findings" nolabel="1" colspan="2"
                                   readonly="state in ('submitted', 'under_review', 'accepted')"/>
                        </page>
                        <page string="Recommendations">
                            <field name="recommendations" nolabel="1" colspan="2"
                                   readonly="state in ('submitted', 'under_review', 'accepted')"/>
                        </page>
                        <page string="Notes">
                            <field name="notes" nolabel="1" colspan="2"
                                   readonly="state in ('submitted', 'under_review', 'accepted')"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.accreditation.report — Search View                       -->
    <!-- ============================================================ -->
    <record id="view_uni_accreditation_report_search" model="ir.ui.view">
        <field name="name">uni.accreditation.report.search</field>
        <field name="model">uni.accreditation.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="accreditation_program_id"/>
                <field name="program_id"/>
                <field name="accreditation_body_id"/>
                <field name="prepared_by"/>
                <field name="reviewed_by"/>
                <separator/>
                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="filter_submitted"
                        domain="[('state', '=', 'submitted')]"/>
                <filter string="Under Review" name="filter_under_review"
                        domain="[('state', '=', 'under_review')]"/>
                <filter string="Accepted" name="filter_accepted"
                        domain="[('state', '=', 'accepted')]"/>
                <filter string="Rejected" name="filter_rejected"
                        domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter string="Self Study" name="filter_self_study"
                        domain="[('report_type', '=', 'self_study')]"/>
                <filter string="Interim" name="filter_interim"
                        domain="[('report_type', '=', 'interim')]"/>
                <filter string="Final" name="filter_final"
                        domain="[('report_type', '=', 'final')]"/>
                <filter string="Annual" name="filter_annual"
                        domain="[('report_type', '=', 'annual')]"/>
                <separator/>
                <filter string="Archived" name="filter_inactive"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Program" name="group_program"
                            context="{'group_by': 'accreditation_program_id'}"/>
                    <filter string="Type" name="group_type"
                            context="{'group_by': 'report_type'}"/>
                    <filter string="Status" name="group_status"
                            context="{'group_by': 'state'}"/>
                    <filter string="Prepared By" name="group_prepared"
                            context="{'group_by': 'prepared_by'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.accreditation.report — Action                            -->
    <!-- ============================================================ -->
    <record id="action_uni_accreditation_report" model="ir.actions.act_window">
        <field name="name">Accreditation Reports</field>
        <field name="res_model">uni.accreditation.report</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_accreditation_report_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new accreditation report
            </p>
            <p>Accreditation reports document the evidence submitted to the
               accreditation body. They can be self-studies, interim,
               final, special or annual reports.</p>
        </field>
    </record>
</odoo>
