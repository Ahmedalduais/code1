<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- uni.accreditation.body — List View                           -->
    <!-- ============================================================ -->
    <record id="view_uni_accreditation_body_list" model="ir.ui.view">
        <field name="name">uni.accreditation.body.list</field>
        <field name="model">uni.accreditation.body</field>
        <field name="arch" type="xml">
            <list string="Accreditation Bodies"
                  decoration-info="accreditation_type == 'national'"
                  decoration-success="accreditation_type == 'international'"
                  decoration-warning="accreditation_type == 'professional'">
                <field name="code"/>
                <field name="name"/>
                <field name="accreditation_type" widget="badge"
                       decoration-info="accreditation_type == 'national'"
                       decoration-warning="accreditation_type == 'regional'"
                       decoration-success="accreditation_type == 'international'"
                       decoration-secondary="accreditation_type == 'professional'"/>
                <field name="country_id" optional="show"/>
                <field name="contact_person" optional="hide"/>
                <field name="contact_email" optional="hide"/>
                <field name="website" optional="hide"/>
                <field name="establishment_date" optional="hide"/>
                <field name="standard_count" widget="statinfo"/>
                <field name="program_count" widget="statinfo"/>
                <field name="active" optional="hide" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.accreditation.body — Form View                           -->
    <!-- ============================================================ -->
    <record id="view_uni_accreditation_body_form" model="ir.ui.view">
        <field name="name">uni.accreditation.body.form</field>
        <field name="model">uni.accreditation.body</field>
        <field name="arch" type="xml">
            <form string="Accreditation Body">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_standards" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="standard_count" widget="statinfo"
                                   string="Standards"/>
                        </button>
                        <button name="action_view_programs" type="object"
                                class="oe_stat_button" icon="fa-graduation-cap">
                            <field name="program_count" widget="statinfo"
                                   string="Programs"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Accreditation Body"/>
                        <h1><field name="name" placeholder="e.g. National Commission for Academic Accreditation &amp; Assessment"/></h1>
                        <h3><field name="code" placeholder="e.g. NCAAA"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="accreditation_type" widget="radio"/>
                            <field name="partner_id"
                                   options="{'no_create': True}"/>
                            <field name="country_id"/>
                            <field name="website"/>
                            <field name="establishment_date"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="contact_person"/>
                            <field name="contact_email"/>
                            <field name="contact_phone"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" nolabel="1" colspan="2"/>
                        </page>
                        <page string="Standards">
                            <field name="standard_ids"
                                   context="{'default_accreditation_body_id': id}">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="standard_type" optional="show"/>
                                    <field name="weight" optional="show"/>
                                    <field name="minimum_score" optional="show"/>
                                    <field name="is_mandatory" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Programs">
                            <field name="program_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="program_id"/>
                                    <field name="accreditation_status" widget="badge"
                                           decoration-success="accreditation_status == 'granted'"
                                           decoration-warning="accreditation_status == 'probation'"
                                           decoration-danger="accreditation_status == 'revoked'"
                                           decoration-muted="accreditation_status == 'expired'"
                                           decoration-info="accreditation_status in ('pending', 'in_progress')"/>
                                    <field name="expiry_date" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.accreditation.body — Search View                         -->
    <!-- ============================================================ -->
    <record id="view_uni_accreditation_body_search" model="ir.ui.view">
        <field name="name">uni.accreditation.body.search</field>
        <field name="model">uni.accreditation.body</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="country_id"/>
                <field name="contact_person"/>
                <field name="contact_email"/>
                <separator/>
                <filter string="National" name="filter_national"
                        domain="[('accreditation_type', '=', 'national')]"/>
                <filter string="Regional" name="filter_regional"
                        domain="[('accreditation_type', '=', 'regional')]"/>
                <filter string="International" name="filter_international"
                        domain="[('accreditation_type', '=', 'international')]"/>
                <filter string="Professional" name="filter_professional"
                        domain="[('accreditation_type', '=', 'professional')]"/>
                <separator/>
                <filter string="Archived" name="filter_inactive"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_type"
                            context="{'group_by': 'accreditation_type'}"/>
                    <filter string="Country" name="group_country"
                            context="{'group_by': 'country_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.accreditation.body — Action                              -->
    <!-- ============================================================ -->
    <record id="action_uni_accreditation_body" model="ir.actions.act_window">
        <field name="name">Accreditation Bodies</field>
        <field name="res_model">uni.accreditation.body</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_accreditation_body_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new accreditation body
            </p>
            <p>Accreditation bodies are the national, regional, international
               or professional organizations that issue accreditation
               standards and grant program accreditation.</p>
        </field>
    </record>
</odoo>
