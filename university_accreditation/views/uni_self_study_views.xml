<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- uni.self.study — List View                                   -->
    <!-- ============================================================ -->
    <record id="view_uni_self_study_list" model="ir.ui.view">
        <field name="name">uni.self.study.list</field>
        <field name="model">uni.self.study</field>
        <field name="arch" type="xml">
            <list string="Self Studies"
                  decoration-info="state in ('draft', 'in_progress')"
                  decoration-warning="state == 'submitted'"
                  decoration-success="state == 'accepted'"
                  decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="accreditation_program_id"/>
                <field name="program_id" optional="hide"/>
                <field name="university_id" optional="hide"/>
                <field name="coordinator_id" optional="show"/>
                <field name="preparation_start_date" optional="hide"/>
                <field name="preparation_end_date" optional="hide"/>
                <field name="submission_date" optional="show"/>
                <field name="completion_percentage" widget="progressbar"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('draft', 'in_progress')"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state == 'accepted'"
                       decoration-danger="state == 'rejected'"/>
                <field name="active" optional="hide" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.self.study — Form View                                   -->
    <!-- ============================================================ -->
    <record id="view_uni_self_study_form" model="ir.ui.view">
        <field name="name">uni.self.study.form</field>
        <field name="model">uni.self.study</field>
        <field name="arch" type="xml">
            <form string="Self Study">
                <header>
                    <button name="action_start" string="Start"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_submit" string="Submit"
                            type="object" class="oe_highlight"
                            invisible="state not in ('draft', 'in_progress')"/>
                    <button name="action_accept" string="Accept"
                            type="object" class="oe_highlight"
                            invisible="state != 'submitted'"/>
                    <button name="action_reject" string="Reject"
                            type="object"
                            invisible="state != 'submitted'"
                            confirm="Are you sure you want to reject this self-study?"/>
                    <button name="action_draft" string="Reset to In Progress"
                            type="object"
                            invisible="state != 'rejected'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_progress,submitted,accepted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Self Study"/>
                        <h1><field name="name" placeholder="e.g. SST-CS-2025"/></h1>
                        <h3><field name="code" placeholder="SST-CS-NCAAA"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="accreditation_program_id"
                                   options="{'no_create': True}"
                                   readonly="state in ('submitted', 'accepted')"
                                   required="1"/>
                            <field name="program_id" readonly="1"/>
                            <field name="university_id" readonly="1" optional="hide"/>
                            <field name="coordinator_id"
                                   options="{'no_create': True}"
                                   readonly="state in ('submitted', 'accepted')"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="preparation_start_date" readonly="1"/>
                            <field name="preparation_end_date" readonly="1"/>
                            <field name="submission_date" readonly="1"/>
                            <field name="completion_percentage" widget="progressbar"/>
                        </group>
                    </group>
                    <group>
                        <group string="Committee">
                            <field name="committee_members_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True}"
                                   readonly="state in ('submitted', 'accepted')"/>
                        </group>
                        <group string="File">
                            <field name="file" filename="filename"
                                   readonly="state in ('submitted', 'accepted')"/>
                            <field name="filename" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Mission &amp; Vision">
                            <group>
                                <group string="Mission">
                                    <field name="mission_statement" nolabel="1"
                                           readonly="state in ('submitted', 'accepted')"/>
                                </group>
                                <group string="Vision">
                                    <field name="vision_statement" nolabel="1"
                                           readonly="state in ('submitted', 'accepted')"/>
                                </group>
                            </group>
                            <group>
                                <group string="Goals">
                                    <field name="goals" nolabel="1"
                                           readonly="state in ('submitted', 'accepted')"/>
                                </group>
                                <group string="Program Learning Outcomes">
                                    <field name="program_learning_outcomes" nolabel="1"
                                           readonly="state in ('submitted', 'accepted')"/>
                                </group>
                            </group>
                        </page>
                        <page string="Curriculum &amp; Assessment">
                            <group>
                                <group string="Curriculum Description">
                                    <field name="curriculum_description" nolabel="1"
                                           readonly="state in ('submitted', 'accepted')"/>
                                </group>
                                <group string="Student Assessment Methods">
                                    <field name="student_assessment_methods" nolabel="1"
                                           readonly="state in ('submitted', 'accepted')"/>
                                </group>
                            </group>
                        </page>
                        <page string="Resources">
                            <group>
                                <group string="Faculty Qualifications">
                                    <field name="faculty_qualifications" nolabel="1"
                                           readonly="state in ('submitted', 'accepted')"/>
                                </group>
                                <group string="Physical Resources">
                                    <field name="physical_resources" nolabel="1"
                                           readonly="state in ('submitted', 'accepted')"/>
                                </group>
                                <group string="Library Resources">
                                    <field name="library_resources" nolabel="1"
                                           readonly="state in ('submitted', 'accepted')"/>
                                </group>
                                <group string="Financial Resources">
                                    <field name="financial_resources" nolabel="1"
                                           readonly="state in ('submitted', 'accepted')"/>
                                </group>
                                <group string="Governance Structure">
                                    <field name="governance_structure" nolabel="1"
                                           readonly="state in ('submitted', 'accepted')"/>
                                </group>
                            </group>
                        </page>
                        <page string="SWOT Analysis">
                            <group>
                                <group string="Strengths">
                                    <field name="strengths" nolabel="1"
                                           readonly="state in ('submitted', 'accepted')"/>
                                </group>
                                <group string="Weaknesses">
                                    <field name="weaknesses" nolabel="1"
                                           readonly="state in ('submitted', 'accepted')"/>
                                </group>
                                <group string="Opportunities">
                                    <field name="opportunities" nolabel="1"
                                           readonly="state in ('submitted', 'accepted')"/>
                                </group>
                                <group string="Threats">
                                    <field name="threats" nolabel="1"
                                           readonly="state in ('submitted', 'accepted')"/>
                                </group>
                            </group>
                        </page>
                        <page string="Improvement Plan">
                            <field name="improvement_plan" nolabel="1" colspan="2"
                                   readonly="state in ('submitted', 'accepted')"/>
                        </page>
                        <page string="Notes">
                            <field name="notes" nolabel="1" colspan="2"
                                   readonly="state in ('submitted', 'accepted')"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.self.study — Search View                                 -->
    <!-- ============================================================ -->
    <record id="view_uni_self_study_search" model="ir.ui.view">
        <field name="name">uni.self.study.search</field>
        <field name="model">uni.self.study</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="accreditation_program_id"/>
                <field name="program_id"/>
                <field name="university_id"/>
                <field name="coordinator_id"/>
                <separator/>
                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="In Progress" name="filter_in_progress"
                        domain="[('state', '=', 'in_progress')]"/>
                <filter string="Submitted" name="filter_submitted"
                        domain="[('state', '=', 'submitted')]"/>
                <filter string="Accepted" name="filter_accepted"
                        domain="[('state', '=', 'accepted')]"/>
                <filter string="Rejected" name="filter_rejected"
                        domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter string="Incomplete (&lt; 50%)" name="filter_incomplete"
                        domain="[('completion_percentage', '&lt;', 50)]"/>
                <separator/>
                <filter string="Archived" name="filter_inactive"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Program" name="group_program"
                            context="{'group_by': 'accreditation_program_id'}"/>
                    <filter string="Coordinator" name="group_coordinator"
                            context="{'group_by': 'coordinator_id'}"/>
                    <filter string="Status" name="group_status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.self.study — Action                                      -->
    <!-- ============================================================ -->
    <record id="action_uni_self_study" model="ir.actions.act_window">
        <field name="name">Self Studies</field>
        <field name="res_model">uni.self.study</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_self_study_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new self-study
            </p>
            <p>A self-study is the comprehensive document a program prepares
               for accreditation. It covers mission, vision, curriculum,
               resources, SWOT analysis and an improvement plan.</p>
        </field>
    </record>
</odoo>
