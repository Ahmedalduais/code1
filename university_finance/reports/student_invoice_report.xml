<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Paper format — portrait A4 for student invoices.
    -->
    <record id="paper_format_student_invoice" model="report.paperformat">
        <field name="name">Student Invoice A4</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="dpi">90</field>
    </record>

    <!--
        QWeb PDF report for the student invoice.
    -->
    <record id="report_uni_invoice_student_document" model="ir.actions.report">
        <field name="name">Student Invoice</field>
        <field name="model">uni.invoice.student</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">university_finance.report_invoice_student_document</field>
        <field name="report_file">university_finance.report_invoice_student_document</field>
        <field name="paperformat_id" ref="paper_format_student_invoice"/>
        <field name="print_report_name">'INV-%s' % (object.name or 'invoice')</field>
        <field name="binding_model_id" ref="model_uni_invoice_student"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
