<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        QWeb template for the student invoice PDF.

        Renders:
          - Header (university / invoice reference / date / due date)
          - Student information block
          - Invoice lines table (fee type, description, qty, price, discount, subtotal)
          - Totals (gross / discount / net / paid / due)
          - Optional scholarship & payment plan info
          - Notes (if any)
    -->
    <template id="report_invoice_student_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 class="text-center">
                        Student Invoice
                    </h2>
                    <div class="row mt-3 mb-3">
                        <div class="col-6">
                            <strong>Invoice Reference:</strong>
                            <span t-field="object.name"/>
                        </div>
                        <div class="col-6 text-right">
                            <strong>Status:</strong>
                            <span t-field="object.state"/>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-4">
                            <strong>Invoice Date:</strong>
                            <span t-field="object.invoice_date"/>
                        </div>
                        <div class="col-4">
                            <strong>Due Date:</strong>
                            <span t-field="object.due_date"/>
                        </div>
                        <div class="col-4 text-right">
                            <strong>Currency:</strong>
                            <span t-field="object.currency_id"/>
                        </div>
                    </div>

                    <!-- Student information -->
                    <div class="row mb-3">
                        <div class="col-12">
                            <strong>Billed To:</strong>
                            <div>
                                <span t-field="object.student_id"/>
                                <t t-if="object.student_id.student_code">
                                    <span>
                                        —
                                        <span t-field="object.student_id.student_code"/>
                                    </span>
                                </t>
                            </div>
                            <t t-if="object.university_id">
                                <div>
                                    <strong>University:</strong>
                                    <span t-field="object.university_id"/>
                                </div>
                            </t>
                            <t t-if="object.academic_term_id">
                                <div>
                                    <strong>Academic Term:</strong>
                                    <span t-field="object.academic_term_id"/>
                                </div>
                            </t>
                        </div>
                    </div>

                    <!-- Invoice lines -->
                    <table class="table table-sm table-bordered">
                        <thead>
                            <tr class="active">
                                <th>Description</th>
                                <th class="text-right">Quantity</th>
                                <th class="text-right">Unit Price</th>
                                <th class="text-right">Discount %</th>
                                <th class="text-right">Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="object.line_ids" t-as="line">
                                <tr>
                                    <td>
                                        <span t-field="line.description"/>
                                        <t t-if="line.fee_type_id">
                                            <span>
                                                (
                                                <span t-field="line.fee_type_id.code"/>
                                                )
                                            </span>
                                        </t>
                                    </td>
                                    <td class="text-right">
                                        <span t-field="line.quantity"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-field="line.price_unit"
                                              t-options="{'widget': 'monetary',
                                                          'display_currency': object.currency_id}"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-field="line.discount"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-field="line.subtotal"
                                              t-options="{'widget': 'monetary',
                                                          'display_currency': object.currency_id}"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- Totals -->
                    <div class="row">
                        <div class="col-6">
                            <t t-if="object.scholarship_id">
                                <strong>Scholarship Applied:</strong>
                                <span t-field="object.scholarship_id.name"/>
                                <t t-if="object.scholarship_id.discount_percentage">
                                    <span>
                                        (
                                        <span t-field="object.scholarship_id.discount_percentage"/>
                                        %)
                                    </span>
                                </t>
                                <br/>
                            </t>
                            <t t-if="object.payment_plan_id">
                                <strong>Payment Plan:</strong>
                                <span t-field="object.payment_plan_id.name"/>
                                <br/>
                            </t>
                            <t t-if="object.fee_structure_id">
                                <strong>Fee Structure:</strong>
                                <span t-field="object.fee_structure_id.name"/>
                                <br/>
                            </t>
                            <t t-if="object.move_id">
                                <strong>Accounting Invoice:</strong>
                                <span t-field="object.move_id.name"/>
                            </t>
                        </div>
                        <div class="col-6">
                            <table class="table table-sm">
                                <tr>
                                    <td><strong>Total</strong></td>
                                    <td class="text-right">
                                        <span t-field="object.amount_total"
                                              t-options="{'widget': 'monetary',
                                                          'display_currency': object.currency_id}"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Paid</strong></td>
                                    <td class="text-right">
                                        <span t-field="object.amount_paid"
                                              t-options="{'widget': 'monetary',
                                                          'display_currency': object.currency_id}"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Due</strong></td>
                                    <td class="text-right">
                                        <strong>
                                            <span t-field="object.amount_due"
                                                  t-options="{'widget': 'monetary',
                                                              'display_currency': object.currency_id}"/>
                                        </strong>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>

                    <!-- Notes -->
                    <t t-if="object.notes">
                        <div class="mt-3">
                            <strong>Notes:</strong>
                            <p t-field="object.notes"/>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
