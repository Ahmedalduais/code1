<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- uni.fee.structure — List View                                 -->
    <!-- ============================================================ -->
    <record id="view_uni_fee_structure_list" model="ir.ui.view">
        <field name="name">uni.fee.structure.list</field>
        <field name="model">uni.fee.structure</field>
        <field name="arch" type="xml">
            <list string="Fee Structures"
                  decoration-success="state == 'active'"
                  decoration-warning="state == 'draft'"
                  decoration-muted="state == 'closed'">
                <field name="code"/>
                <field name="name"/>
                <field name="university_id"/>
                <field name="college_id" optional="hide"/>
                <field name="department_id" optional="hide"/>
                <field name="program_id"/>
                <field name="level_id" optional="hide"/>
                <field name="academic_term_id" optional="hide"/>
                <field name="effective_date"/>
                <field name="expiry_date"/>
                <field name="total_amount" widget="monetary"
                       options="{'currency_field': 'currency_id'}" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'draft'"
                       decoration-muted="state == 'closed'"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.fee.structure — Form View                                 -->
    <!-- ============================================================ -->
    <record id="view_uni_fee_structure_form" model="ir.ui.view">
        <field name="name">uni.fee.structure.form</field>
        <field name="model">uni.fee.structure</field>
        <field name="arch" type="xml">
            <form string="Fee Structure">
                <header>
                    <button name="action_activate" string="Activate"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_close" string="Close"
                            type="object"
                            invisible="state != 'active'"/>
                    <button name="action_draft" string="Set to Draft"
                            type="object"
                            invisible="state != 'closed'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_installments" type="object"
                                class="oe_stat_button" icon="fa-calendar-o">
                            <field name="installment_count" widget="statinfo"
                                   string="Installments"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Fee Structure"/>
                        <h1><field name="name" placeholder="e.g. Bachelor of Science — Standard Fees"/></h1>
                        <h3><field name="code" placeholder="e.g. BSC-FEE-2025"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="university_id"
                                   options="{'no_create': True}"/>
                            <field name="college_id"
                                   options="{'no_create': True}"/>
                            <field name="department_id"
                                   options="{'no_create': True}"/>
                            <field name="program_id"
                                   options="{'no_create': True}"/>
                            <field name="level_id"
                                   options="{'no_create': True}"/>
                            <field name="academic_term_id"
                                   options="{'no_create': True}"/>
                            <field name="academic_year_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="effective_date"/>
                            <field name="expiry_date"/>
                            <field name="currency_id"
                                   options="{'no_create': True}"/>
                            <field name="total_amount" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Fee Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="fee_type_id"
                                           options="{'no_create': True}"/>
                                    <field name="fee_type_code" readonly="1"/>
                                    <field name="amount" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Installments">
                            <field name="installment_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="installment_number"/>
                                    <field name="name"/>
                                    <field name="due_date"/>
                                    <field name="amount" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="percentage"/>
                                    <field name="grace_period_days"/>
                                    <field name="late_fee_amount" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.fee.structure — Search View                               -->
    <!-- ============================================================ -->
    <record id="view_uni_fee_structure_search" model="ir.ui.view">
        <field name="name">uni.fee.structure.search</field>
        <field name="model">uni.fee.structure</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="university_id"/>
                <field name="college_id"/>
                <field name="department_id"/>
                <field name="program_id"/>
                <field name="level_id"/>
                <field name="academic_term_id"/>
                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Active" name="filter_active"
                        domain="[('state', '=', 'active')]"/>
                <filter string="Closed" name="filter_closed"
                        domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter string="Archived" name="filter_archived"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="University" name="group_university"
                            context="{'group_by': 'university_id'}"/>
                    <filter string="College" name="group_college"
                            context="{'group_by': 'college_id'}"/>
                    <filter string="Department" name="group_department"
                            context="{'group_by': 'department_id'}"/>
                    <filter string="Program" name="group_program"
                            context="{'group_by': 'program_id'}"/>
                    <filter string="Level" name="group_level"
                            context="{'group_by': 'level_id'}"/>
                    <filter string="Term" name="group_term"
                            context="{'group_by': 'academic_term_id'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.fee.structure — Action                                    -->
    <!-- ============================================================ -->
    <record id="action_uni_fee_structure" model="ir.actions.act_window">
        <field name="name">Fee Structures</field>
        <field name="res_model">uni.fee.structure</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_fee_structure_search"/>
        <field name="context">{'default_state': 'draft'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new fee structure
            </p>
            <p>Fee structures define the charges applicable to a specific
               program / level / term, broken down into fee lines and
               optional installments.</p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.fee.installment — List/Form/Search/Action                 -->
    <!-- ============================================================ -->
    <record id="view_uni_fee_installment_list" model="ir.ui.view">
        <field name="name">uni.fee.installment.list</field>
        <field name="model">uni.fee.installment</field>
        <field name="arch" type="xml">
            <list string="Installments">
                <field name="sequence" widget="handle"/>
                <field name="installment_number"/>
                <field name="name"/>
                <field name="fee_structure_id"/>
                <field name="due_date"/>
                <field name="amount" widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="percentage"/>
                <field name="grace_period_days"/>
                <field name="late_fee_amount" widget="monetary"
                       options="{'currency_field': 'currency_id'}"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_uni_fee_installment_form" model="ir.ui.view">
        <field name="name">uni.fee.installment.form</field>
        <field name="model">uni.fee.installment</field>
        <field name="arch" type="xml">
            <form string="Installment">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Installment"/>
                        <h1><field name="name" placeholder="e.g. First Installment"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="fee_structure_id"
                                   options="{'no_create': True}"/>
                            <field name="installment_number"/>
                            <field name="sequence"/>
                            <field name="due_date"/>
                        </group>
                        <group>
                            <field name="amount" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="percentage"/>
                            <field name="grace_period_days"/>
                            <field name="late_fee_amount" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="currency_id"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_uni_fee_installment_search" model="ir.ui.view">
        <field name="name">uni.fee.installment.search</field>
        <field name="model">uni.fee.installment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="fee_structure_id"/>
                <group expand="0" string="Group By">
                    <filter string="Fee Structure" name="group_structure"
                            context="{'group_by': 'fee_structure_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_uni_fee_installment" model="ir.actions.act_window">
        <field name="name">Fee Installments</field>
        <field name="res_model">uni.fee.installment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_fee_installment_search"/>
    </record>
</odoo>
