<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- uni.payment.plan — List View                                  -->
    <!-- ============================================================ -->
    <record id="view_uni_payment_plan_list" model="ir.ui.view">
        <field name="name">uni.payment.plan.list</field>
        <field name="model">uni.payment.plan</field>
        <field name="arch" type="xml">
            <list string="Payment Plans"
                  decoration-success="state == 'completed'"
                  decoration-info="state == 'active'"
                  decoration-warning="state == 'draft'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="code" optional="hide"/>
                <field name="student_id"/>
                <field name="university_id" optional="hide"/>
                <field name="start_date"/>
                <field name="frequency"/>
                <field name="installments_count"/>
                <field name="total_amount" widget="monetary"
                       options="{'currency_field': 'currency_id'}" sum="Total"/>
                <field name="paid_amount" widget="monetary"
                       options="{'currency_field': 'currency_id'}" sum="Paid"/>
                <field name="remaining_amount" widget="monetary"
                       options="{'currency_field': 'currency_id'}" sum="Remaining"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'completed'"
                       decoration-info="state == 'active'"
                       decoration-warning="state == 'draft'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.payment.plan — Form View                                  -->
    <!-- ============================================================ -->
    <record id="view_uni_payment_plan_form" model="ir.ui.view">
        <field name="name">uni.payment.plan.form</field>
        <field name="model">uni.payment.plan</field>
        <field name="arch" type="xml">
            <form string="Payment Plan">
                <header>
                    <button name="action_generate_installments"
                            string="Generate Installments"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_activate" string="Activate"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_complete" string="Complete"
                            type="object" class="oe_highlight"
                            invisible="state != 'active'"/>
                    <button name="action_cancel" string="Cancel"
                            type="object"
                            invisible="state == 'cancelled'"
                            confirm="Cancel this payment plan?"/>
                    <button name="action_draft" string="Set to Draft"
                            type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_lines" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="line_count" widget="statinfo"
                                   string="Installments"/>
                        </button>
                        <button name="action_view_invoices" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <span class="o_stat_text">Invoices</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Payment Plan"/>
                        <h1><field name="name" readonly="1"/></h1>
                        <h3><field name="code" placeholder="Auto-filled from reference"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="student_id"
                                   options="{'no_create': True}"/>
                            <field name="university_id" readonly="1"
                                   options="{'no_create': True}"/>
                            <field name="invoice_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="total_amount" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="paid_amount" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="remaining_amount" widget="monetary"
                                   options="{'currency_field': 'currency_id'}"/>
                            <field name="currency_id"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="installments_count"/>
                            <field name="frequency"/>
                            <field name="start_date"/>
                        </group>
                        <group>
                            <field name="line_count"/>
                            <field name="state" widget="badge"
                                   decoration-success="state == 'completed'"
                                   decoration-info="state == 'active'"
                                   decoration-warning="state == 'draft'"
                                   decoration-muted="state == 'cancelled'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Installments">
                            <field name="line_ids">
                                <list editable="bottom"
                                      decoration-success="state == 'paid'"
                                      decoration-danger="state == 'overdue'"
                                      decoration-warning="state == 'pending'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="due_date"/>
                                    <field name="amount" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="payment_date"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'paid'"
                                           decoration-danger="state == 'overdue'"
                                           decoration-warning="state == 'pending'"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.payment.plan — Search View                                -->
    <!-- ============================================================ -->
    <record id="view_uni_payment_plan_search" model="ir.ui.view">
        <field name="name">uni.payment.plan.search</field>
        <field name="model">uni.payment.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="student_id"/>
                <field name="university_id"/>
                <field name="frequency"/>
                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Active" name="filter_active"
                        domain="[('state', '=', 'active')]"/>
                <filter string="Completed" name="filter_completed"
                        domain="[('state', '=', 'completed')]"/>
                <filter string="Cancelled" name="filter_cancelled"
                        domain="[('state', '=', 'cancelled')]"/>
                <group expand="0" string="Group By">
                    <filter string="Student" name="group_student"
                            context="{'group_by': 'student_id'}"/>
                    <filter string="Frequency" name="group_frequency"
                            context="{'group_by': 'frequency'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.payment.plan — Action                                     -->
    <!-- ============================================================ -->
    <record id="action_uni_payment_plan" model="ir.actions.act_window">
        <field name="name">Payment Plans</field>
        <field name="res_model">uni.payment.plan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_payment_plan_search"/>
        <field name="context">{'default_state': 'draft',
                              'default_frequency': 'monthly'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new payment plan
            </p>
            <p>Payment plans split a student's outstanding balance into
               scheduled installments (weekly, bi-weekly, monthly, quarterly)
               with due dates and payment tracking.</p>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.payment.plan.line — List/Form/Search/Action               -->
    <!-- ============================================================ -->
    <record id="view_uni_payment_plan_line_list" model="ir.ui.view">
        <field name="name">uni.payment.plan.line.list</field>
        <field name="model">uni.payment.plan.line</field>
        <field name="arch" type="xml">
            <list string="Payment Plan Installments"
                  decoration-success="state == 'paid'"
                  decoration-danger="state == 'overdue'"
                  decoration-warning="state == 'pending'">
                <field name="sequence" widget="handle"/>
                <field name="plan_id"/>
                <field name="due_date"/>
                <field name="amount" widget="monetary"
                       options="{'currency_field': 'currency_id'}" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="payment_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'paid'"
                       decoration-danger="state == 'overdue'"
                       decoration-warning="state == 'pending'"/>
            </list>
        </field>
    </record>

    <record id="view_uni_payment_plan_line_form" model="ir.ui.view">
        <field name="name">uni.payment.plan.line.form</field>
        <field name="model">uni.payment.plan.line</field>
        <field name="arch" type="xml">
            <form string="Installment">
                <header>
                    <button name="action_mark_paid" string="Mark as Paid"
                            type="object" class="oe_highlight"
                            invisible="state == 'paid'"/>
                    <button name="action_mark_pending" string="Reset to Pending"
                            type="object"
                            invisible="state != 'paid'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,paid"/>
                </header>
                <sheet>
                    <group>
                        <field name="plan_id"
                               options="{'no_create': True}"/>
                        <field name="sequence"/>
                        <field name="due_date"/>
                        <field name="amount" widget="monetary"
                               options="{'currency_field': 'currency_id'}"/>
                        <field name="currency_id"
                               options="{'no_create': True}"/>
                        <field name="payment_date"/>
                        <field name="state"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_uni_payment_plan_line_search" model="ir.ui.view">
        <field name="name">uni.payment.plan.line.search</field>
        <field name="model">uni.payment.plan.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="plan_id"/>
                <field name="due_date"/>
                <filter string="Pending" name="filter_pending"
                        domain="[('state', '=', 'pending')]"/>
                <filter string="Paid" name="filter_paid"
                        domain="[('state', '=', 'paid')]"/>
                <filter string="Overdue" name="filter_overdue"
                        domain="[('state', '=', 'overdue')]"/>
                <group expand="0" string="Group By">
                    <filter string="Plan" name="group_plan"
                            context="{'group_by': 'plan_id'}"/>
                    <filter string="State" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_uni_payment_plan_line" model="ir.actions.act_window">
        <field name="name">Payment Plan Installments</field>
        <field name="res_model">uni.payment.plan.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_payment_plan_line_search"/>
    </record>
</odoo>
