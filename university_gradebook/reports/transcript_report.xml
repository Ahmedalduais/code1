<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Transcript paper format — portrait A4 with comfortable margins
        for an official-looking academic document.
    -->
    <record id="paper_format_transcript_portrait" model="report.paperformat">
        <field name="name">Transcript Portrait A4</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">20</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">15</field>
        <field name="margin_right">15</field>
        <field name="header_line" eval="False"/>
        <field name="dpi">90</field>
    </record>

    <!--
        Transcript QWeb report action — bound to uni.transcript.
    -->
    <record id="action_report_transcript" model="ir.actions.report">
        <field name="name">Academic Transcript</field>
        <field name="model">uni.transcript</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">university_gradebook.report_transcript_document</field>
        <field name="report_file">university_gradebook.report_transcript_document</field>
        <field name="paperformat_id" ref="paper_format_transcript_portrait"/>
        <field name="print_report_name">'TRN-%s' % (object.code or object.name or 'transcript')</field>
        <field name="binding_model_id" ref="model_uni_transcript"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
