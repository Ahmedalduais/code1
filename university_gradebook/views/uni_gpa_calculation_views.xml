<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- uni.gpa.calculation — List View                              -->
    <!-- ============================================================ -->
    <record id="view_uni_gpa_calculation_list" model="ir.ui.view">
        <field name="name">uni.gpa.calculation.list</field>
        <field name="model">uni.gpa.calculation</field>
        <field name="arch" type="xml">
            <list string="GPA Calculations"
                  decoration-info="state == 'draft'"
                  decoration-success="state == 'calculated'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="student_id"/>
                <field name="academic_term_id" optional="show"/>
                <field name="university_id" optional="hide"/>
                <field name="grading_system_id" optional="hide"/>
                <field name="term_gpa"/>
                <field name="cumulative_gpa"/>
                <field name="total_credits_attempted"/>
                <field name="total_credits_earned"/>
                <field name="total_quality_points" optional="hide"/>
                <field name="calc_date" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'calculated'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.gpa.calculation — Form View                              -->
    <!-- ============================================================ -->
    <record id="view_uni_gpa_calculation_form" model="ir.ui.view">
        <field name="name">uni.gpa.calculation.form</field>
        <field name="model">uni.gpa.calculation</field>
        <field name="arch" type="xml">
            <form string="GPA Calculation">
                <header>
                    <button name="action_load_term_finals" string="Load Term Finals"
                            type="object"
                            invisible="state == 'cancelled'"/>
                    <button name="action_calculate_term_gpa" string="Calculate Term GPA"
                            type="object" class="oe_highlight"
                            invisible="state == 'cancelled'"/>
                    <button name="action_calculate_cumulative_gpa"
                            string="Calculate Cumulative GPA"
                            type="object" class="oe_highlight"
                            invisible="state == 'cancelled'"/>
                    <button name="action_update_student_record"
                            string="Update Student Record"
                            type="object"
                            invisible="state == 'cancelled'"/>
                    <button name="action_cancel" string="Cancel"
                            type="object"
                            invisible="state == 'cancelled'"/>
                    <button name="action_reset" string="Reset"
                            type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,calculated,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="GPA Calculation"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="student_id"
                                   options="{'no_create': True}"
                                   required="1"/>
                            <field name="academic_term_id"
                                   options="{'no_create': True}"/>
                            <field name="university_id"
                                   options="{'no_create': True}"
                                   readonly="1"/>
                            <field name="grading_system_id"
                                   options="{'no_create': True}"
                                   required="1"/>
                        </group>
                        <group>
                            <field name="calc_date" readonly="1"/>
                            <field name="term_gpa" widget="progressbar"
                                   readonly="1"/>
                            <field name="cumulative_gpa" widget="progressbar"
                                   readonly="1"/>
                            <field name="result_status" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="total_credits_attempted" readonly="1"/>
                            <field name="total_credits_earned" readonly="1"/>
                            <field name="total_quality_points" readonly="1"/>
                        </group>
                        <group>
                            <field name="result_gpa" readonly="1"/>
                            <field name="result_percentage" readonly="1"/>
                            <field name="result_grade_letter" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Final Grades Used">
                            <field name="final_ids">
                                <list>
                                    <field name="student_id" readonly="1"/>
                                    <field name="course_id" readonly="1"/>
                                    <field name="academic_term_id" readonly="1"/>
                                    <field name="final_percentage" readonly="1"/>
                                    <field name="grade_letter_id" readonly="1"/>
                                    <field name="gpa_value" readonly="1"/>
                                    <field name="credit_hours" readonly="1"/>
                                    <field name="is_passing" widget="boolean_toggle" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" nolabel="1" colspan="2"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.gpa.calculation — Search View                            -->
    <!-- ============================================================ -->
    <record id="view_uni_gpa_calculation_search" model="ir.ui.view">
        <field name="name">uni.gpa.calculation.search</field>
        <field name="model">uni.gpa.calculation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="student_id"/>
                <field name="academic_term_id"/>
                <field name="university_id"/>
                <field name="grading_system_id"/>
                <separator/>
                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Calculated" name="filter_calculated"
                        domain="[('state', '=', 'calculated')]"/>
                <filter string="Cancelled" name="filter_cancelled"
                        domain="[('state', '=', 'cancelled')]"/>
                <group expand="0" string="Group By">
                    <filter string="Student" name="group_student"
                            context="{'group_by': 'student_id'}"/>
                    <filter string="Term" name="group_term"
                            context="{'group_by': 'academic_term_id'}"/>
                    <filter string="University" name="group_university"
                            context="{'group_by': 'university_id'}"/>
                    <filter string="Grading System" name="group_system"
                            context="{'group_by': 'grading_system_id'}"/>
                    <filter string="State" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.gpa.calculation — Action                                 -->
    <!-- ============================================================ -->
    <record id="action_uni_gpa_calculation" model="ir.actions.act_window">
        <field name="name">GPA Calculations</field>
        <field name="res_model">uni.gpa.calculation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_gpa_calculation_search"/>
        <field name="context">{'search_default_filter_calculated': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new GPA calculation
            </p>
            <p>Each calculation computes the term GPA and cumulative GPA for
               a student using their final grade records and the selected
               grading system. You can write the cumulative GPA back to the
               student record.</p>
        </field>
    </record>
</odoo>
