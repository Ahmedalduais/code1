<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- uni.transcript — List View                                   -->
    <!-- ============================================================ -->
    <record id="view_uni_transcript_list" model="ir.ui.view">
        <field name="name">uni.transcript.list</field>
        <field name="model">uni.transcript</field>
        <field name="arch" type="xml">
            <list string="Transcripts"
                  decoration-info="state == 'draft'"
                  decoration-success="state == 'issued'"
                  decoration-primary="state == 'verified'"
                  decoration-muted="state == 'revoked'">
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="student_id"/>
                <field name="university_id" optional="hide"/>
                <field name="program_id" optional="hide"/>
                <field name="academic_year_from" optional="hide"/>
                <field name="academic_year_to" optional="show"/>
                <field name="issue_date"/>
                <field name="issued_by" optional="hide"/>
                <field name="cumulative_gpa"/>
                <field name="total_credits_earned" optional="hide"/>
                <field name="final_count" optional="hide"/>
                <field name="print_count" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'issued'"
                       decoration-primary="state == 'verified'"
                       decoration-muted="state == 'revoked'"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.transcript — Form View                                   -->
    <!-- ============================================================ -->
    <record id="view_uni_transcript_form" model="ir.ui.view">
        <field name="name">uni.transcript.form</field>
        <field name="model">uni.transcript</field>
        <field name="arch" type="xml">
            <form string="Transcript">
                <header>
                    <button name="action_generate_lines" string="Generate Lines"
                            type="object"
                            invisible="state == 'revoked'"/>
                    <button name="action_issue" string="Issue"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_verify" string="Verify"
                            type="object" class="oe_highlight"
                            invisible="state != 'issued'"/>
                    <button name="action_revoke" string="Revoke"
                            type="object"
                            invisible="state not in ('issued', 'verified')"/>
                    <button name="action_print" string="Print PDF"
                            type="object" class="oe_highlight"
                            invisible="state == 'draft'"/>
                    <button name="action_draft" string="Set to Draft"
                            type="object"
                            invisible="state != 'issued'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,issued,verified"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_finals" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="final_count" widget="statinfo"
                                   string="Finals"/>
                        </button>
                        <button name="action_print" type="object"
                                class="oe_stat_button" icon="fa-print">
                            <field name="print_count" widget="statinfo"
                                   string="Prints"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Transcript"/>
                        <h1><field name="name" readonly="1"/></h1>
                        <h3><field name="code" placeholder="TRN-2025-0001"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="student_id"
                                   options="{'no_create': True}"
                                   required="1"
                                   readonly="state != 'draft'"/>
                            <field name="university_id" readonly="1"/>
                            <field name="program_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="academic_year_from"
                                   options="{'no_create': True}"
                                   readonly="state == 'revoked'"/>
                            <field name="academic_year_to"
                                   options="{'no_create': True}"
                                   readonly="state == 'revoked'"/>
                            <field name="issue_date" readonly="1"/>
                            <field name="issued_by" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="cumulative_gpa" widget="progressbar" readonly="1"/>
                            <field name="academic_standing" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_credits_earned" readonly="1"/>
                            <field name="total_credits_required" readonly="1"/>
                            <field name="official_stamp" widget="boolean_toggle" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Final Grades">
                            <field name="final_ids">
                                <list>
                                    <field name="student_id" readonly="1"/>
                                    <field name="course_id" readonly="1"/>
                                    <field name="academic_term_id" readonly="1"/>
                                    <field name="final_percentage" readonly="1"/>
                                    <field name="grade_letter_id" readonly="1"/>
                                    <field name="gpa_value" readonly="1"/>
                                    <field name="credit_hours" readonly="1"/>
                                    <field name="is_passing" widget="boolean_toggle" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" nolabel="1" colspan="2"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.transcript — Search View                                 -->
    <!-- ============================================================ -->
    <record id="view_uni_transcript_search" model="ir.ui.view">
        <field name="name">uni.transcript.search</field>
        <field name="model">uni.transcript</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="student_id"/>
                <field name="university_id"/>
                <field name="program_id"/>
                <field name="issued_by"/>
                <separator/>
                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Issued" name="filter_issued"
                        domain="[('state', '=', 'issued')]"/>
                <filter string="Verified" name="filter_verified"
                        domain="[('state', '=', 'verified')]"/>
                <filter string="Revoked" name="filter_revoked"
                        domain="[('state', '=', 'revoked')]"/>
                <separator/>
                <filter string="Official Stamp" name="filter_stamp"
                        domain="[('official_stamp', '=', True)]"/>
                <filter string="Archived" name="filter_inactive"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Student" name="group_student"
                            context="{'group_by': 'student_id'}"/>
                    <filter string="University" name="group_university"
                            context="{'group_by': 'university_id'}"/>
                    <filter string="Program" name="group_program"
                            context="{'group_by': 'program_id'}"/>
                    <filter string="Issued By" name="group_issued_by"
                            context="{'group_by': 'issued_by'}"/>
                    <filter string="State" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.transcript — Action                                      -->
    <!-- ============================================================ -->
    <record id="action_uni_transcript" model="ir.actions.act_window">
        <field name="name">Transcripts</field>
        <field name="res_model">uni.transcript</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_transcript_search"/>
        <field name="context">{'search_default_filter_issued': 1,
                              'search_default_filter_verified': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new transcript
            </p>
            <p>Each transcript is an official academic record for a student.
               Generate the final grades list, issue it, then verify &amp;
               print the official PDF document.</p>
        </field>
    </record>
</odoo>
