<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ uni.lms.quiz — List View ============ -->
    <record id="view_uni_lms_quiz_list" model="ir.ui.view">
        <field name="name">uni.lms.quiz.list</field>
        <field name="model">uni.lms.quiz</field>
        <field name="arch" type="xml">
            <list string="LMS Quizzes"
                  decoration-success="state=='published'"
                  decoration-warning="state=='draft'"
                  decoration-muted="state=='closed'">
                <field name="name"/>
                <field name="code" optional="hide"/>
                <field name="lms_course_id"/>
                <field name="title"/>
                <field name="quiz_type"/>
                <field name="question_count"/>
                <field name="total_points" optional="hide"/>
                <field name="attempt_count"/>
                <field name="start_date" optional="show"/>
                <field name="end_date" optional="show"/>
                <field name="time_limit_minutes" optional="hide"/>
                <field name="max_score" optional="hide"/>
                <field name="weight" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============ uni.lms.quiz — Form View ============ -->
    <record id="view_uni_lms_quiz_form" model="ir.ui.view">
        <field name="name">uni.lms.quiz.form</field>
        <field name="model">uni.lms.quiz</field>
        <field name="arch" type="xml">
            <form string="LMS Quiz">
                <header>
                    <button name="action_publish" type="object" string="Publish"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close" type="object" string="Close"
                            class="btn-danger" invisible="state != 'published'"/>
                    <button name="action_draft" type="object" string="Set to Draft"
                            class="btn-secondary" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,published,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_questions" icon="fa-question">
                            <field name="question_count" widget="statinfo"
                                   string="Questions"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_view_attempts" icon="fa-flag-checkered">
                            <field name="attempt_count" widget="statinfo"
                                   string="Attempts"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Reference"/>
                        <h1><field name="name" placeholder="e.g. LMQ/2024/00001"/></h1>
                        <h3><field name="code" placeholder="Optional short code"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="lms_course_id" options="{'no_create': True}"/>
                            <field name="title"/>
                            <field name="quiz_type"/>
                            <field name="show_answers_after"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group>
                            <field name="max_score"/>
                            <field name="weight"/>
                            <field name="total_points"/>
                            <field name="time_limit_minutes"/>
                            <field name="attempts_allowed"/>
                            <field name="shuffle_questions" widget="boolean_toggle"/>
                            <field name="shuffle_options" widget="boolean_toggle"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" nolabel="1"
                                   placeholder="Quiz description and rules shown to students..."/>
                        </page>
                        <page string="Questions" name="questions">
                            <field name="question_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="question_type"/>
                                    <field name="text"/>
                                    <field name="points"/>
                                </list>
                            </field>
                        </page>
                        <page string="Attempts" name="attempts">
                            <field name="attempt_ids">
                                <list>
                                    <field name="student_name"/>
                                    <field name="student_code" optional="hide"/>
                                    <field name="attempt_number"/>
                                    <field name="start_time"/>
                                    <field name="end_time"/>
                                    <field name="score"/>
                                    <field name="percentage"/>
                                    <field name="grade_letter"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============ uni.lms.quiz — Search View ============ -->
    <record id="view_uni_lms_quiz_search" model="ir.ui.view">
        <field name="name">uni.lms.quiz.search</field>
        <field name="model">uni.lms.quiz</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="title"/>
                <field name="lms_course_id"/>
                <filter string="Published" name="filter_published"
                        domain="[('state', '=', 'published')]"/>
                <filter string="Closed" name="filter_closed"
                        domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter string="Practice" name="filter_practice"
                        domain="[('quiz_type', '=', 'practice')]"/>
                <filter string="Graded" name="filter_graded"
                        domain="[('quiz_type', '=', 'graded')]"/>
                <filter string="Survey" name="filter_survey"
                        domain="[('quiz_type', '=', 'survey')]"/>
                <separator/>
                <filter string="Shuffle Questions" name="filter_shuffle_q"
                        domain="[('shuffle_questions', '=', True)]"/>
                <separator/>
                <filter string="Active Only" name="filter_active"
                        domain="[('active', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="LMS Course" name="group_course"
                            context="{'group_by': 'lms_course_id'}"/>
                    <filter string="Quiz Type" name="group_type"
                            context="{'group_by': 'quiz_type'}"/>
                    <filter string="Show Answers" name="group_show_answers"
                            context="{'group_by': 'show_answers_after'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============ uni.lms.quiz — Action ============ -->
    <record id="action_uni_lms_quiz" model="ir.actions.act_window">
        <field name="name">LMS Quizzes</field>
        <field name="res_model">uni.lms.quiz</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_lms_quiz_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new quiz
            </p>
            <p>
                Quizzes are graded or practice assessments built from a
                question bank. Configure time limits, attempt limits,
                question/option shuffling, and answer visibility.
            </p>
        </field>
    </record>

    <!-- ============ uni.lms.quiz.question — List View ============ -->
    <record id="view_uni_lms_quiz_question_list" model="ir.ui.view">
        <field name="name">uni.lms.quiz.question.list</field>
        <field name="model">uni.lms.quiz.question</field>
        <field name="arch" type="xml">
            <list string="Quiz Questions">
                <field name="sequence" widget="handle"/>
                <field name="quiz_id"/>
                <field name="question_type"/>
                <field name="text"/>
                <field name="points"/>
                <field name="attachment" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============ uni.lms.quiz.question — Form View ============ -->
    <record id="view_uni_lms_quiz_question_form" model="ir.ui.view">
        <field name="name">uni.lms.quiz.question.form</field>
        <field name="model">uni.lms.quiz.question</field>
        <field name="arch" type="xml">
            <form string="Quiz Question">
                <sheet>
                    <group>
                        <group>
                            <field name="quiz_id" options="{'no_create': True}"/>
                            <field name="question_type"/>
                            <field name="sequence"/>
                            <field name="points"/>
                        </group>
                        <group>
                            <field name="attachment" filename="correct_answer"/>
                        </group>
                    </group>
                    <group>
                        <field name="text" nolabel="1"
                               placeholder="Enter the question text..."/>
                    </group>
                    <notebook>
                        <page string="Options / Correct Answer" name="options">
                            <group>
                                <field name="options_data"
                                       invisible="question_type not in ('multiple_choice', 'true_false', 'matching')"
                                       placeholder='JSON list, e.g. [{"key":"A","text":"First option","correct":true}, ...]'/>
                                <field name="correct_answer"
                                       invisible="question_type not in ('short_answer', 'fill_blank', 'essay')"
                                       placeholder="Correct answer text"/>
                            </group>
                        </page>
                        <page string="Explanation" name="explanation">
                            <field name="explanation" nolabel="1"
                                   placeholder="Explanation shown after grading..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============ uni.lms.quiz.question — Search View ============ -->
    <record id="view_uni_lms_quiz_question_search" model="ir.ui.view">
        <field name="name">uni.lms.quiz.question.search</field>
        <field name="model">uni.lms.quiz.question</field>
        <field name="arch" type="xml">
            <search>
                <field name="quiz_id"/>
                <field name="text"/>
                <group expand="0" string="Group By">
                    <filter string="Quiz" name="group_quiz"
                            context="{'group_by': 'quiz_id'}"/>
                    <filter string="Question Type" name="group_type"
                            context="{'group_by': 'question_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============ uni.lms.quiz.question — Action ============ -->
    <record id="action_uni_lms_quiz_question" model="ir.actions.act_window">
        <field name="name">Quiz Questions</field>
        <field name="res_model">uni.lms.quiz.question</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_lms_quiz_question_search"/>
    </record>

    <!-- ============ uni.lms.quiz.attempt — List View ============ -->
    <record id="view_uni_lms_quiz_attempt_list" model="ir.ui.view">
        <field name="name">uni.lms.quiz.attempt.list</field>
        <field name="model">uni.lms.quiz.attempt</field>
        <field name="arch" type="xml">
            <list string="Quiz Attempts"
                  decoration-success="state=='graded'"
                  decoration-info="state=='in_progress'"
                  decoration-warning="state=='submitted'"
                  decoration-muted="state=='abandoned'">
                <field name="quiz_id"/>
                <field name="student_name"/>
                <field name="student_code" optional="hide"/>
                <field name="attempt_number"/>
                <field name="start_time"/>
                <field name="end_time" optional="show"/>
                <field name="score"/>
                <field name="max_score" optional="hide"/>
                <field name="percentage"/>
                <field name="grade_letter"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- ============ uni.lms.quiz.attempt — Form View ============ -->
    <record id="view_uni_lms_quiz_attempt_form" model="ir.ui.view">
        <field name="name">uni.lms.quiz.attempt.form</field>
        <field name="model">uni.lms.quiz.attempt</field>
        <field name="arch" type="xml">
            <form string="Quiz Attempt">
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_grade" type="object" string="Grade"
                            class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_abandon" type="object" string="Abandon"
                            class="btn-danger" invisible="state not in ('in_progress', 'submitted')"/>
                    <button name="action_resume" type="object" string="Resume"
                            class="btn-secondary" invisible="state != 'abandoned'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="in_progress,submitted,graded,abandoned"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="quiz_id" options="{'no_create': True}"/>
                            <field name="student_name" placeholder="e.g. John Doe"/>
                            <field name="student_code" placeholder="e.g. ST-2024-001"/>
                            <field name="attempt_number"/>
                            <field name="start_time"/>
                            <field name="end_time"/>
                        </group>
                        <group>
                            <field name="score"/>
                            <field name="max_score"/>
                            <field name="percentage"/>
                            <field name="grade_letter" placeholder="e.g. A, B+, C"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Answers (JSON)" name="answers">
                            <field name="answers_data" nolabel="1"
                                   placeholder='{"question_id": "answer_value", ...}'/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============ uni.lms.quiz.attempt — Search View ============ -->
    <record id="view_uni_lms_quiz_attempt_search" model="ir.ui.view">
        <field name="name">uni.lms.quiz.attempt.search</field>
        <field name="model">uni.lms.quiz.attempt</field>
        <field name="arch" type="xml">
            <search>
                <field name="quiz_id"/>
                <field name="student_name"/>
                <field name="student_code"/>
                <filter string="In Progress" name="filter_in_progress"
                        domain="[('state', '=', 'in_progress')]"/>
                <filter string="Submitted" name="filter_submitted"
                        domain="[('state', '=', 'submitted')]"/>
                <filter string="Graded" name="filter_graded"
                        domain="[('state', '=', 'graded')]"/>
                <filter string="Abandoned" name="filter_abandoned"
                        domain="[('state', '=', 'abandoned')]"/>
                <group expand="0" string="Group By">
                    <filter string="Quiz" name="group_quiz"
                            context="{'group_by': 'quiz_id'}"/>
                    <filter string="Student Name" name="group_student"
                            context="{'group_by': 'student_name'}"/>
                    <filter string="Grade" name="group_grade"
                            context="{'group_by': 'grade_letter'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============ uni.lms.quiz.attempt — Action ============ -->
    <record id="action_uni_lms_quiz_attempt" model="ir.actions.act_window">
        <field name="name">Quiz Attempts</field>
        <field name="res_model">uni.lms.quiz.attempt</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_lms_quiz_attempt_search"/>
    </record>
</odoo>
