<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        Default time slots for Saturday → Wednesday work week (5 days).
        Each day gets the same 9-slot layout:
            P1 08:00-09:00
            P2 09:00-10:00
            P3 10:00-11:00
            BRK1 11:00-11:15 (Break)
            P4 11:15-12:15
            P5 12:15-13:15
            LUNCH 13:15-14:00 (Lunch break)
            P6 14:00-15:00
            P7 15:00-16:00
        Start times are stored as Float (float_time): 08:00 → 8.0, 11:15 → 11.25, ...
    -->

    <!-- ============== SATURDAY ============== -->
    <record id="slot_sat_p1" model="uni.timetable.slot">
        <field name="name">Period 1</field>
        <field name="code">SAT-P1</field>
        <field name="sequence">10</field>
        <field name="day_of_week">saturday</field>
        <field name="start_time">8.0</field>
