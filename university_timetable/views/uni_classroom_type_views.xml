<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- uni.classroom.type — List View                               -->
    <!-- ============================================================ -->
    <record id="view_uni_classroom_type_list" model="ir.ui.view">
        <field name="name">uni.classroom.type.list</field>
        <field name="model">uni.classroom.type</field>
        <field name="arch" type="xml">
            <list string="Classroom Types">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="capacity"/>
                <field name="has_projector" widget="boolean_toggle"/>
                <field name="has_computer" widget="boolean_toggle"/>
                <field name="has_ac" widget="boolean_toggle"/>
                <field name="has_whiteboard" widget="boolean_toggle"/>
                <field name="has_sound_system" widget="boolean_toggle"/>
                <field name="classroom_count"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.classroom.type — Form View                               -->
    <!-- ============================================================ -->
    <record id="view_uni_classroom_type_form" model="ir.ui.view">
        <field name="name">uni.classroom.type.form</field>
        <field name="model">uni.classroom.type</field>
        <field name="arch" type="xml">
            <form string="Classroom Type">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_classrooms" type="object"
                                class="oe_stat_button" icon="fa-building-o">
                            <field name="classroom_count" widget="statinfo"
                                   string="Classrooms"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Classroom Type"/>
                        <h1><field name="name" placeholder="e.g. Lecture Hall, Lab, Seminar Room"/></h1>
                        <h3><field name="code" placeholder="e.g. LEC, LAB, SEM"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="capacity"/>
                        </group>
                        <group>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Default Facilities">
                        <group>
                            <field name="has_projector"/>
                            <field name="has_computer"/>
                            <field name="has_ac"/>
                        </group>
                        <group>
                            <field name="has_whiteboard"/>
                            <field name="has_sound_system"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.classroom.type — Search View                             -->
    <!-- ============================================================ -->
    <record id="view_uni_classroom_type_search" model="ir.ui.view">
        <field name="name">uni.classroom.type.search</field>
        <field name="model">uni.classroom.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <separator/>
                <filter string="Has Projector" name="filter_projector"
                        domain="[('has_projector', '=', True)]"/>
                <filter string="Has Computer" name="filter_computer"
                        domain="[('has_computer', '=', True)]"/>
                <filter string="Has AC" name="filter_ac"
                        domain="[('has_ac', '=', True)]"/>
                <filter string="Has Whiteboard" name="filter_whiteboard"
                        domain="[('has_whiteboard', '=', True)]"/>
                <filter string="Has Sound System" name="filter_sound"
                        domain="[('has_sound_system', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Has Projector" name="group_projector"
                            context="{'group_by': 'has_projector'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.classroom.type — Action                                  -->
    <!-- ============================================================ -->
    <record id="action_uni_classroom_type" model="ir.actions.act_window">
        <field name="name">Classroom Types</field>
        <field name="res_model">uni.classroom.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_classroom_type_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new classroom type
            </p>
            <p>Classroom types describe categories of rooms (lecture hall,
               lab, seminar...) with their default capacity and facilities.</p>
        </field>
    </record>
</odoo>
