<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- uni.timetable.slot — List View                               -->
    <!-- ============================================================ -->
    <record id="view_uni_timetable_slot_list" model="ir.ui.view">
        <field name="name">uni.timetable.slot.list</field>
        <field name="model">uni.timetable.slot</field>
        <field name="arch" type="xml">
            <list string="Time Slots"
                  decoration-muted="break_slot == True"
                  decoration-info="break_slot == False">
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="day_of_week"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="duration" widget="float_time"/>
                <field name="break_slot" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.timetable.slot — Form View                               -->
    <!-- ============================================================ -->
    <record id="view_uni_timetable_slot_form" model="ir.ui.view">
        <field name="name">uni.timetable.slot.form</field>
        <field name="model">uni.timetable.slot</field>
        <field name="arch" type="xml">
            <form string="Time Slot">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Time Slot"/>
                        <h1><field name="name" placeholder="e.g. Period 1, Lunch Break"/></h1>
                        <h3><field name="code" placeholder="e.g. MON-P1"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="sequence"/>
                            <field name="day_of_week"/>
                            <field name="break_slot"/>
                        </group>
                        <group>
                            <field name="start_time" widget="float_time"/>
                            <field name="end_time" widget="float_time"/>
                            <field name="duration" widget="float_time" readonly="1"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.timetable.slot — Search View                             -->
    <!-- ============================================================ -->
    <record id="view_uni_timetable_slot_search" model="ir.ui.view">
        <field name="name">uni.timetable.slot.search</field>
        <field name="model">uni.timetable.slot</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <separator/>
                <filter string="Break Slots" name="filter_breaks"
                        domain="[('break_slot', '=', True)]"/>
                <filter string="Teaching Slots" name="filter_teaching"
                        domain="[('break_slot', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Day" name="group_day"
                            context="{'group_by': 'day_of_week'}"/>
                    <filter string="Break" name="group_break"
                            context="{'group_by': 'break_slot'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.timetable.slot — Action                                  -->
    <!-- ============================================================ -->
    <record id="action_uni_timetable_slot" model="ir.actions.act_window">
        <field name="name">Time Slots</field>
        <field name="res_model">uni.timetable.slot</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_timetable_slot_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new time slot
            </p>
            <p>Time slots define periods (e.g. Period 1 from 08:00 to 09:00)
               or breaks (e.g. lunch) for each day of the week.</p>
        </field>
    </record>
</odoo>
