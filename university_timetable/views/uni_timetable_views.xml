<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- uni.timetable — List View                                    -->
    <!-- ============================================================ -->
    <record id="view_uni_timetable_list" model="ir.ui.view">
        <field name="name">uni.timetable.list</field>
        <field name="model">uni.timetable</field>
        <field name="arch" type="xml">
            <list string="Timetables"
                  decoration-info="state == 'draft'"
                  decoration-success="state == 'active'"
                  decoration-muted="state == 'closed'">
                <field name="code"/>
                <field name="name"/>
                <field name="academic_year_id"/>
                <field name="academic_term_id"/>
                <field name="university_id" optional="hide"/>
                <field name="college_id" optional="show"/>
                <field name="department_id" optional="hide"/>
                <field name="program_id" optional="hide"/>
                <field name="line_count"/>
                <field name="publish_date" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'active'"
                       decoration-muted="state == 'closed'"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.timetable — Form View                                    -->
    <!-- ============================================================ -->
    <record id="view_uni_timetable_form" model="ir.ui.view">
        <field name="name">uni.timetable.form</field>
        <field name="model">uni.timetable</field>
        <field name="arch" type="xml">
            <form string="Timetable">
                <header>
                    <button name="action_activate" string="Activate / Publish"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_close" string="Close"
                            type="object"
                            invisible="state != 'active'"/>
                    <button name="action_draft" string="Set to Draft"
                            type="object"
                            invisible="state != 'closed'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_lines" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="line_count" widget="statinfo"
                                   string="Lines"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Timetable"/>
                        <h1><field name="name" placeholder="e.g. Fall 2025 — CS Timetable"/></h1>
                        <h3><field name="code" placeholder="e.g. TT-CS-FALL-2025"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="academic_term_id"/>
                            <field name="academic_year_id"/>
                            <field name="university_id"/>
                            <field name="branch_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="college_id"/>
                            <field name="department_id"/>
                            <field name="program_id"/>
                            <field name="publish_date" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Timetable Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="course_id"/>
                                    <field name="faculty_id"/>
                                    <field name="classroom_id"/>
                                    <field name="slot_id"/>
                                    <field name="day_of_week"/>
                                    <field name="start_time" widget="float_time"/>
                                    <field name="end_time" widget="float_time"/>
                                    <field name="section"/>
                                    <field name="group"/>
                                    <field name="is_makeup" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" nolabel="1" colspan="2"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.timetable — Search View                                  -->
    <!-- ============================================================ -->
    <record id="view_uni_timetable_search" model="ir.ui.view">
        <field name="name">uni.timetable.search</field>
        <field name="model">uni.timetable</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="academic_term_id"/>
                <field name="academic_year_id"/>
                <field name="university_id"/>
                <field name="college_id"/>
                <field name="department_id"/>
                <field name="program_id"/>
                <separator/>
                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Active" name="filter_active"
                        domain="[('state', '=', 'active')]"/>
                <filter string="Closed" name="filter_closed"
                        domain="[('state', '=', 'closed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Academic Year" name="group_year"
                            context="{'group_by': 'academic_year_id'}"/>
                    <filter string="Term" name="group_term"
                            context="{'group_by': 'academic_term_id'}"/>
                    <filter string="University" name="group_university"
                            context="{'group_by': 'university_id'}"/>
                    <filter string="College" name="group_college"
                            context="{'group_by': 'college_id'}"/>
                    <filter string="Department" name="group_department"
                            context="{'group_by': 'department_id'}"/>
                    <filter string="Program" name="group_program"
                            context="{'group_by': 'program_id'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.timetable — Action                                       -->
    <!-- ============================================================ -->
    <record id="action_uni_timetable" model="ir.actions.act_window">
        <field name="name">Timetables</field>
        <field name="res_model">uni.timetable</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_timetable_search"/>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new timetable
            </p>
            <p>Each timetable groups the weekly schedule for a term and
               a college / department / program. Add timetable lines to
               define course, faculty, classroom and time slot.</p>
        </field>
    </record>
</odoo>
