<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Alumni member sequence -->
    <record id="seq_uni_alumni_member" model="ir.sequence">
        <field name="name">Alumni Member Sequence</field>
        <field name="code">uni.alumni.member</field>
        <field name="prefix">ALM/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Alumni event sequence -->
    <record id="seq_uni_alumni_event" model="ir.sequence">
        <field name="name">Alumni Event Sequence</field>
        <field name="code">uni.alumni.event</field>
        <field name="prefix">AEV/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Alumni donation sequence -->
    <record id="seq_uni_alumni_donation" model="ir.sequence">
        <field name="name">Alumni Donation Sequence</field>
        <field name="code">uni.alumni.donation</field>
        <field name="prefix">ADN/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Alumni career sequence -->
    <record id="seq_uni_alumni_career" model="ir.sequence">
        <field name="name">Alumni Career Sequence</field>
        <field name="code">uni.alumni.career</field>
        <field name="prefix">ACR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
