<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- ============================================================ -->
    <!-- Default library categories                                     -->
    <!-- ============================================================ -->

    <!-- Computer Science -->
    <record id="library_category_computer_science" model="uni.library.category">
        <field name="name">Computer Science</field>
        <field name="code">CS</field>
        <field name="classification_system">dewey_decimal</field>
        <field name="classification_code">004</field>
        <field name="sequence">10</field>
        <field name="description">Books on computer science, programming, software engineering, and IT.</field>
    </record>

    <!-- Mathematics -->
    <record id="library_category_mathematics" model="uni.library.category">
        <field name="name">Mathematics</field>
        <field name="code">MATH</field>
        <field name="classification_system">dewey_decimal</field>
        <field name="classification_code">510</field>
        <field name="sequence">20</field>
        <field name="description">Books on pure and applied mathematics, statistics, and probability.</field>
    </record>

