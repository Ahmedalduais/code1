<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- ============================================================ -->
    <!-- Library sequences                                              -->
    <!-- ============================================================ -->

    <!-- Borrow records -->
    <record id="seq_uni_library_borrow" model="ir.sequence">
        <field name="name">Library Borrow Sequence</field>
        <field name="code">uni.library.borrow</field>
        <field name="prefix">LBR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Fine records -->
    <record id="seq_uni_library_fine" model="ir.sequence">
        <field name="name">Library Fine Sequence</field>
        <field name="code">uni.library.fine</field>
        <field name="prefix">LFN/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Digital repository records -->
    <record id="seq_uni_library_digital" model="ir.sequence">
        <field name="name">Library Digital Repository Sequence</field>
        <field name="code">uni.library.digital</field>
        <field name="prefix">DIG/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
