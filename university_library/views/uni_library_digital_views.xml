<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- uni.library.digital — List View                               -->
    <!-- ============================================================ -->
    <record id="view_uni_library_digital_list" model="ir.ui.view">
        <field name="name">uni.library.digital.list</field>
        <field name="model">uni.library.digital</field>
        <field name="arch" type="xml">
            <list string="Digital Repository"
                  decoration-success="state == 'published'"
                  decoration-muted="state == 'archived'">
                <field name="name"/>
                <field name="title"/>
                <field name="document_type"/>
                <field name="author_ids" widget="many2many_tags"/>
                <field name="department_id" optional="hide"/>
                <field name="publication_date"/>
                <field name="access_level"/>
                <field name="download_count"/>
                <field name="view_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'published'"
                       decoration-muted="state == 'archived'"
                       decoration-danger="state == 'draft'"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.library.digital — Form View                               -->
    <!-- ============================================================ -->
    <record id="view_uni_library_digital_form" model="ir.ui.view">
        <field name="name">uni.library.digital.form</field>
        <field name="model">uni.library.digital</field>
        <field name="arch" type="xml">
            <form string="Digital Document">
                <header>
                    <button name="action_publish" type="object"
                            string="Publish" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_archive" type="object"
                            string="Archive"
                            invisible="state == 'archived'"/>
                    <button name="action_draft" type="object"
                            string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,published,archived"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_download" type="object"
                                class="oe_stat_button" icon="fa-download"
                                invisible="not file">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="download_count"/></span>
                                <span class="o_stat_text">Downloads</span>
                            </div>
                        </button>
                        <button name="action_view" type="object"
                                class="oe_stat_button" icon="fa-eye">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="view_count"/></span>
                                <span class="o_stat_text">Views</span>
                            </div>
                        </button>
                        <button name="action_archive" type="object"
                                class="oe_stat_button" icon="fa-archive"
                                invisible="active == False">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Unarchive</span>
                            </div>
                        </button>
                        <button name="action_unarchive" type="object"
                                class="oe_stat_button" icon="fa-archive"
                                invisible="active == True">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Restore</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="title" string="Document Title"/>
                        <h1><field name="title" placeholder="e.g. PhD Thesis — Machine Learning Applications"/></h1>
                        <h3><field name="name" readonly="1"/></h3>
                        <h3><field name="code" placeholder="Optional code"/></h3>
                    </div>
                    <group>
                        <group string="Classification">
                            <field name="document_type"/>
                            <field name="department_id"
                                   options="{'no_create': True}"/>
                            <field name="publication_date"/>
                            <field name="access_level"/>
                        </group>
                        <group string="External Identifiers">
                            <field name="doi"
                                   placeholder="10.xxxx/..."/>
                            <field name="url"
                                   widget="url"
                                   placeholder="https://..."/>
                            <field name="keywords"
                                   placeholder="machine learning, neural networks"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Authors">
                            <field name="author_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                        </group>
                        <group string="Linked Person">
                            <field name="student_name"
                                   placeholder="Student author name (optional)"/>
                            <field name="faculty_name"
                                   placeholder="Faculty author / supervisor name (optional)"/>
                        </group>
                    </group>
                    <group string="File">
                        <field name="file" filename="filename"/>
                        <field name="filename" readonly="1"/>
                        <field name="file_size"/>
                        <field name="file_format" placeholder="PDF"/>
                    </group>
                    <group string="Abstract">
                        <field name="abstract" nolabel="1"
                               placeholder="Abstract of the document..."/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.library.digital — Search View                             -->
    <!-- ============================================================ -->
    <record id="view_uni_library_digital_search" model="ir.ui.view">
        <field name="name">uni.library.digital.search</field>
        <field name="model">uni.library.digital</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="title"/>
                <field name="code"/>
                <field name="doi"/>
                <field name="keywords"/>
                <field name="author_ids"/>
                <field name="department_id"/>
                <field name="student_name"/>
                <field name="faculty_name"/>
                <filter string="Published" name="filter_published"
                        domain="[('state', '=', 'published')]"/>
                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Archived" name="filter_archived"
                        domain="[('state', '=', 'archived')]"/>
                <filter string="Public Access" name="filter_public"
                        domain="[('access_level', '=', 'public')]"/>
                <separator/>
                <filter string="Inactive Records" name="filter_inactive"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Document Type" name="group_document_type"
                            context="{'group_by': 'document_type'}"/>
                    <filter string="State" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Access Level" name="group_access"
                            context="{'group_by': 'access_level'}"/>
                    <filter string="Department" name="group_department"
                            context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.library.digital — Action                                   -->
    <!-- ============================================================ -->
    <record id="action_uni_library_digital" model="ir.actions.act_window">
        <field name="name">Digital Repository</field>
        <field name="res_model">uni.library.digital</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_library_digital_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a digital document
            </p>
            <p>The digital repository stores theses, dissertations,
               journal articles, research papers, conference papers,
               and lecture notes with controlled access levels.</p>
        </field>
    </record>
</odoo>
