<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- uni.library.author — List View                                -->
    <!-- ============================================================ -->
    <record id="view_uni_library_author_list" model="ir.ui.view">
        <field name="name">uni.library.author.list</field>
        <field name="model">uni.library.author</field>
        <field name="arch" type="xml">
            <list string="Authors"
                  decoration-muted="active == False">
                <field name="code"/>
                <field name="name"/>
                <field name="birth_date"/>
                <field name="death_date"/>
                <field name="nationality_id" optional="hide"/>
                <field name="book_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.library.author — Form View                                -->
    <!-- ============================================================ -->
    <record id="view_uni_library_author_form" model="ir.ui.view">
        <field name="name">uni.library.author.form</field>
        <field name="model">uni.library.author</field>
        <field name="arch" type="xml">
            <form string="Author">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_books" type="object"
                                class="oe_stat_button" icon="fa-book">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="book_count"/></span>
                                <span class="o_stat_text">Books</span>
                            </div>
                        </button>
                        <button name="action_archive" type="object"
                                class="oe_stat_button" icon="fa-archive"
                                invisible="active == False">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Unarchive</span>
                            </div>
                        </button>
                        <button name="action_unarchive" type="object"
                                class="oe_stat_button" icon="fa-archive"
                                invisible="active == True">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Restore</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Author"/>
                        <h1><field name="name" placeholder="e.g. Naguib Mahfouz"/></h1>
                        <h3><field name="code" placeholder="e.g. AUTH-001"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="birth_date"/>
                            <field name="death_date"/>
                            <field name="nationality_id"
                                   options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="website"
                                   widget="url"
                                   placeholder="https://example.com"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Biography">
                        <field name="biography" nolabel="1"
                               placeholder="Short biographical note about the author..."/>
                    </group>
                    <notebook>
                        <page string="Books" name="books">
                            <field name="book_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="isbn"/>
                                    <field name="publication_year"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.library.author — Search View                              -->
    <!-- ============================================================ -->
    <record id="view_uni_library_author_search" model="ir.ui.view">
        <field name="name">uni.library.author.search</field>
        <field name="model">uni.library.author</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="nationality_id"/>
                <filter string="Archived" name="filter_archived"
                        domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Nationality" name="group_nationality"
                            context="{'group_by': 'nationality_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.library.author — Action                                    -->
    <!-- ============================================================ -->
    <record id="action_uni_library_author" model="ir.actions.act_window">
        <field name="name">Authors</field>
        <field name="res_model">uni.library.author</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_library_author_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new author
            </p>
            <p>Authors are linked to library books and digital documents.
               You can record biographical details, nationality, and
               website for each author.</p>
        </field>
    </record>
</odoo>
