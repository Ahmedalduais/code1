<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Exam sequence: EXM/%(year)s/0000 -->
        <record id="seq_uni_exam" model="ir.sequence">
            <field name="name">University Exam</field>
            <field name="code">uni.exam</field>
            <field name="prefix">EXM/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Violation sequence: VIO/%(year)s/0000 -->
        <record id="seq_uni_exam_violation" model="ir.sequence">
            <field name="name">University Exam Violation</field>
            <field name="code">uni.exam.violation</field>
            <field name="prefix">VIO/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Accommodation sequence: EAC/%(year)s/00000 -->
        <record id="seq_uni_exam_accommodation" model="ir.sequence">
            <field name="name">Exam Accommodation Sequence</field>
            <field name="code">uni.exam.accommodation</field>
            <field name="prefix">EAC/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
