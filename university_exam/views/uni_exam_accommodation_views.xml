<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- uni.exam.accommodation — List View                            -->
    <!-- ============================================================ -->
    <record id="view_uni_exam_accommodation_list" model="ir.ui.view">
        <field name="name">uni.exam.accommodation.list</field>
        <field name="model">uni.exam.accommodation</field>
        <field name="arch" type="xml">
            <list string="Exam Accommodations"
                  decoration-info="state in ('draft', 'submitted')"
                  decoration-warning="state == 'under_review'"
                  decoration-success="state == 'approved'"
                  decoration-danger="state == 'denied'"
                  decoration-primary="state == 'applied'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="exam_id"/>
                <field name="course_id"/>
                <field name="academic_term_id" optional="hide"/>
                <field name="student_name"/>
                <field name="student_code" optional="hide"/>
                <field name="disability_type" optional="hide"/>
                <field name="accommodation_type"/>
                <field name="extra_time_minutes" optional="hide"/>
                <field name="requires_separate_room" optional="hide"/>
                <field name="requested_date"/>
                <field name="approved_by" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('draft', 'submitted')"
                       decoration-warning="state == 'under_review'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'denied'"
                       decoration-primary="state == 'applied'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.exam.accommodation — Form View                            -->
    <!-- ============================================================ -->
    <record id="view_uni_exam_accommodation_form" model="ir.ui.view">
        <field name="name">uni.exam.accommodation.form</field>
        <field name="model">uni.exam.accommodation</field>
        <field name="arch" type="xml">
            <form string="Exam Accommodation">
                <header>
                    <button name="action_submit" type="object"
                            string="Submit" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_start_review" type="object"
                            string="Start Review" class="oe_highlight"
                            invisible="state != 'submitted'"/>
                    <button name="action_approve" type="object"
                            string="Approve" class="oe_highlight"
                            invisible="state != 'under_review'"/>
                    <button name="action_deny" type="object"
                            string="Deny"
                            invisible="state != 'under_review'"
                            confirm="Are you sure you want to deny this accommodation request?"/>
                    <button name="action_apply" type="object"
                            string="Mark as Applied" class="oe_highlight"
                            invisible="state != 'approved'"/>
                    <button name="action_cancel" type="object"
                            string="Cancel"
                            invisible="state in ('applied', 'cancelled')"
                            confirm="Are you sure you want to cancel this accommodation request?"/>
                    <button name="action_reset_to_draft" type="object"
                            string="Back to Draft"
                            invisible="state not in ('denied', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,under_review,approved,applied"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Accommodation"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Exam Context">
                            <field name="exam_id"
                                   options="{'no_create': True}"/>
                            <field name="course_id" readonly="1"/>
                            <field name="academic_term_id" readonly="1"/>
                            <field name="requested_date"/>
                            <field name="is_recurring"/>
                            <field name="expiry_date"/>
                        </group>
                        <group string="Student">
                            <field name="student_name"/>
                            <field name="student_code"/>
                            <field name="student_email"/>
                        </group>
                    </group>
                    <group>
                        <group string="Disability Info">
                            <field name="disability_type"/>
                            <field name="disability_description"/>
                        </group>
                        <group string="Accommodation">
                            <field name="accommodation_type"/>
                            <field name="accommodation_details"/>
                            <field name="extra_time_minutes"
                                   invisible="accommodation_type != 'extra_time'"/>
                            <field name="extra_time_percentage"
                                   invisible="accommodation_type != 'extra_time'"/>
                            <field name="requires_separate_room"/>
                            <field name="room_requirements"
                                   invisible="not requires_separate_room"/>
                            <field name="equipment_needed"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Medical Certificate">
                            <group>
                                <field name="medical_certificate_filename"
                                       invisible="not medical_certificate"/>
                                <field name="medical_certificate"
                                       filename="medical_certificate_filename"/>
                            </group>
                        </page>
                        <page string="Approval" invisible="state in ('draft', 'submitted')">
                            <group>
                                <group>
                                    <field name="approved_by"/>
                                    <field name="approved_date"/>
                                </group>
                                <group>
                                    <field name="approval_comments"/>
                                    <field name="denial_reason"
                                           invisible="state != 'denied'"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes"
                                   placeholder="Internal notes about this accommodation..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.exam.accommodation — Search View                          -->
    <!-- ============================================================ -->
    <record id="view_uni_exam_accommodation_search" model="ir.ui.view">
        <field name="name">uni.exam.accommodation.search</field>
        <field name="model">uni.exam.accommodation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="exam_id"/>
                <field name="student_name"/>
                <field name="student_code"/>
                <field name="course_id"/>
                <field name="academic_term_id"/>
                <field name="approved_by"/>
                <separator/>
                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="filter_submitted"
                        domain="[('state', '=', 'submitted')]"/>
                <filter string="Under Review" name="filter_under_review"
                        domain="[('state', '=', 'under_review')]"/>
                <filter string="Approved" name="filter_approved"
                        domain="[('state', '=', 'approved')]"/>
                <filter string="Denied" name="filter_denied"
                        domain="[('state', '=', 'denied')]"/>
                <filter string="Applied" name="filter_applied"
                        domain="[('state', '=', 'applied')]"/>
                <filter string="Cancelled" name="filter_cancelled"
                        domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Recurring" name="filter_recurring"
                        domain="[('is_recurring', '=', True)]"/>
                <filter string="Requires Separate Room" name="filter_separate_room"
                        domain="[('requires_separate_room', '=', True)]"/>
                <filter string="Expired" name="filter_expired"
                        domain="[('expiry_date', '!=', False), ('expiry_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Accommodation Type" name="group_accommodation_type"
                            context="{'group_by': 'accommodation_type'}"/>
                    <filter string="Disability Type" name="group_disability_type"
                            context="{'group_by': 'disability_type'}"/>
                    <filter string="Exam" name="group_exam"
                            context="{'group_by': 'exam_id'}"/>
                    <filter string="Course" name="group_course"
                            context="{'group_by': 'course_id'}"/>
                    <filter string="Term" name="group_term"
                            context="{'group_by': 'academic_term_id'}"/>
                    <filter string="Student" name="group_student"
                            context="{'group_by': 'student_name'}"/>
                    <filter string="Approved By" name="group_approved_by"
                            context="{'group_by': 'approved_by'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.exam.accommodation — Action                               -->
    <!-- ============================================================ -->
    <record id="action_uni_exam_accommodation" model="ir.actions.act_window">
        <field name="name">Exam Accommodations</field>
        <field name="res_model">uni.exam.accommodation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_exam_accommodation_search"/>
        <field name="context">{
            'search_default_filter_draft': 1,
            'search_default_filter_submitted': 1,
            'search_default_filter_under_review': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register a new exam accommodation
            </p>
            <p>Manage accommodations for students with special needs:
               extended time, assistive technology, separate testing rooms,
               scribes, readers, etc. Each request moves through the
               workflow: draft → submitted → under review → approved / denied
               → applied to exam.</p>
        </field>
    </record>
</odoo>
