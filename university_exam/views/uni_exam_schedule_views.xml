<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================ -->
    <!-- uni.exam.schedule — List View                                 -->
    <!-- ============================================================ -->
    <record id="view_uni_exam_schedule_list" model="ir.ui.view">
        <field name="name">uni.exam.schedule.list</field>
        <field name="model">uni.exam.schedule</field>
        <field name="arch" type="xml">
            <list string="Exam Schedules"
                  decoration-info="state == 'draft'"
                  decoration-success="state == 'published'"
                  decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="code"/>
                <field name="academic_term_id"/>
                <field name="academic_year_id"/>
                <field name="university_id"/>
                <field name="college_id"/>
                <field name="program_id"/>
                <field name="publish_date"/>
                <field name="exam_count"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'published'"
                       decoration-muted="state == 'closed'"/>
            </list>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.exam.schedule — Form View                                 -->
    <!-- ============================================================ -->
    <record id="view_uni_exam_schedule_form" model="ir.ui.view">
        <field name="name">uni.exam.schedule.form</field>
        <field name="model">uni.exam.schedule</field>
        <field name="arch" type="xml">
            <form string="Exam Schedule">
                <header>
                    <button name="action_publish" type="object"
                            string="Publish" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_close" type="object"
                            string="Close" class="oe_highlight"
                            invisible="state != 'published'"/>
                    <button name="action_draft" type="object"
                            string="Reset to Draft"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,published,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_exams" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="exam_count" widget="statinfo"
                                   string="Exams"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Exam Schedule"/>
                        <h1><field name="name" placeholder="e.g. Fall 2024 Final Exams"/></h1>
                        <h3><field name="code" placeholder="Optional code"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="academic_term_id"
                                   options="{'no_create': True}"/>
                            <field name="academic_year_id" readonly="1"/>
                            <field name="university_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="college_id"
                                   options="{'no_create': True}"/>
                            <field name="program_id"
                                   options="{'no_create': True}"/>
                            <field name="publish_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Exams" name="exams">
                            <field name="exam_ids"
                                   context="{'default_academic_term_id': academic_term_id}">
                                <list>
                                    <field name="name"/>
                                    <field name="course_id"/>
                                    <field name="exam_type_id"/>
                                    <field name="exam_date"/>
                                    <field name="duration" widget="float_time"/>
                                    <field name="total_students"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.exam.schedule — Search View                               -->
    <!-- ============================================================ -->
    <record id="view_uni_exam_schedule_search" model="ir.ui.view">
        <field name="name">uni.exam.schedule.search</field>
        <field name="model">uni.exam.schedule</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="academic_term_id"/>
                <field name="college_id"/>
                <field name="program_id"/>
                <filter string="Draft" name="filter_draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter string="Published" name="filter_published"
                        domain="[('state', '=', 'published')]"/>
                <filter string="Closed" name="filter_closed"
                        domain="[('state', '=', 'closed')]"/>
                <group expand="0" string="Group By">
                    <filter string="State" name="group_state"
                            context="{'group_by': 'state'}"/>
                    <filter string="Academic Term" name="group_term"
                            context="{'group_by': 'academic_term_id'}"/>
                    <filter string="University" name="group_university"
                            context="{'group_by': 'university_id'}"/>
                    <filter string="College" name="group_college"
                            context="{'group_by': 'college_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================ -->
    <!-- uni.exam.schedule — Action                                    -->
    <!-- ============================================================ -->
    <record id="action_uni_exam_schedule" model="ir.actions.act_window">
        <field name="name">Exam Schedules</field>
        <field name="res_model">uni.exam.schedule</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_uni_exam_schedule_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new exam schedule
            </p>
            <p>Exam schedules group exams by academic term and publish them
               to students and faculty. A schedule must contain at least one
               exam before being published.</p>
        </field>
    </record>
</odoo>
